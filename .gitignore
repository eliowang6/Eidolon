# Dependency and Docusaurus build scratch.
node_modules/
.docusaurus/
.cache/
*.tsbuildinfo
__pycache__/
*.pyc

# Generated by `npm run build` in docs/, and by scripts/publish-site.py before
# packaging. Served at /docs/build/ but rebuilt on demand, so it never belongs
# in git.
docs/build/

# Deployment packages produced by scripts/publish-site.py.
dist/

# Incremental search-engine push ledger (URL + page hash + result), written by
# scripts/seo-submit.mjs push. Local machine state, never part of the site.
seo/push-state.json
seo/baidu-push-log.jsonl

# Eidolon Astro build output. The source lives in eidolon-web/ (which carries
# its own .gitignore); the Pages payload is rebuilt by publish-edgeone.py.
eidolon-site/

# EdgeOne Makers project binding (project name + id, no secrets). Keep it
# committed so deploys are reproducible.
# .edgeone/

# Local credentials for the publish scripts (CF_R2_* / EDGEONE_* keys). Never commit.
.env

.DS_Store
Thumbs.db

# Local AI-assistant tooling state (never part of the site source).
.claude/
.workbuddy-ai/
