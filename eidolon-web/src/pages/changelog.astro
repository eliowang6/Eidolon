---
import Base from '../layouts/Base.astro';
import BetaPage from '../components/pages/BetaPage.astro';
import { breadcrumbListSchema } from '../config/schema';
import { t } from '../i18n';

const lang = 'zh' as const;
const copy = t(lang);

const jsonLd = [
  breadcrumbListSchema([
    { name: copy.nav.home, url: '/' },
    { name: copy.nav.changelog, url: '/changelog.html' },
  ]),
];
---

<Base
  lang={lang}
  path="/changelog.html"
  title={copy.meta.changelog.title}
  description={copy.meta.changelog.description}
  keywords={copy.meta.changelog.keywords}
  jsonLd={jsonLd}
>
  <BetaPage lang={lang} />
</Base>
