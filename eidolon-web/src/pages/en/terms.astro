---
import Base from '../../layouts/Base.astro';
import LegalPage from '../../components/pages/LegalPage.astro';
import { t } from '../../i18n';

const lang = 'en' as const;
const copy = t(lang);
---
<Base lang={lang} path="/terms.html" title={copy.meta.terms.title} description={copy.meta.terms.description}>
  <LegalPage lang={lang} page={copy.termsPage} />
</Base>
