---
import Base from '../../layouts/Base.astro';
import FeaturesPage from '../../components/pages/FeaturesPage.astro';
import { t } from '../../i18n';

const lang = 'en' as const;
const copy = t(lang);
---
<Base lang={lang} path="/features.html" title={copy.meta.features.title} description={copy.meta.features.description} keywords={copy.meta.features.keywords}>
  <FeaturesPage lang={lang} />
</Base>
