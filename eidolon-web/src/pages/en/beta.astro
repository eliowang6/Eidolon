---
import Base from '../../layouts/Base.astro';
import BetaPage from '../../components/pages/BetaPage.astro';
import { t } from '../../i18n';

const lang = 'en' as const;
const copy = t(lang);

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: copy.betaPage.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<Base lang={lang} path="/beta.html" title={copy.meta.beta.title} description={copy.meta.beta.description} keywords={copy.meta.beta.keywords} jsonLd={[faq]}>
  <BetaPage lang={lang} />
</Base>
