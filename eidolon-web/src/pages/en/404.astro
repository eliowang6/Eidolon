---
import Base from '../../layouts/Base.astro';
import NotFoundPage from '../../components/pages/NotFoundPage.astro';
import { t } from '../../i18n';

const lang = 'en' as const;
const copy = t(lang);
---
<Base lang={lang} path="/404.html" title={copy.meta.notFound.title} description={copy.meta.notFound.description} keywords={copy.meta.notFound.keywords} noindex>
  <NotFoundPage lang={lang} />
</Base>
