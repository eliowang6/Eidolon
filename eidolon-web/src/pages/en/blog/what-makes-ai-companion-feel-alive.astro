---
import Base from '../../../layouts/Base.astro';
import BlogArticlePage from '../../../components/pages/BlogArticlePage.astro';
import { prPlain, t } from '../../../i18n';
import { ARTICLES_EN } from '../../../config/blog-data';
import { blogArticleSchema, breadcrumbListSchema } from '../../../config/schema';

const copy = t('en');
const article = ARTICLES_EN['what-makes-ai-companion-feel-alive'];
const plainTitle = prPlain(article.title);
const plainDesc = prPlain(article.description);

const schema = [
  blogArticleSchema({
    title: plainTitle,
    description: plainDesc,
    url: 'https://sholarel.instarmony.com/en/blog/what-makes-ai-companion-feel-alive.html',
    datePublished: article.date,
    lang: 'en',
  }),
  breadcrumbListSchema([
    { name: copy.nav.home, url: 'https://sholarel.instarmony.com/en/' },
    { name: copy.nav.blog, url: 'https://sholarel.instarmony.com/en/blog.html' },
    { name: plainTitle, url: 'https://sholarel.instarmony.com/en/blog/what-makes-ai-companion-feel-alive.html' },
  ]),
];
---

<Base
  lang="en"
  path="/blog/what-makes-ai-companion-feel-alive.html"
  title={`${plainTitle} — Sholarel Blog`}
  description={plainDesc}
  keywords="AI companion that feels real, AI chat without roleplay brackets, AI that texts like a real person, online offline mode AI companion, Sholarel, Fea, Ael"
  jsonLd={schema}
>
  <BlogArticlePage lang="en" article={article} />
</Base>
