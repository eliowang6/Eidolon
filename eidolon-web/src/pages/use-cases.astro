---
import Base from '../layouts/Base.astro';
import UseCasesPage from '../components/pages/UseCasesPage.astro';
import { breadcrumbListSchema } from '../config/schema';
import { t } from '../i18n';

const lang = 'zh' as const;
const copy = t(lang);

const jsonLd = [
  breadcrumbListSchema([
    { name: copy.nav.home, url: '/' },
    { name: copy.nav.useCases, url: '/use-cases.html' },
  ]),
];
---

<Base
  lang={lang}
  path="/use-cases.html"
  title={copy.meta.useCases.title}
  description={copy.meta.useCases.description}
  keywords={copy.meta.useCases.keywords}
  jsonLd={jsonLd}
>
  <UseCasesPage lang={lang} />
</Base>
