---
import '../styles/tokens.css';
import '../styles/base.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';
import { localizePath, pr, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  path: string;
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  bodyClass?: string;
  /** What sits under the nav at the top of the page. Every page opens on night unless it says otherwise. */
  navTone?: 'night' | 'pearl';
}
const {
  lang,
  path,
  title,
  description,
  keywords = '',
  ogImage,
  noindex = false,
  jsonLd = [],
  bodyClass = '',
  navTone = 'night',
} = Astro.props;

const copy = t(lang);
const zhPath = path;
const enPath = localizePath('en', zhPath);
const zhUrl = SITE.url + (zhPath === '/' ? '/' : zhPath);
const enUrl = SITE.url + enPath;
const canonical = lang === 'zh' ? zhUrl : enUrl;
const og = SITE.url + (ogImage ?? (lang === 'zh' ? '/assets/og-zh.png' : '/assets/og-en.png'));

// `sameAs` is what lets search engines and LLM answer engines decide that the
// GitHub repo, the X account and the Bilibili channel are the *same* entity as
// this site. Without it every profile is a separate, low-confidence mention.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://instarmony.com/#organization',
  name: 'Instarmony',
  url: 'https://instarmony.com/',
  logo: `${SITE.url}/assets/logo-icon.jpg`,
  sameAs: [
    'https://github.com/eliowang6/Eidolon',
    'https://x.com/eli0wang6',
    'https://space.bilibili.com/520926548',
    'https://www.zhihu.com/people/pevernow-89',
    'https://www.xiaohongshu.com/user/profile/62bb8465000000001b0268ac',
  ],
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: 'Sholarel',
  alternateName: ['Eidolon'],
  url: SITE.url,
  inLanguage: ['zh-Hans', 'en'],
  publisher: { '@id': 'https://instarmony.com/#organization' },
};
const structured = [organization, website, ...jsonLd];

// Whispers are short notes in the companion's own handwriting. Both voices are
// rendered; CSS shows whichever companion the visitor walks with.
const whispers = Object.fromEntries(Object.entries(copy.whisper.lines).map(([key, text]) => [key, pr(text)]));
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-Hans' : 'en'} data-companion="fea">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var c = null;
        try { c = new URLSearchParams(location.search).get('c'); } catch (e) {}
        if (c !== 'fea' && c !== 'ael') {
          try { c = localStorage.getItem('sholarel_companion'); } catch (e) {}
        }
        d.dataset.companion = c === 'ael' ? 'ael' : 'fea';
        // If the page script is slow or blocked, never leave content invisible.
        setTimeout(function () {
          if (!d.classList.contains('reveal-ready')) d.classList.add('reveal-all');
        }, 2500);
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="waffo-verify" content="ac0a33903ae6481423d0aed79e1e6e00" />
    <meta name="waffo-verification" content="ac0a33903ae6481423d0aed79e1e6e00" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-Hans" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={zhUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sholarel" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="theme-color" content="#0e1131" />

    <link rel="icon" type="image/jpeg" href="/assets/logo-icon.jpg" />
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

    <link rel="preload" as="font" type="font/woff2" href="/fonts/bodoni-moda-opsz.woff2" crossorigin />
    {lang === 'zh' && <link rel="preload" as="font" type="font/woff2" href="/fonts/noto-serif-sc-700.woff2" crossorigin />}

    {structured.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{copy.nav.skip}</a>
    <Nav lang={lang} path={path} tone={navTone} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} path={path} />

    <aside class="whisper" id="whisper" hidden aria-live="polite">
      <span class="whisper-face" aria-hidden="true">
        <img class="cf" src="/assets/art/fea-avatar.webp" alt="" width="44" height="44" />
        <img class="ca" src="/assets/art/ael-avatar.webp" alt="" width="44" height="44" />
      </span>
      <div class="whisper-body">
        <span class="whisper-who"><span class="cf">Fea</span><span class="ca">Ael</span></span>
        <p class="whisper-text" data-whisper-text></p>
        <button type="button" class="whisper-quiet" data-whisper-quiet>{copy.whisper.quiet}</button>
      </div>
      <button type="button" class="whisper-close" data-whisper-close aria-label={copy.whisper.close}>×</button>
    </aside>
    <script type="application/json" id="whisper-lines" set:html={JSON.stringify(whispers)} />

    {lang === 'zh' && (
      <aside class="lang-hint" id="lang-hint" hidden>
        <a href={localizePath('en', path)} data-lang-switch="en">{copy.footer.langHint}</a>
        <button type="button" aria-label={copy.footer.langHintClose} data-lang-hint-close>×</button>
      </aside>
    )}

    <script>
      import '../scripts/site';
    </script>

    <style>
      main {
        position: relative;
      }
      .whisper {
        position: fixed;
        right: clamp(14px, 3vw, 30px);
        bottom: clamp(14px, 3vw, 30px);
        z-index: 80;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        max-width: min(360px, calc(100vw - 28px));
        padding: 14px 48px 14px 14px;
        border-radius: 22px 22px 6px 22px;
        background: color-mix(in srgb, #ffffff 92%, transparent);
        border: 1px solid var(--line);
        box-shadow: 0 30px 60px -30px rgba(14, 17, 49, 0.55), 0 8px 18px -12px rgba(14, 17, 49, 0.3);
        backdrop-filter: blur(14px);
        opacity: 0;
        translate: 0 14px;
        transition: opacity var(--t-mid) var(--ease), translate var(--t-mid) var(--ease);
      }
      .whisper.show {
        opacity: 1;
        translate: 0 0;
      }
      .whisper-face {
        flex: none;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        overflow: hidden;
        box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--accent);
      }
      .whisper-face img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .whisper-body {
        min-width: 0;
      }
      .whisper-who {
        display: block;
        font-family: var(--f-latin-display);
        font-style: italic;
        font-size: 14px;
        color: var(--accent-ink);
        line-height: 1.2;
      }
      .whisper-text {
        margin-top: 4px;
        font-family: var(--f-hand);
        font-size: 17px;
        line-height: 1.55;
        color: var(--ink);
        text-wrap: pretty;
      }
      html[lang='en'] .whisper-text {
        font-family: var(--f-latin-display);
        font-style: italic;
        font-size: 17px;
        line-height: 1.45;
      }
      .whisper-quiet {
        margin-top: 8px;
        font-size: 12px;
        color: var(--ink-3);
        border-bottom: 1px dashed var(--line-2);
      }
      .whisper-quiet:hover {
        color: var(--ink);
      }
      .whisper-close {
        position: absolute;
        top: 2px;
        right: 2px;
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        font-size: 18px;
        line-height: 1;
        color: var(--ink-3);
      }
      .whisper-close:hover {
        background: var(--pearl-2);
        color: var(--ink);
      }
      @media (max-width: 640px) {
        .whisper {
          left: 14px;
          right: 14px;
          max-width: none;
          bottom: calc(14px + env(safe-area-inset-bottom));
        }
      }
      .lang-hint {
        position: fixed;
        left: clamp(14px, 3vw, 30px);
        bottom: clamp(14px, 3vw, 30px);
        z-index: 75;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 9px 9px 9px 16px;
        border-radius: var(--r-full);
        background: var(--card);
        border: 1px solid var(--line-2);
        box-shadow: var(--sh-1);
        font-size: 13px;
      }
      .lang-hint a {
        color: var(--ink-2);
      }
      .lang-hint button {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        color: var(--ink-3);
        line-height: 1;
      }
      .lang-hint button:hover {
        background: var(--pearl-2);
        color: var(--ink);
      }
    </style>
  </body>
</html>
