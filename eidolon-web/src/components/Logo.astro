---
interface Props {
  size?: number;
  stroke?: number;
  class?: string;
}
const { size = 30, stroke = 1.8, class: className = '' } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size * 0.8}
  viewBox="2 4 20 16"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4Z"
    stroke="currentColor"
    stroke-width={stroke}
    stroke-linecap="round"
    stroke-linejoin="round"
    vector-effect="non-scaling-stroke"
  />
</svg>
