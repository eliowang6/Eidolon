---
import LoopPanel from './LoopPanel.astro';
import { t, type Lang } from '../i18n';

interface Props {
  steps: any[];
  lang: Lang;
  active?: number;
  single?: boolean;
  compact?: boolean;
  anchor?: string;
}
const { steps, lang, active = 0, single = false, compact = false, anchor } = Astro.props;
const copy = t(lang);
const panels = single ? [steps[active]] : steps;
---
<div class={`stage ${compact ? 'stage--compact' : ''}`} data-loop-stage data-thread-anchor={anchor}>
  <div class="stage-bar">
    <div class="bar" aria-hidden="true">
      {steps.map((_, i) => <i class={i <= active ? 'on' : ''} data-loop-bar></i>)}
    </div>
    <span class="stage-tag mono">{copy.common.illustrative}</span>
  </div>

  <div class="panels">
    {panels.map((step, i) => {
      const realIndex = single ? active : i;
      return (
        <div
          class={`panel ${realIndex === active ? 'is-active' : ''}`}
          data-loop-panel
          data-index={realIndex}
        >
          <div class="panel-head">
            <span class="step-no mono">{step.time} · {step.name}</span>
            <p class="stage-title latin">{step.stageTitle}</p>
          </div>
          <LoopPanel step={step} index={realIndex} lang={lang} />
        </div>
      );
    })}
  </div>
</div>

<style>
  .stage {
    position: relative;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    padding: 24px 28px 26px;
    box-shadow: var(--sh-paper);
    min-height: 440px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .stage-bar {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 18px;
  }
  .bar {
    display: flex;
    gap: 6px;
    flex: 1;
  }
  .bar i {
    flex: 1;
    height: 3px;
    border-radius: 3px;
    background: var(--line);
    transition: background var(--t-mid) var(--ease);
  }
  .bar i.on {
    background: var(--ink);
  }
  .stage-tag {
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .panels {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .panel {
    display: none;
    flex-direction: column;
    flex: 1;
  }
  .panel.is-active {
    display: flex;
    animation: panelIn 320ms var(--ease);
  }
  @keyframes panelIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }
  .step-no {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    text-transform: uppercase;
  }
  .stage-title {
    font-family: var(--f-latin-display);
    font-size: 30px;
    line-height: 1.1;
    color: var(--ink);
    text-align: right;
  }
  .stage--compact {
    min-height: 0;
    padding: 20px 20px 22px;
  }
  .stage--compact .stage-title {
    font-size: 24px;
  }
  .stage--compact :global(.panel-inner) {
    min-height: 0;
  }
  @media (max-width: 1023px) {
    .stage {
      min-height: 0;
    }
  }
  @media (max-width: 480px) {
    .stage-title {
      font-size: 22px;
    }
    .panel-head {
      flex-direction: column;
      gap: 4px;
    }
    .stage-title {
      text-align: left;
    }
  }
</style>
