---
import Icon from './Icon.astro';
import { SITE } from '../config/site';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  id?: string;
  compact?: boolean;
  anchor?: string;
}
const { lang, id, compact = false, anchor } = Astro.props;
const copy = t(lang);
const inputId = `${id ?? 'waitlist'}-email`;
const socialLink = (href: string, label: string): { label: string; href: string } | null =>
  href ? { label, href } : null;
const alts = [
  socialLink(SITE.social.qqGroup, copy.footer.qq),
  socialLink(SITE.social.xiaohongshu, copy.footer.xiaohongshu),
  socialLink(SITE.social.bilibili, copy.footer.bilibili),
].filter((item): item is { label: string; href: string } => item !== null);
---
<div class="letter-wrap" id={id}>
  <form
    class="letter"
    data-waitlist
    data-endpoint={SITE.waitlistEndpoint}
    data-lang={lang}
    data-success={copy.waitlist.success}
    data-error={copy.waitlist.error}
    data-invalid={copy.waitlist.invalid}
    data-sending={copy.waitlist.sending}
    data-label={copy.waitlist.button}
    novalidate
  >
    <img class="stamp" src="/assets/stickers/envelope_with_heart.png" alt="" width="88" height="88" aria-hidden="true" data-thread-anchor={anchor} />
    {!compact && (
      <>
        <span class="label">{copy.waitlist.label}</span>
        <h2>{copy.waitlist.h2}</h2>
      </>
    )}
    <p class="hand">{copy.waitlist.hand}</p>

    <div class="wl-fields">
      <label class="sr-only" for={inputId}>Email</label>
      <div class="field">
        <input
          id={inputId}
          type="email"
          name="email"
          inputmode="email"
          autocomplete="email"
          placeholder={copy.waitlist.placeholder}
          required
        />
        <button class="btn btn-ink btn-sm" type="submit">
          <span class="dot" aria-hidden="true"></span>
          <span data-wl-label>{copy.waitlist.button}</span>
        </button>
      </div>
      <p class="wl-msg" role="alert" aria-live="polite" data-wl-msg hidden></p>
      <div class="honeypot" aria-hidden="true">
        <label>{copy.waitlist.honeypot}<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
      </div>
    </div>

    <div class="wl-success" data-wl-success hidden>
      <Icon name="check" size={20} stroke={2} />
      <span>{copy.waitlist.success}</span>
    </div>

    {alts.length > 0 && (
      <p class="alts">
        {copy.waitlist.alts}
        {alts.map((item, i) => (
          <a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}{i < alts.length - 1 ? ' · ' : ''}</a>
        ))}
      </p>
    )}
    <p class="privacy">{copy.waitlist.privacy}</p>
  </form>
</div>

<style>
  .letter-wrap {
    max-width: 760px;
    margin-inline: auto;
  }
  .letter {
    position: relative;
    background: var(--card);
    border-radius: 6px;
    padding: 52px 56px 40px;
    box-shadow: var(--sh-paper);
    background-image: repeating-linear-gradient(transparent 0 35px, rgba(79, 127, 116, 0.13) 35px 36px);
    transform: rotate(-0.6deg);
    transition: transform var(--t-mid) var(--ease);
  }
  html[data-daypart="night"] .letter {
    background-image: repeating-linear-gradient(transparent 0 35px, rgba(169, 211, 200, 0.1) 35px 36px);
  }
  .letter.done {
    transform: rotate(0.4deg) scale(0.995);
  }
  .stamp {
    position: absolute;
    top: -26px;
    right: 40px;
    width: 88px;
    height: auto;
    transform: rotate(8deg);
    filter: drop-shadow(0 8px 14px rgba(18, 36, 29, 0.18));
    transition: transform var(--t-mid) var(--ease);
  }
  .letter.done .stamp {
    transform: rotate(-2deg) scale(1.05);
  }
  .letter h2 {
    margin: 12px 0 0;
  }
  .hand {
    font-size: 20px;
    line-height: 1.6;
    margin: 12px 0 30px;
  }
  .field {
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1.5px solid var(--ink);
    padding-bottom: 8px;
  }
  .field input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    font-size: 18px;
    font-weight: 500;
    color: var(--ink);
    outline: none;
    padding: 6px 0;
  }
  .field input::placeholder {
    color: var(--ink-3);
    font-weight: 400;
  }
  .field input[aria-invalid="true"] {
    color: var(--annot);
  }
  .wl-msg {
    margin-top: 10px;
    font-size: 13.5px;
    color: var(--annot);
  }
  .wl-success {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 6px;
    padding: 14px 16px;
    border: 1px dashed var(--sage-deep);
    border-radius: var(--r-md);
    background: var(--sage-wash);
    color: var(--sage-deep);
    font-family: var(--f-hand);
    font-size: 19px;
  }
  .alts {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin-top: 24px;
    font-size: 13.5px;
    color: var(--ink-3);
  }
  .alts a {
    color: var(--sage-deep);
    border-bottom: 1px solid transparent;
  }
  .alts a:hover {
    border-color: currentColor;
  }
  .privacy {
    margin-top: 16px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--ink-3);
  }
  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 767px) {
    .letter {
      padding: 42px 24px 32px;
      transform: none;
    }
    .stamp {
      right: 18px;
      width: 72px;
      top: -22px;
    }
    .field {
      flex-wrap: wrap;
    }
    .field input {
      width: 100%;
      flex-basis: 100%;
    }
    .field .btn {
      width: 100%;
    }
  }
</style>

<script>
  import '../scripts/waitlist';
</script>
