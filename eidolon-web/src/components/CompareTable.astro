---
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  anchor?: string;
}
const { lang, anchor } = Astro.props;
const copy = t(lang);
const c = copy.compare;
const all = [...c.rows, { ...c.self, carry: '—' }];
---
<div class="compare">
  <table class="ctable">
    <thead>
      <tr>
        {c.head.map((h) => <th scope="col">{h}</th>)}
      </tr>
    </thead>
    <tbody>
      {c.rows.map((row) => (
        <tr>
          <th scope="row">{row.type}</th>
          <td>{row.good}</td>
          <td>{row.carry}</td>
          <td>{row.diff}</td>
        </tr>
      ))}
      <tr class="self" data-thread-anchor={anchor}>
        <th scope="row">{c.self.type}</th>
        <td colspan="2">{c.self.good}</td>
        <td>{c.self.diff}</td>
      </tr>
    </tbody>
  </table>

  <div class="ccards">
    {all.map((row, i) => (
      <article class={`ccard ${i === all.length - 1 ? 'ccard--self' : ''}`}>
        <h3>{row.type}</h3>
        <dl>
          <div><dt>{c.head[1]}</dt><dd>{row.good}</dd></div>
          <div><dt>{c.head[2]}</dt><dd>{row.carry}</dd></div>
          <div><dt>{c.head[3]}</dt><dd>{row.diff}</dd></div>
        </dl>
      </article>
    ))}
  </div>
</div>

<style>
  .ctable {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  .ctable th,
  .ctable td {
    padding: 18px 14px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    font-size: 14px;
    line-height: 1.6;
  }
  .ctable thead th {
    font-family: var(--f-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-top: 0;
    border-bottom-color: var(--line-2);
  }
  .ctable tbody tr {
    min-height: 72px;
  }
  .ctable tbody th {
    font-family: var(--f-zh-display);
    font-weight: 700;
    font-size: 15px;
    color: var(--ink);
    width: 20%;
  }
  .ctable td {
    color: var(--ink-2);
    width: 26.66%;
  }
  .ctable tr.self th,
  .ctable tr.self td {
    background: #12241d;
    color: var(--night-text);
    border-bottom: 0;
  }
  .ctable tr.self th {
    color: var(--lime);
    border-radius: var(--r-md) 0 0 var(--r-md);
  }
  .ctable tr.self td:last-child {
    border-radius: 0 var(--r-md) var(--r-md) 0;
  }
  .ctable tr.self td {
    color: rgba(233, 239, 230, 0.82);
  }
  .ccards {
    display: none;
  }
  @media (max-width: 900px) {
    .ctable {
      display: none;
    }
    .ccards {
      display: grid;
      gap: 14px;
    }
    .ccard {
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      background: var(--card);
      padding: 20px;
    }
    .ccard h3 {
      font-size: 19px;
      margin-bottom: 12px;
    }
    .ccard dl {
      display: grid;
      gap: 9px;
    }
    .ccard dl > div {
      display: grid;
      gap: 2px;
    }
    .ccard dt {
      font-family: var(--f-mono);
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-3);
    }
    .ccard dd {
      font-size: 14px;
      color: var(--ink-2);
      line-height: 1.6;
    }
    .ccard--self {
      background: #12241d;
      border-color: #12241d;
      color: var(--night-text);
    }
    .ccard--self h3 {
      color: var(--lime);
    }
    .ccard--self dt {
      color: rgba(233, 239, 230, 0.5);
    }
    .ccard--self dd {
      color: rgba(233, 239, 230, 0.82);
    }
  }
</style>
