---
interface Props {
  value: string;
  captionA: string;
  captionB: string;
  from?: string;
  to?: string;
  prefix?: string;
  suffix?: string;
  rangeTo?: string;
  index?: number;
}
const { value, captionA, captionB, from = '0', to, prefix = '', suffix = '', rangeTo, index = 0 } = Astro.props;
---
<div class="metric reveal" style={`--i:${index}`}>
  <b
    data-metric
    data-from={from}
    data-to={to ?? ''}
    data-prefix={prefix}
    data-suffix={suffix}
    data-range-to={rangeTo ?? ''}
  >{value}</b>
  <span>{captionA}<br />{captionB}</span>
</div>

<style>
  .metric {
    border: 1px solid var(--night-line);
    border-radius: var(--r-lg);
    padding: 26px;
    background: var(--night-2);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 190px;
  }
  html[data-daypart="night"] .metric {
    background: var(--night-3);
  }
  b {
    display: block;
    font-family: var(--f-latin-display);
    font-weight: 400;
    font-size: clamp(3rem, 2.2rem + 2.4vw, 4rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--lime);
    font-variant-numeric: tabular-nums;
  }
  span {
    display: block;
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--night-dim);
  }
</style>
