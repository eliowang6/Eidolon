---
interface Props {
  title?: string;
  desc?: string;
  variant?: 'card' | 'large';
  labels?: boolean;
}
const { title, desc, variant = 'card', labels = true } = Astro.props;
const layers = [1, 2, 3, 4, 5];
---
<div class={`ml ml--${variant}`}>
  {title && <div class="ml-head"><b>{title}</b><span>{desc}</span></div>}
  <div class="layers" aria-hidden="true">
    {layers.map((n) => (
      <div class="layer" style={`--n:${n}`}>
        {labels && <span class="ln mono">L{n}</span>}
      </div>
    ))}
  </div>
</div>

<style>
  .ml {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .ml-head b {
    display: block;
    font-family: var(--f-zh-display);
    font-weight: 700;
    font-size: 17px;
    color: var(--night-text);
    margin-bottom: 4px;
  }
  .ml-head span {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--night-dim);
  }
  .layers {
    position: relative;
    height: 190px;
    perspective: 800px;
  }
  .layer {
    position: absolute;
    left: 4%;
    right: 4%;
    height: 46px;
    border-radius: 10px;
    border: 1px solid rgba(200, 241, 105, 0.34);
    background: rgba(200, 241, 105, 0.05);
    transform: skewX(-14deg);
    opacity: calc(0.32 + var(--n) * 0.14);
    transition: opacity var(--t-mid) var(--ease), transform var(--t-mid) var(--ease),
      background var(--t-mid) var(--ease);
  }
  .layer:nth-child(1) { top: 0; }
  .layer:nth-child(2) { top: 34px; }
  .layer:nth-child(3) { top: 68px; }
  .layer:nth-child(4) { top: 102px; }
  .layer:nth-child(5) {
    top: 136px;
    background: rgba(200, 241, 105, 0.14);
  }
  .ln {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%) skewX(14deg);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--lime);
    opacity: 0.8;
  }
  .layers:hover .layer {
    opacity: 0.22;
  }
  .layers .layer:hover {
    opacity: 1;
    transform: skewX(-14deg) translateX(8px);
    background: rgba(200, 241, 105, 0.2);
  }
  .ml--large .layers {
    height: 280px;
  }
  .ml--large .layer {
    height: 68px;
    border-radius: 14px;
    left: 2%;
    right: 2%;
  }
  .ml--large .layer:nth-child(1) { top: 0; }
  .ml--large .layer:nth-child(2) { top: 50px; }
  .ml--large .layer:nth-child(3) { top: 100px; }
  .ml--large .layer:nth-child(4) { top: 150px; }
  .ml--large .layer:nth-child(5) { top: 200px; }
  .ml--large .ln {
    font-size: 11px;
    left: 18px;
  }
  @media (max-width: 767px) {
    .ml--large .layers {
      height: 230px;
    }
    .ml--large .layer {
      height: 54px;
    }
    .ml--large .layer:nth-child(2) { top: 40px; }
    .ml--large .layer:nth-child(3) { top: 80px; }
    .ml--large .layer:nth-child(4) { top: 120px; }
    .ml--large .layer:nth-child(5) { top: 160px; }
  }
</style>
