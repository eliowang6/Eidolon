---
interface Props {
  size?: number;
  class?: string;
}
const { size = 18, class: className = '' } = Astro.props;
---
<span
  class={`instarmony-mark ${className}`.trim()}
  style={`width:${size}px;height:${size}px`}
  aria-hidden="true"
/>

<style>
  .instarmony-mark {
    display: inline-block;
    flex: none;
    background-color: currentColor;
    -webkit-mask: url('/assets/instarmony-mark.png') center / contain no-repeat;
    mask: url('/assets/instarmony-mark.png') center / contain no-repeat;
  }
</style>
