---
/**
 * The app opens on an indigo night where a comet draws ∞. Here the two lobes
 * are windows: Fea on the left, Ael on the right. Choosing one re-themes the
 * whole site (see scripts/site.ts → data-companion-set).
 */
interface Props {
  feaLabel: string;
  aelLabel: string;
  feaTag: string;
  aelTag: string;
  groupLabel: string;
  /** Draw the comet on load (hero) or show the finished mark (elsewhere). */
  animate?: boolean;
  class?: string;
}
const { feaLabel, aelLabel, feaTag, aelTag, groupLabel, animate = true, class: className = '' } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
const id = (name: string) => `${name}-${uid}`;
const FULL =
  'M480 260c-80-106.8-160-160-240-160a160 160 0 1 0 0 320c80 0 160-53.2 240-160Zm0 0c80 106.8 160 160 240 160a160 160 0 0 0 0-320c-80 0-160 53.2-240 160Z';
const LEFT = 'M480 260c-80-106.8-160-160-240-160a160 160 0 1 0 0 320c80 0 160-53.2 240-160Z';
const RIGHT = 'M480 260c80 106.8 160 160 240 160a160 160 0 0 0 0-320c-80 0-160 53.2-240 160Z';
---

<div class={`inf ${animate ? 'inf--animate' : ''} ${className}`}>
  <svg class="inf-svg" viewBox="40 60 880 400" role="img" aria-label={groupLabel}>
    <defs>
      <linearGradient id={id('holo')} x1="80" y1="260" x2="880" y2="260" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#f8a8d0" />
        <stop offset="0.38" stop-color="#e2b8f4" />
        <stop offset="0.55" stop-color="#cdb6ff" />
        <stop offset="0.78" stop-color="#92c6ff" />
        <stop offset="1" stop-color="#a8f0dc" />
      </linearGradient>
      <radialGradient id={id('rimF')} cx="240" cy="250" r="190" gradientUnits="userSpaceOnUse">
        <stop offset="0.62" stop-color="#ef8fbb" stop-opacity="0" />
        <stop offset="1" stop-color="#ef8fbb" stop-opacity="0.55" />
      </radialGradient>
      <radialGradient id={id('rimA')} cx="720" cy="250" r="190" gradientUnits="userSpaceOnUse">
        <stop offset="0.62" stop-color="#6ea9f2" stop-opacity="0" />
        <stop offset="1" stop-color="#6ea9f2" stop-opacity="0.55" />
      </radialGradient>
      <clipPath id={id('clipL')}><path d={LEFT} /></clipPath>
      <clipPath id={id('clipR')}><path d={RIGHT} /></clipPath>
      <filter id={id('glow')} x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="6" result="b" />
        <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
      <filter id={id('soft')} x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="14" />
      </filter>
    </defs>

    <!-- halo behind the mark -->
    <path class="inf-halo" d={FULL} stroke={`url(#${id('holo')})`} filter={`url(#${id('soft')})`} />

    <g class="lobe lobe--fea" clip-path={`url(#${id('clipL')})`}>
      <rect x="60" y="80" width="430" height="360" fill="#fbf7fb" />
      <image href="/assets/art/fea-portrait.webp" x="34" y="92" width="446.4" height="558" preserveAspectRatio="xMidYMid slice" />
      <rect x="60" y="80" width="430" height="360" fill={`url(#${id('rimF')})`} />
    </g>
    <g class="lobe lobe--ael" clip-path={`url(#${id('clipR')})`}>
      <rect x="470" y="80" width="430" height="360" fill="#f7f8fd" />
      <image href="/assets/art/ael-portrait.webp" x="466" y="96" width="446.4" height="558" preserveAspectRatio="xMidYMid slice" />
      <rect x="470" y="80" width="430" height="360" fill={`url(#${id('rimA')})`} />
    </g>

    <path class="inf-trace" d={FULL} pathLength="1" stroke={`url(#${id('holo')})`} />
    <path class="inf-comet" d={FULL} pathLength="1" filter={`url(#${id('glow')})`} />
    <path class="inf-shine" d={FULL} pathLength="1" />
  </svg>

  <div class="inf-pick" role="group" aria-label={groupLabel}>
    <button type="button" class="inf-hit inf-hit--fea" data-companion-set="fea" aria-pressed="true">
      <span class="sr-only">{feaLabel}</span>
    </button>
    <button type="button" class="inf-hit inf-hit--ael" data-companion-set="ael" aria-pressed="false">
      <span class="sr-only">{aelLabel}</span>
    </button>
  </div>

  <div class="inf-names" aria-hidden="true">
    <p class="inf-name inf-name--fea"><b>Fea</b><span>{feaTag}</span></p>
    <p class="inf-name inf-name--ael"><b>Ael</b><span>{aelTag}</span></p>
  </div>
</div>

<style>
  .inf {
    position: relative;
    width: 100%;
  }
  .inf-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .inf-halo {
    fill: none;
    stroke-width: 26;
    opacity: 0.32;
  }
  .inf-trace {
    fill: none;
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .inf-comet {
    fill: none;
    stroke: #fff;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 0.05 1;
    stroke-dashoffset: 0.05;
    opacity: 0;
  }
  .inf-shine {
    fill: none;
    stroke: rgba(255, 255, 255, 0.85);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 0.035 1;
    stroke-dashoffset: 0.035;
    opacity: 0;
  }
  .lobe {
    transition: opacity 700ms var(--ease), filter 700ms var(--ease);
  }
  .lobe image {
    transform-box: fill-box;
    transform-origin: 50% 30%;
    transition: transform 1200ms var(--ease);
  }

  /* the one you're with is lit; the other waits in the dark */
  :global(html[data-companion='fea']) .lobe--ael,
  :global(html[data-companion='ael']) .lobe--fea {
    opacity: 0.42;
    filter: saturate(0.55) brightness(0.8);
  }
  .inf:has(.inf-hit--fea:hover) .lobe--fea,
  .inf:has(.inf-hit--ael:hover) .lobe--ael {
    opacity: 1;
    filter: none;
  }
  .inf:has(.inf-hit--fea:hover) .lobe--fea image,
  .inf:has(.inf-hit--ael:hover) .lobe--ael image {
    transform: scale(1.035);
  }

  /* hit areas sit over the two circles of the mark */
  .inf-pick {
    position: absolute;
    inset: 0;
  }
  .inf-hit {
    position: absolute;
    top: 10%;
    width: 36.4%;
    height: 80%;
    border-radius: 50%;
    cursor: pointer;
  }
  .inf-hit--fea {
    left: 4.55%;
  }
  .inf-hit--ael {
    right: 4.55%;
  }
  .inf-hit:focus-visible {
    outline: 2px dashed var(--night-text);
    outline-offset: 6px;
    border-radius: 50%;
  }

  .inf-names {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: clamp(4px, 1.4vw, 14px);
  }
  .inf-name {
    display: grid;
    justify-items: center;
    gap: 2px;
    text-align: center;
    transition: opacity 600ms var(--ease);
  }
  .inf-name--fea {
    margin-right: 9%;
  }
  .inf-name--ael {
    margin-left: 9%;
  }
  .inf-name b {
    font-family: var(--f-latin-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.3rem);
    line-height: 1;
    letter-spacing: 0.01em;
  }
  .inf-name--fea b {
    color: #ffc2dc;
  }
  .inf-name--ael b {
    color: #b9d6ff;
  }
  .inf-name span {
    font-size: clamp(11.5px, 0.7rem + 0.25vw, 13.5px);
    color: var(--night-dim);
    letter-spacing: 0.04em;
  }
  :global(html[data-companion='fea']) .inf-name--ael,
  :global(html[data-companion='ael']) .inf-name--fea {
    opacity: 0.5;
  }

  /* ── the comet ─────────────────────────────────────── */
  .inf--animate .inf-trace {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    animation: inf-draw 2600ms cubic-bezier(0.55, 0.1, 0.35, 1) 250ms forwards;
  }
  .inf--animate .inf-comet {
    animation:
      inf-comet 2600ms cubic-bezier(0.55, 0.1, 0.35, 1) 250ms forwards,
      inf-comet-fade 2600ms linear 250ms forwards;
  }
  .inf--animate .inf-halo {
    opacity: 0;
    animation: inf-fade-to 1400ms var(--ease) 2200ms forwards;
    --to: 0.32;
  }
  .inf--animate .lobe--fea image,
  .inf--animate .lobe--fea rect {
    opacity: 0;
    animation: inf-open 1100ms var(--ease) 1250ms forwards;
  }
  .inf--animate .lobe--ael image,
  .inf--animate .lobe--ael rect {
    opacity: 0;
    animation: inf-open 1100ms var(--ease) 2500ms forwards;
  }
  .inf--animate .inf-names {
    opacity: 0;
    animation: inf-fade-to 900ms var(--ease) 2700ms forwards;
    --to: 1;
  }
  .inf--animate .inf-shine {
    animation: inf-shine 9s linear 5s infinite;
  }
  @keyframes inf-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes inf-comet {
    to {
      stroke-dashoffset: -0.95;
    }
  }
  @keyframes inf-comet-fade {
    0% {
      opacity: 0;
    }
    4%,
    86% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes inf-open {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes inf-fade-to {
    to {
      opacity: var(--to, 1);
    }
  }
  @keyframes inf-shine {
    0% {
      stroke-dashoffset: 0.035;
      opacity: 0;
    }
    3% {
      opacity: 0.9;
    }
    40% {
      stroke-dashoffset: -0.965;
      opacity: 0.9;
    }
    44%,
    100% {
      stroke-dashoffset: -0.965;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .inf--animate .inf-trace {
      animation: none;
      stroke-dashoffset: 0;
    }
    .inf--animate .inf-comet,
    .inf--animate .inf-shine {
      animation: none;
      opacity: 0;
    }
    .inf--animate .lobe--fea image,
    .inf--animate .lobe--fea rect,
    .inf--animate .lobe--ael image,
    .inf--animate .lobe--ael rect,
    .inf--animate .inf-names,
    .inf--animate .inf-halo {
      animation: none;
      opacity: 1;
    }
    .inf--animate .inf-halo {
      opacity: 0.32;
    }
  }
</style>
