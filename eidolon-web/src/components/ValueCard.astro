---
import WindowFrame from './WindowFrame.astro';
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';

interface Props {
  card: {
    label: string;
    title: string;
    desc: string;
    bullets: string[];
    skin: string;
    media: string;
  };
  lang: Lang;
  index?: number;
}
const { card, lang, index = 0 } = Astro.props;
const copy = t(lang);
const task = copy.loop.steps[3];
---
<article class={`value value--${card.skin} reveal`} style={`--i:${index}`}>
  <span class="label">{card.label}</span>
  <h3>{card.title}</h3>
  <p class="desc">{card.desc}</p>

  <div class="media" aria-hidden="true">
    {card.media === 'shot' && (
      <div class="media-shot">
        <img src="/assets/screenshots/app-mobile-home.webp" alt="" width="390" height="844" loading="lazy" decoding="async" />
      </div>
    )}
    {card.media === 'window' && (
      <div class="media-window">
        <WindowFrame title="Focus Cabin">
          <img src="/assets/screenshots/app-focus-cabin.webp" alt="" width="1440" height="1100" loading="lazy" decoding="async" />
        </WindowFrame>
      </div>
    )}
    {card.media === 'task' && (
      <div class="mini-task">
        <div class="mt-top">
          <span class="chip"><span class="live" aria-hidden="true"></span>{task.stageTitle}</span>
          <span class="mono">{task.time}</span>
        </div>
        <ul>
          {task.log.map((line) => (
            <li><span class="tick"><Icon name="check" size={11} stroke={2.6} /></span>{line}</li>
          ))}
        </ul>
        <div class="mt-foot">
          <span>{task.note}</span>
          <span class="mt-btns">
            {task.buttons.map((label, i) => <span class={i === 0 ? 'on' : ''}>{label}</span>)}
          </span>
        </div>
      </div>
    )}
  </div>

  <ul class="bullets">
    {card.bullets.map((bullet) => <li>{bullet}</li>)}
  </ul>
</article>

<style>
  .value {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px 30px 28px;
    border-radius: var(--r-xl);
    border: 1px solid var(--line);
    background: var(--card);
    overflow: hidden;
  }
  .value--dark {
    background: #12241d;
    color: var(--night-text);
    border-color: #12241d;
  }
  html[data-daypart="night"] .value--dark {
    background: var(--night-3);
    border-color: var(--night-line);
  }
  .value--dark .label {
    color: var(--lime);
  }
  .value--dark .desc {
    color: var(--night-dim);
  }
  .value--sage {
    background: var(--sage-wash);
    border-color: transparent;
  }
  .label {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sage-deep);
  }
  h3 {
    font-size: 30px;
    margin-top: 2px;
  }
  html[lang="en"] h3 {
    font-size: 34px;
  }
  .desc {
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.7;
    min-height: 3.4em;
  }
  .media {
    margin: 10px 0 6px;
    height: 230px;
    border-radius: var(--r-md);
    position: relative;
  }
  /* A slice of the real app: the greeting card from the home screen. */
  .media-shot {
    height: 100%;
    overflow: hidden;
    border-radius: var(--r-md);
    background: #f4efe4;
    box-shadow: 0 0 0 1px rgba(233, 239, 230, 0.08), 0 24px 40px -24px rgba(0, 0, 0, 0.6);
  }
  .media-shot img {
    width: 128%;
    max-width: none;
    margin: -95% 0 0 -27%;
  }
  .media-window {
    height: 100%;
  }
  .media-window :global(.wf) {
    height: 100%;
    box-shadow: none;
  }
  .media-window :global(.wf-body) {
    height: calc(100% - 28px);
  }
  .media-window :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .mini-task {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 16px 16px 14px;
    font-size: 13.5px;
    color: var(--ink-2);
    box-shadow: 0 18px 32px -24px rgba(18, 36, 29, 0.4);
  }
  .mt-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .mt-top .mono {
    font-size: 11px;
    color: var(--ink-3);
  }
  .mt-top .chip {
    font-family: var(--f-latin-display);
    font-style: italic;
    font-size: 15px;
    padding: 2px 10px 2px 8px;
  }
  .mt-top .chip .live {
    width: 6px;
    height: 6px;
  }
  .mt-top .chip .live::after {
    inset: -4px;
  }
  .mini-task ul {
    display: grid;
    gap: 9px;
  }
  .mini-task li {
    display: flex;
    gap: 9px;
    align-items: flex-start;
    line-height: 1.5;
  }
  .tick {
    width: 17px;
    height: 17px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--sage-deep);
    color: #fff;
    flex: none;
    margin-top: 1px;
  }
  html[data-daypart="night"] .tick {
    color: #0e1a15;
  }
  .mt-foot {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px dashed var(--line-2);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    color: var(--ink-3);
  }
  .mt-btns {
    display: flex;
    gap: 6px;
  }
  .mt-btns span {
    padding: 2px 9px;
    border-radius: var(--r-full);
    border: 1px solid transparent;
  }
  .mt-btns span.on {
    border-color: var(--line-2);
    color: var(--ink-2);
  }
  .bullets {
    margin-top: auto;
    border-top: 1px solid rgba(127, 127, 127, 0.22);
    padding-top: 18px;
    display: grid;
    gap: 9px;
    font-size: 15px;
  }
  .bullets li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .bullets li::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sage-deep);
    flex: none;
    transform: translateY(-2px);
  }
  .value--dark .bullets li::before {
    background: var(--lime);
  }
  @media (max-width: 1100px) and (min-width: 901px) {
    .value {
      padding: 26px 22px 24px;
    }
    h3 {
      font-size: 26px;
    }
    .media {
      height: 200px;
    }
  }
  @media (max-width: 767px) {
    .media {
      height: 240px;
    }
    .desc {
      min-height: 0;
    }
  }
</style>
