---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE } from '../config/site';
import { localizePath, otherLang, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const copy = t(lang);
const other = otherLang(lang);
const langHref = localizePath(other, path);
const joinHref = SITE.status === 'public-beta' ? localizePath(lang, '/download.html') : localizePath(lang, '/beta.html') + '#join';

const links = [
  { href: '/features.html', label: copy.nav.features },
  { href: '/how-it-works.html', label: copy.nav.how },
  { href: '/pricing.html', label: copy.nav.pricing },
  { href: '/about.html', label: copy.nav.about },
  { href: '/docs.html', label: copy.nav.docs },
];
const isActive = (href: string) => path === href;
---
<header class="nav" id="site-nav">
  <div class="container nav-inner">
    <a class="brand" href={localizePath(lang, '/')} aria-label={copy.nav.home}>
      <Logo size={32} />
      <span>Eidolon</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      <ul>
        {links.map((link) => (
          <li>
            <a href={localizePath(lang, link.href)} aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <a class="lang" href={langHref} data-lang-switch={other} aria-label={copy.nav.langLabel}>{copy.nav.lang}</a>
      <a class="btn btn-ghost btn-sm nav-download" href={localizePath(lang, '/download.html')}>{copy.nav.download}</a>
      <a class="btn btn-ink btn-sm nav-join" href={joinHref}>
        <span class="dot" aria-hidden="true"></span>
        <span class="nav-join-full">{copy.nav.join}</span>
        <span class="nav-join-short">{copy.nav.joinShort}</span>
      </a>
      <button class="burger" type="button" aria-label={copy.nav.menu} aria-expanded="false" aria-controls="nav-drawer" data-drawer-open>
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="nav-drawer" role="dialog" aria-modal="true" aria-label={copy.nav.menu} hidden>
  <div class="container drawer-inner">
    <div class="drawer-top">
      <a class="brand" href={localizePath(lang, '/')} aria-label={copy.nav.home}>
        <Logo size={32} />
        <span>Eidolon</span>
      </a>
      <button class="burger" type="button" aria-label={copy.nav.close} data-drawer-close>
        <Icon name="close" size={24} />
      </button>
    </div>
    <nav class="drawer-links" aria-label="Primary">
      {links.map((link) => (
        <a href={localizePath(lang, link.href)} aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
    <div class="drawer-actions">
      <a class="btn btn-ghost" href={localizePath(lang, '/download.html')}>
        <Icon name="download" size={18} />
        {copy.nav.download}
      </a>
      <a class="btn btn-ink" href={joinHref}>
        <span class="dot" aria-hidden="true"></span>
        {copy.nav.join}
      </a>
      <a class="lang" href={langHref} data-lang-switch={other} aria-label={copy.nav.langLabel}>{copy.nav.lang}</a>
    </div>
  </div>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 80;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    transition: background var(--t-mid) var(--ease), box-shadow var(--t-mid) var(--ease);
  }
  .nav.scrolled {
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: 0 1px 0 var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 40px);
    width: 100%;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    flex: none;
  }
  .brand span {
    font-family: var(--f-latin-display);
    font-size: 28px;
    line-height: 1;
    letter-spacing: 0.01em;
  }
  .nav-links {
    margin-right: auto;
  }
  .nav-links ul {
    display: flex;
    gap: clamp(18px, 2.4vw, 30px);
  }
  .nav-links a {
    position: relative;
    font-size: 15px;
    color: var(--ink-2);
    padding: 4px 0;
  }
  .nav-links a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1.5px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-fast) var(--ease);
  }
  .nav-links a:hover::after,
  .nav-links a[aria-current="page"]::after {
    transform: scaleX(1);
  }
  .nav-links a[aria-current="page"] {
    color: var(--ink);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
  }
  .lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 32px;
    padding: 0 10px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-full);
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--ink-2);
    transition: border-color var(--t-fast), color var(--t-fast), background var(--t-fast);
  }
  .lang:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .nav-join-short {
    display: none;
  }
  .burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    color: var(--ink);
  }
  @media (max-width: 1023px) {
    .nav-links,
    .nav-download {
      display: none;
    }
    .burger {
      display: inline-flex;
    }
    .nav-actions {
      margin-left: auto;
    }
  }
  @media (max-width: 420px) {
    .nav-join-full {
      display: none;
    }
    .nav-join-short {
      display: inline;
    }
    .brand span {
      font-size: 24px;
    }
  }

  .drawer {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: var(--paper);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .drawer-inner {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding-top: 14px;
    padding-bottom: 32px;
  }
  .drawer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
  }
  .drawer-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: clamp(28px, 8vh, 72px) 0 32px;
  }
  .drawer-links a {
    font-family: var(--f-zh-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 7vw, 2.25rem);
    line-height: 1.5;
    color: var(--ink-2);
    padding: 6px 0;
    border-bottom: 1px solid var(--line);
  }
  .drawer-links a[aria-current="page"] {
    color: var(--ink);
  }
  .drawer-actions {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .drawer-actions .lang {
    margin-left: auto;
  }
  html[lang="en"] .drawer-links a {
    font-family: var(--f-latin-display);
    font-weight: 400;
  }
</style>
