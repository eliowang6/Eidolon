---
import Logo from './Logo.astro';
import { localizePath, otherLang, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  path: string;
  tone?: 'night' | 'pearl';
}
const { lang, path, tone = 'night' } = Astro.props;
const copy = t(lang);
const p = (href: string) => localizePath(lang, href);
const links = [
  { href: '/features.html', label: copy.nav.features },
  { href: '/how-it-works.html', label: copy.nav.trust },
  { href: '/pricing.html', label: copy.nav.pricing },
  { href: '/dew.html', label: copy.nav.dew },
  { href: '/beta.html', label: copy.nav.changelog },
  { href: '/about.html', label: copy.nav.about },
  { href: '/docs.html', label: copy.nav.docs },
];
const other = otherLang(lang);
const isCurrent = (href: string) => path === href;
---

<header class="nav" id="site-nav" data-tone={tone}>
  <div class="nav-in">
    <a class="brand" href={p('/')} aria-label={copy.nav.home}>
      <Logo size={26} />
      <span class="wordmark">Sholarel</span>
    </a>

    <nav class="links" aria-label={copy.nav.primary}>
      {links.map((link) => (
        <a href={p(link.href)} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>

    <div class="tools">
      <div class="cswitch" role="group" aria-label={copy.nav.companion}>
        <button type="button" data-companion-set="fea" aria-pressed="true" title={copy.nav.withFea}>
          <img src="/assets/art/fea-avatar.webp" alt="" width="30" height="30" />
          <span class="sr-only">{copy.nav.withFea}</span>
        </button>
        <button type="button" data-companion-set="ael" aria-pressed="false" title={copy.nav.withAel}>
          <img src="/assets/art/ael-avatar.webp" alt="" width="30" height="30" />
          <span class="sr-only">{copy.nav.withAel}</span>
        </button>
      </div>
      <a class="lang" href={localizePath(other, path)} data-lang-switch={other} hreflang={other === 'zh' ? 'zh-Hans' : 'en'} aria-label={copy.nav.langLabel}>{copy.nav.lang}</a>
      <a class="nav-cta" href={p('/download.html')}>{copy.nav.download}</a>
      <button type="button" class="burger" data-drawer-open aria-controls="nav-drawer" aria-expanded="false">
        <span class="sr-only">{copy.nav.menu}</span>
        <span class="burger-lines" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="drawer" id="nav-drawer" hidden role="dialog" aria-modal="true" aria-label={copy.nav.menu}>
    <div class="drawer-top">
      <a class="brand" href={p('/')} aria-label={copy.nav.home}>
        <Logo size={26} />
        <span class="wordmark">Sholarel</span>
      </a>
      <button type="button" class="drawer-close" data-drawer-close aria-label={copy.nav.close}>
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <nav class="drawer-links" aria-label={copy.nav.primary}>
      {links.map((link, i) => (
        <a href={p(link.href)} style={`--i:${i}`} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <div class="drawer-foot">
      <div class="drawer-switch" role="group" aria-label={copy.nav.companion}>
        <button type="button" data-companion-set="fea" aria-pressed="true">
          <img src="/assets/art/fea-avatar.webp" alt="" width="34" height="34" />
          <span>Fea</span>
        </button>
        <button type="button" data-companion-set="ael" aria-pressed="false">
          <img src="/assets/art/ael-avatar.webp" alt="" width="34" height="34" />
          <span>Ael</span>
        </button>
      </div>
      <div class="drawer-actions">
        <a class="btn btn-holo" href={p('/download.html')}>{copy.nav.download}</a>
        <a class="btn btn-ghost" href={localizePath(other, path)} data-lang-switch={other}>{copy.nav.langLong}</a>
      </div>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    padding: 0 clamp(10px, 2vw, 22px);
    pointer-events: none;
  }
  .nav-in {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 28px);
    height: var(--nav-h);
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 clamp(10px, 1.6vw, 18px);
    border: 1px solid transparent;
    border-radius: var(--r-full);
    color: var(--night-text);
    transition: background var(--t-mid) var(--ease), margin var(--t-mid) var(--ease), height var(--t-mid) var(--ease),
      border-color var(--t-mid) var(--ease), box-shadow var(--t-mid) var(--ease), color var(--t-fast) var(--ease),
      max-width var(--t-mid) var(--ease);
  }
  .nav[data-tone='pearl'] .nav-in {
    color: var(--ink);
  }
  .nav.scrolled .nav-in {
    margin-top: 10px;
    height: 56px;
    max-width: 1200px;
    color: var(--ink);
    background: color-mix(in srgb, #fbfaff 80%, transparent);
    border-color: rgba(27, 30, 58, 0.08);
    box-shadow: 0 18px 40px -26px rgba(14, 17, 49, 0.45);
    backdrop-filter: blur(18px) saturate(1.3);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex: none;
    color: inherit;
  }
  .wordmark {
    font-family: var(--f-latin-display);
    font-size: 23px;
    font-weight: 500;
    letter-spacing: 0.005em;
    line-height: 1;
    font-variation-settings: 'opsz' 28;
  }

  .links {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.7vw, 26px);
    margin-inline: auto;
  }
  .links a {
    position: relative;
    font-size: 14.5px;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0.78;
    transition: opacity var(--t-fast);
    padding: 6px 0;
  }
  .links a:hover,
  .links a[aria-current='page'] {
    opacity: 1;
  }
  .links a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--holo);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
  }
  .cswitch {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: var(--r-full);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .nav.scrolled .cswitch,
  .nav[data-tone='pearl'] .cswitch {
    background: rgba(27, 30, 58, 0.05);
    border-color: rgba(27, 30, 58, 0.08);
  }
  .cswitch button {
    position: relative;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    padding: 1px;
    transition: transform var(--t-fast) var(--ease), filter var(--t-fast) var(--ease), opacity var(--t-fast);
    filter: grayscale(0.7);
    opacity: 0.6;
    transform: scale(0.86);
  }
  .cswitch button img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }
  .cswitch button:hover {
    opacity: 0.95;
    filter: none;
  }
  .cswitch button[aria-pressed='true'] {
    filter: none;
    opacity: 1;
    transform: none;
  }
  .cswitch button[data-companion-set='fea'][aria-pressed='true'] {
    box-shadow: 0 0 0 2px var(--fea);
  }
  .cswitch button[data-companion-set='ael'][aria-pressed='true'] {
    box-shadow: 0 0 0 2px var(--ael);
  }

  .lang {
    display: grid;
    place-items: center;
    min-width: 38px;
    height: 36px;
    padding: 0 8px;
    border-radius: var(--r-full);
    font: 600 13px/1 var(--f-body);
    letter-spacing: 0.04em;
    opacity: 0.8;
  }
  .lang:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.08);
  }
  .nav.scrolled .lang:hover,
  .nav[data-tone='pearl'] .lang:hover {
    background: rgba(27, 30, 58, 0.06);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 18px;
    border-radius: var(--r-full);
    font: 600 14px/1 var(--f-body);
    background: #f6f4fa;
    color: #141838;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.4) inset;
    transition: transform var(--t-fast) var(--ease), background var(--t-fast), color var(--t-fast);
  }
  .nav-cta:hover {
    transform: translateY(-1px);
  }
  .nav.scrolled .nav-cta,
  .nav[data-tone='pearl'] .nav-cta {
    background: #141838;
    color: #f6f4fa;
  }

  .burger {
    display: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    place-items: center;
    color: inherit;
  }
  .burger-lines {
    display: grid;
    gap: 6px;
    width: 18px;
  }
  .burger-lines i {
    display: block;
    height: 1.6px;
    border-radius: 2px;
    background: currentColor;
  }
  .burger-lines i:last-child {
    width: 12px;
    justify-self: end;
  }

  /* drawer */
  .drawer {
    pointer-events: auto;
    position: fixed;
    inset: 0;
    z-index: 120;
    display: flex;
    flex-direction: column;
    padding: 0 clamp(20px, 6vw, 40px) max(28px, env(safe-area-inset-bottom));
    background:
      radial-gradient(70% 50% at 15% 10%, rgba(239, 143, 187, 0.22), transparent 70%),
      radial-gradient(70% 50% at 90% 30%, rgba(110, 169, 242, 0.22), transparent 70%),
      var(--night);
    color: var(--night-text);
    overflow-y: auto;
    opacity: 0;
    transition: opacity var(--t-mid) var(--ease);
  }
  .drawer.open {
    opacity: 1;
  }
  .drawer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
    flex: none;
  }
  .drawer-close {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-size: 28px;
    line-height: 1;
    color: inherit;
    background: rgba(255, 255, 255, 0.08);
  }
  .drawer-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: clamp(16px, 5vh, 40px) 0 28px;
  }
  .drawer-links a {
    font-family: var(--f-display);
    font-size: clamp(1.9rem, 1.4rem + 2.6vw, 2.6rem);
    font-weight: 700;
    line-height: 1.32;
    color: var(--night-text);
    opacity: 0;
    translate: 0 10px;
    transition: opacity var(--t-mid) var(--ease), translate var(--t-mid) var(--ease);
    transition-delay: calc(var(--i) * 40ms + 60ms);
  }
  :global(html[lang='en']) .drawer-links a {
    font-weight: 500;
  }
  .drawer.open .drawer-links a {
    opacity: 1;
    translate: 0 0;
  }
  .drawer-links a[aria-current='page'] {
    background: var(--holo);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .drawer-foot {
    margin-top: auto;
    display: grid;
    gap: 18px;
  }
  .drawer-switch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .drawer-switch button {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px 8px 8px;
    border-radius: var(--r-full);
    border: 1px solid var(--night-line);
    color: var(--night-dim);
    font-family: var(--f-latin-display);
    font-size: 19px;
    font-style: italic;
  }
  .drawer-switch img {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
  }
  .drawer-switch button[aria-pressed='true'] {
    color: var(--night-text);
    background: rgba(255, 255, 255, 0.08);
  }
  .drawer-switch button[data-companion-set='fea'][aria-pressed='true'] {
    border-color: var(--fea);
  }
  .drawer-switch button[data-companion-set='ael'][aria-pressed='true'] {
    border-color: var(--ael);
  }
  .drawer-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .drawer-actions .btn-ghost {
    background: rgba(255, 255, 255, 0.04);
    color: var(--night-text);
    border-color: rgba(238, 240, 255, 0.26);
  }

  @media (max-width: 1100px) {
    .links,
    .nav-cta,
    .lang {
      display: none;
    }
    .burger {
      display: grid;
    }
  }
  @media (max-width: 420px) {
    .wordmark {
      font-size: 21px;
    }
    .cswitch button {
      width: 30px;
      height: 30px;
    }
  }
</style>
