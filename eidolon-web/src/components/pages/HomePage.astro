---
import { Picture } from 'astro:assets';
import heroImage from '../../assets/hero/focus-cabin-2560.png';
import StatusPill from '../StatusPill.astro';
import Button from '../Button.astro';
import MarginNote from '../MarginNote.astro';
import PresenceCard from '../PresenceCard.astro';
import SectionHead from '../SectionHead.astro';
import TornCard from '../TornCard.astro';
import LoopStage from '../LoopStage.astro';
import ValueCard from '../ValueCard.astro';
import PermissionPanel from '../PermissionPanel.astro';
import Polaroid from '../Polaroid.astro';
import WaitlistLetter from '../WaitlistLetter.astro';
import Icon from '../Icon.astro';
import { SITE } from '../../config/site';
import { localizePath, t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const p = (href: string) => localizePath(lang, href);
const status = SITE.status;
const statusCopy = copy.statusCopy[status];
const joinHref = status === 'public-beta' ? p('/download.html') : `${p('/beta.html')}#join`;
const secondaryHref = statusCopy.kind === 'loop' ? '#loop' : p('/download.html');
const stitch = copy.why.stitch;
---
<div class="home" data-thread-home>
  <svg class="thread" data-thread aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="thread-ink" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="1"></linearGradient>
    </defs>
    <path class="thread-path" d="" />
    <g class="thread-beads"></g>
    <circle class="thread-tip" r="3.5" cx="0" cy="0" />
  </svg>

  <!-- Hero: the page takes the reader's local light -->
  <section class="hero" data-section-name={copy.hero.sectionName}>
    <div class="hero-media" aria-hidden="true">
      <Picture
        src={heroImage}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[960, 1440, 1920, 2560]}
        sizes="100vw"
        alt=""
        class="hero-img"
        loading="eager"
        fetchpriority="high"
        quality={72}
      />
      <div class="hero-tint"></div>
      <div class="hero-shafts"></div>
      <div class="hero-lamp"></div>
      <div class="hero-fade"></div>
    </div>

    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="hero-pill" data-thread-start><StatusPill text={statusCopy.pill} /></span>
        <h1>
          <span class="ln">{copy.hero.line1}</span>
          <span class="ln">{copy.hero.line2Pre}<span class="live-word">{copy.hero.line2Word}<svg viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true"><path d="M2 12C20 4 40 18 60 9s30-3 38 2" /></svg></span>{copy.hero.line2Post}</span>
        </h1>
        <p class="verbs" aria-label={copy.hero.verbs.join(' ')}>
          {copy.hero.verbs.map((verb, i) => <span aria-hidden="true" style={`--v:${i}`}>{verb}</span>)}
        </p>
        <p class="lede hero-lede">{copy.hero.lede}</p>
        <div class="hero-actions">
          <Button href={joinHref} variant="ink">{statusCopy.primary}</Button>
          <Button href={secondaryHref} variant="ghost">{statusCopy.secondary}</Button>
        </div>
        <p class="hero-meta">
          {copy.hero.platforms.map((platform, i) => (
            <span class={i === copy.hero.platforms.length - 1 ? 'muted' : ''}>{platform}</span>
          ))}
        </p>
      </div>

      <div class="hero-side">
        <MarginNote
          class="hero-note"
          text={copy.mnote.heroFirst}
          variant="scrap"
          arrow
          heroNote={{ first: copy.mnote.heroFirst, section: copy.mnote.heroBackSection, days: copy.mnote.heroBackDays }}
        />
        <PresenceCard lang={lang} />
      </div>
    </div>
  </section>

  <!-- Why -->
  <section class="section section--paper2 why" data-section-name={copy.why.label}>
    <div class="container">
      <SectionHead class="reveal" label={copy.why.label} h2a={copy.why.h2a} h2b={copy.why.h2b} node />
      <div class="fractures">
        {copy.why.cards.map((card, i) => (
          <TornCard title={card.title} desc={card.desc} class="reveal" style={`--i:${i}`} />
        ))}
      </div>
      <p class="stitch reveal">{stitch.pre}{stitch.marks.map((mark, i) => <><mark style={`--i:${i}`}>{mark}</mark>{stitch.mid[i] ?? ''}</>)}{stitch.post}</p>
    </div>
  </section>

  <!-- A day with her: five steps, pinned on desktop -->
  <section class="section loop-sec" id="loop" data-loop-section data-section-name={copy.loop.label}>
    <div class="container">
      <div class="loop-grid loop-desktop">
        <div class="stage-col">
          <LoopStage steps={copy.loop.steps} lang={lang} active={0} />
        </div>
        <div class="loop-copy">
          <SectionHead label={copy.loop.label} h2a={copy.loop.h2a} h2b={copy.loop.h2b} lede={copy.loop.lede} node />
          <ol class="steps" data-loop-steps>
            {copy.loop.steps.map((step, i) => (
              <li class={i === 0 ? 'on' : ''} data-loop-step={i}>
                <button type="button" aria-current={i === 0 ? 'step' : 'false'}>
                  <span class="t mono">{step.time}</span>
                  <span class="h">
                    <span class="no mono">0{i + 1}</span>
                    <span class="name">{step.name}</span>
                    {lang === 'zh' && <span class="en latin">{step.en}</span>}
                  </span>
                  <span class="d">{step.desc}</span>
                </button>
              </li>
            ))}
          </ol>
          <p class="loop-closing">{copy.loop.closing}</p>
        </div>
      </div>

      <div class="loop-mobile">
        <SectionHead class="reveal" label={copy.loop.label} h2a={copy.loop.h2a} h2b={copy.loop.h2b} lede={copy.loop.lede} />
        <div class="loop-mobile-list">
          {copy.loop.steps.map((step, i) => (
            <div class="loop-mobile-step reveal" data-loop-mobile-step={i}>
              <div class="lm-head">
                <span class="mono">0{i + 1} · {step.time}</span>
                <h3>{step.name}</h3>
                {lang === 'zh' && <span class="latin">{step.en}</span>}
              </div>
              <p>{step.desc}</p>
              <LoopStage steps={copy.loop.steps} lang={lang} active={i} single compact />
            </div>
          ))}
        </div>
        <p class="loop-closing">{copy.loop.closing}</p>
      </div>
    </div>
  </section>

  <!-- What she does -->
  <section class="section values-sec" data-section-name={copy.values.label}>
    <div class="container">
      <div class="values-head">
        <SectionHead class="reveal" label={copy.values.label} h2a={copy.values.h2} lede={copy.values.lede} node />
        <a class="tlink reveal" href={p('/features.html')}>{copy.common.allCapabilities}</a>
      </div>
      <div class="values">
        {copy.values.cards.map((card, i) => (
          <ValueCard card={card} lang={lang} index={i} />
        ))}
      </div>
    </div>
  </section>

  <!-- Your boundaries -->
  <section class="section section--paper2 trust-sec" data-section-name={copy.trust.label}>
    <div class="container trust-grid">
      <div class="trust-copy">
        <SectionHead class="reveal" label={copy.trust.label} h2a={copy.trust.h2a} h2b={copy.trust.h2b} lede={copy.trust.lede} node />
        <ul class="trust-list">
          {copy.trust.items.map((item, i) => (
            <li class="reveal" style={`--i:${i}`}>
              <span class="trust-ic"><Icon name={item.icon} size={20} /></span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.desc}</p>
              </div>
            </li>
          ))}
        </ul>
        <a class="tlink reveal" href={p('/privacy.html')}>{copy.trust.link}</a>
      </div>
      <div class="trust-visual reveal" style="--i:2">
        <PermissionPanel lang={lang} />
      </div>
    </div>
  </section>

  <!-- Meet Fea: the night band is her side of the screen -->
  <section class="section band-night fea-sec" data-section-name={copy.fea.label}>
    <div class="container fea-grid">
      <div class="fea-photo reveal">
        <Polaroid src="/assets/fea-hero-illustration.webp" alt={copy.fea.alt} caption={copy.fea.caption} rotate={-3} />
        <MarginNote class="fea-note" text={copy.mnote.fea} />
      </div>
      <div class="fea-copy">
        <SectionHead class="reveal" label={copy.fea.label} h2a={copy.fea.h2a} h2b={copy.fea.h2b} node />
        <p class="fea-body reveal">{copy.fea.body}</p>
        <ul class="fea-principles">
          {copy.fea.principles.map((item, i) => (
            <li class="reveal" style={`--i:${i + 1}`}>
              <span class="latin">{item.title}</span>
              <span>{item.desc}</span>
            </li>
          ))}
        </ul>
        <a class="tlink reveal" href={p('/about.html')}>{copy.fea.link}</a>
      </div>
    </div>
  </section>

  <!-- Join -->
  <section class="section join-sec" id="join" data-section-name={copy.waitlist.label}>
    <div class="container">
      <div class="reveal">
        <WaitlistLetter lang={lang} id="home-letter" node />
      </div>
      {status !== 'public-beta' && (
        <p class="join-alt reveal">
          <span>{copy.join.lead}</span>
          <a class="tlink" href={p('/download.html')}>{copy.join.link}</a>
        </p>
      )}
      <span class="thread-end" data-thread-end aria-hidden="true"></span>
    </div>
  </section>
</div>

<script>
  import '../../scripts/thread';
  import '../../scripts/loop';
</script>

<style>
  .home {
    position: relative;
  }

  /* ── the thread ───────────────────────────────────── */
  .thread {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    overflow: visible;
    display: none;
  }
  .thread:global(.is-on) {
    display: block;
  }
  .thread-path {
    fill: none;
    stroke: url(#thread-ink);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-opacity: 0.5;
  }
  .thread :global(.thread-bead) {
    stroke: var(--ink);
    stroke-opacity: 0.5;
    stroke-width: 1.4;
    transition: fill var(--t-mid) var(--ease), stroke var(--t-mid) var(--ease), stroke-opacity var(--t-mid);
  }
  .thread :global(.thread-bead.on-dark) {
    stroke: var(--night-text);
  }
  .thread :global(.thread-bead.lit) {
    fill: var(--lime) !important;
    stroke: var(--lime-deep);
    stroke-opacity: 1;
  }
  .thread-tip {
    fill: var(--lime);
    stroke: var(--lime-deep);
    stroke-width: 1;
    opacity: 0;
    filter: drop-shadow(0 0 5px rgba(200, 241, 105, 0.9));
    transition: opacity var(--t-fast);
  }

  /* ── hero ─────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: clamp(720px, 100svh, 960px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero-media :global(picture),
  .hero-media :global(img) {
    width: 100%;
    height: 100%;
  }
  .hero-media :global(img) {
    object-fit: cover;
    object-position: 72% 50%;
    transition: filter 1.2s var(--ease);
  }
  .hero-tint,
  .hero-shafts,
  .hero-lamp,
  .hero-fade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: opacity 1.2s var(--ease), background 1.2s var(--ease);
  }
  .hero-shafts {
    background: repeating-linear-gradient(118deg, rgba(255, 250, 235, 0) 0 70px, rgba(255, 250, 235, 0.22) 70px 120px, rgba(255, 250, 235, 0) 120px 210px);
    filter: blur(18px);
    mix-blend-mode: soft-light;
    animation: drift 26s linear infinite alternate;
  }
  @keyframes drift {
    from { transform: translateX(-3%); }
    to { transform: translateX(3%); }
  }
  .hero-fade {
    background:
      linear-gradient(90deg, var(--paper) 0%, color-mix(in srgb, var(--paper) 94%, transparent) 30%, color-mix(in srgb, var(--paper) 62%, transparent) 48%, transparent 66%),
      linear-gradient(0deg, var(--paper) 0%, transparent 20%);
  }
  .hero-lamp {
    opacity: 0;
    background: radial-gradient(circle at 76.5% 73%, rgba(255, 196, 120, 0.55), rgba(255, 170, 90, 0.12) 14%, transparent 30%);
  }
  html[data-daypart="dawn"] .hero-media :global(img) {
    filter: saturate(0.92) brightness(1.03) hue-rotate(-4deg);
  }
  html[data-daypart="dawn"] .hero-tint {
    background: linear-gradient(110deg, rgba(255, 206, 160, 0.38), transparent 62%);
  }
  html[data-daypart="dusk"] .hero-media :global(img) {
    filter: saturate(1.12) sepia(0.18) brightness(0.9);
  }
  html[data-daypart="dusk"] .hero-tint {
    background: linear-gradient(200deg, rgba(236, 140, 80, 0.34), rgba(120, 60, 90, 0.12) 70%);
  }
  html[data-daypart="night"] .hero-media :global(img) {
    filter: brightness(0.34) saturate(0.6) hue-rotate(-12deg);
  }
  html[data-daypart="night"] .hero-shafts {
    opacity: 0;
  }
  html[data-daypart="night"] .hero-lamp {
    opacity: 1;
  }
  html[data-daypart="night"] .hero-fade {
    background:
      linear-gradient(90deg, var(--paper) 0%, color-mix(in srgb, var(--paper) 92%, transparent) 30%, color-mix(in srgb, var(--paper) 50%, transparent) 50%, transparent 68%),
      linear-gradient(0deg, var(--paper) 0%, transparent 22%);
  }

  .hero-inner {
    width: 100%;
    min-height: inherit;
    display: flex;
    align-items: center;
    padding-top: var(--nav-h);
  }
  .hero-copy {
    position: relative;
    z-index: 3;
    max-width: 700px;
  }
  /* Entrance runs on CSS alone, so the first screen never waits for scripts. */
  .hero-pill,
  .hero h1,
  .hero-lede,
  .hero-actions,
  .hero-meta,
  .hero-side {
    animation: heroIn 1s var(--ease) both;
  }
  .hero h1 { animation-delay: 0.08s; }
  .hero-lede { animation-delay: 0.5s; }
  .hero-actions { animation-delay: 0.62s; }
  .hero-meta { animation-delay: 0.74s; }
  .hero-side { animation-delay: 0.9s; }
  @keyframes heroIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }
  .hero-pill {
    display: inline-block;
  }
  .hero h1 {
    margin: 22px 0 14px;
    font-size: var(--fs-display);
  }
  html[lang="en"] .hero h1 {
    font-size: clamp(2.75rem, 1.3rem + 3.4vw, 4.75rem);
    line-height: 1;
    max-width: 760px;
  }
  .hero h1 .ln {
    display: block;
    white-space: nowrap;
  }
  html[lang="en"] .hero h1 .ln {
    white-space: normal;
  }
  .live-word {
    position: relative;
    display: inline-block;
  }
  .live-word svg {
    position: absolute;
    left: -4%;
    bottom: -0.16em;
    width: 108%;
    height: 0.4em;
    overflow: visible;
  }
  .live-word path {
    fill: none;
    stroke: var(--lime-deep);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 240;
    stroke-dashoffset: 240;
    animation: draw 1.2s 0.7s var(--ease) forwards;
  }
  html[data-daypart="night"] .live-word path {
    stroke: var(--lime);
  }
  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }
  .verbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.42em;
    font-family: var(--f-latin-display);
    font-style: italic;
    font-size: clamp(1.4rem, 1.05rem + 1vw, 2rem);
    color: var(--ink-2);
    line-height: 1.25;
    margin-bottom: 22px;
  }
  .verbs span {
    opacity: 0;
    transform: translateY(6px);
    animation: rise 0.7s var(--ease) forwards;
    animation-delay: calc(0.32s + var(--v) * 0.13s);
  }
  @keyframes rise {
    to { opacity: 1; transform: none; }
  }
  .hero-lede {
    max-width: 31em;
    margin-bottom: 32px;
    text-wrap: balance;
  }
  html[lang="en"] .hero-lede {
    max-width: 33em;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 14px;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 30px;
    font-size: 13px;
    color: var(--ink-3);
  }
  .hero-meta span:not(.muted) {
    color: var(--ink-2);
    font-weight: 600;
  }
  .hero-side {
    position: absolute;
    right: var(--gutter);
    top: calc(50% + 10px);
    width: 340px;
    z-index: 3;
  }
  .hero-side :global(.hero-note) {
    right: 196px;
    bottom: calc(100% + 30px);
    width: max-content;
    max-width: 236px;
  }
  @media (max-width: 1180px) {
    .hero-copy {
      max-width: 600px;
    }
  }
  @media (max-width: 1120px) {
    .hero {
      min-height: 0;
      padding: 128px 0 72px;
    }
    .hero-inner {
      flex-direction: column;
      align-items: flex-start;
      padding-top: 0;
    }
    .hero h1 {
      font-size: clamp(2.25rem, 8.6vw, 3.5rem);
    }
    .hero-side {
      position: relative;
      inset: auto;
      margin: 48px 0 0;
      width: 100%;
      max-width: 380px;
    }
    .hero-side :global(.hero-note) {
      display: none;
    }
    .hero-media :global(img) {
      object-position: 80% 50%;
    }
    .hero-fade {
      background: linear-gradient(180deg, color-mix(in srgb, var(--paper) 20%, transparent) 0%, color-mix(in srgb, var(--paper) 86%, transparent) 38%, var(--paper) 70%);
    }
    html[data-daypart="night"] .hero-fade {
      background: linear-gradient(180deg, color-mix(in srgb, var(--paper) 30%, transparent) 0%, color-mix(in srgb, var(--paper) 90%, transparent) 38%, var(--paper) 70%);
    }
  }
  @media (max-width: 520px) {
    .hero-actions :global(.btn) {
      flex: 1 1 100%;
    }
  }

  /* ── why ──────────────────────────────────────────── */
  .fractures {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 2.6vw, 34px);
    margin-top: 18px;
  }
  .stitch {
    margin-top: clamp(56px, 7vw, 88px);
    font-family: var(--f-zh-display);
    font-weight: 700;
    font-size: clamp(1.35rem, 1rem + 1.1vw, 2rem);
    line-height: 1.6;
    max-width: 980px;
    text-wrap: balance;
  }
  :lang(zh) .stitch {
    word-break: keep-all;
    overflow-wrap: break-word;
  }
  html[lang="en"] .stitch {
    font-family: var(--f-latin-display);
    font-weight: 400;
    font-size: clamp(1.6rem, 1.1rem + 1.4vw, 2.5rem);
    line-height: 1.3;
  }
  .stitch mark {
    background: linear-gradient(transparent 62%, rgba(200, 241, 105, 0.7) 62%) no-repeat left center;
    background-size: 0% 100%;
    color: inherit;
    padding: 0 0.08em;
    transition: background-size 0.6s var(--ease) calc(var(--i) * 0.2s + 0.3s);
  }
  html[data-daypart="night"] .stitch mark {
    background-image: linear-gradient(transparent 62%, rgba(200, 241, 105, 0.32) 62%);
  }
  .stitch:global(.in) mark,
  :global(html.reveal-all) .stitch mark {
    background-size: 100% 100%;
  }
  @media (max-width: 900px) {
    .fractures {
      grid-template-columns: 1fr;
      max-width: 560px;
    }
  }

  /* ── loop ─────────────────────────────────────────── */
  .loop-sec {
    overflow: clip;
  }
  @media (min-width: 1024px) {
    :global(html.js) .loop-sec {
      min-height: 100svh;
      display: flex;
      align-items: center;
      padding: calc(var(--nav-h) + 24px) 0 40px;
    }
    :global(html.js) .loop-sec > .container {
      width: 100%;
    }
  }
  .loop-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(36px, 5vw, 80px);
    align-items: center;
  }
  .stage-col {
    min-width: 0;
  }
  .loop-copy :global(.sec-head) {
    margin-bottom: 24px;
  }
  .loop-copy :global(.sec-head .lede) {
    font-size: 1.0625rem;
  }
  .steps {
    border-top: 1px solid var(--line);
  }
  .steps li {
    border-bottom: 1px solid var(--line);
  }
  .steps button {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 2px 12px;
    width: 100%;
    text-align: left;
    padding: 13px 0;
    color: var(--ink-3);
    transition: color var(--t-fast);
  }
  .steps button:hover {
    color: var(--ink-2);
  }
  .steps .t {
    grid-row: 1 / 3;
    font-size: 11.5px;
    letter-spacing: 0.04em;
    padding-top: 5px;
  }
  .steps .h {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .steps .no {
    font-size: 11px;
  }
  .steps .name {
    font-family: var(--f-zh-display);
    font-weight: 700;
    font-size: 19px;
  }
  html[lang="en"] .steps .name {
    font-family: var(--f-latin-display);
    font-weight: 400;
    font-size: 23px;
  }
  .steps .en {
    font-size: 14px;
    opacity: 0.85;
  }
  .steps .d {
    grid-column: 2;
    font-size: 14.5px;
    line-height: 1.65;
  }
  :global(html.js) .loop-sec:global(.js-loop) .steps .d {
    max-height: 0;
    overflow: hidden;
    transition: max-height var(--t-mid) var(--ease), margin var(--t-mid);
  }
  :global(html.js) .loop-sec:global(.js-loop) .steps li.on .d {
    max-height: 120px;
    margin-top: 4px;
  }
  .steps li.on button {
    color: var(--ink);
  }
  .loop-closing {
