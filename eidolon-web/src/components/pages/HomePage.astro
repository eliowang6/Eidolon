---
import { Picture } from 'astro:assets';
import heroImage from '../../assets/hero/focus-cabin-2560.png';
import StatusPill from '../StatusPill.astro';
import Button from '../Button.astro';
import MarginNote from '../MarginNote.astro';
import PresenceCard from '../PresenceCard.astro';
import SectionHead from '../SectionHead.astro';
import TornCard from '../TornCard.astro';
import LoopStage from '../LoopStage.astro';
import ValueCard from '../ValueCard.astro';
import CompareTable from '../CompareTable.astro';
import MetricCard from '../MetricCard.astro';
import MemoryLayers from '../MemoryLayers.astro';
import Polaroid from '../Polaroid.astro';
import Timeline from '../Timeline.astro';
import WaitlistLetter from '../WaitlistLetter.astro';
import { SITE } from '../../config/site';
import { localizePath, t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const p = (href: string) => localizePath(lang, href);
const status = SITE.status;
const statusCopy = copy.statusCopy[status];
const sectionNames = lang === 'zh'
  ? { hero: '开始', why: '为什么', loop: '她的一天', values: '三种价值', compare: '不同之处', foundation: '底座', who: '为谁而做', road: '公测之路', waitlist: '候补' }
  : { hero: 'Start', why: 'Why', loop: 'A day with her', values: 'Three values', compare: "What's different", foundation: 'Foundation', who: "Who it's for", road: 'Road to beta', waitlist: 'Waitlist' };
const joinHref = status === 'public-beta' ? p('/download.html') : `${p('/beta.html')}#join`;
const tertiaryHref = statusCopy.kind === 'download' ? p('/download.html') : statusCopy.kind === 'community' ? `${p('/beta.html')}#community` : p('/download.html');
const stitch = copy.why.stitch;
---
<div class="home" data-thread-home>
  <svg class="thread" data-thread aria-hidden="true" preserveAspectRatio="none">
    <defs>
      <linearGradient id="thread-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--ink)" />
        <stop offset="0.9" stop-color="var(--ink)" />
        <stop offset="1" stop-color="var(--lime)" />
      </linearGradient>
    </defs>
    <path d=""></path>
  </svg>

  <!-- H1 · Hero -->
  <section class="hero" data-section-name={sectionNames.hero}>
    <div class="hero-media">
      <Picture
        src={heroImage}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[960, 1440, 1920, 2560]}
        sizes="100vw"
        alt=""
        class="hero-img"
        loading="eager"
        fetchpriority="high"
        quality={72}
      />
      <div class="hero-tint"></div>
      <div class="hero-shafts"></div>
      <div class="hero-lamp"></div>
      <div class="hero-fade"></div>
    </div>

    <div class="container hero-inner">
      <div class="hero-copy">
        <StatusPill text={statusCopy.pill} class="hero-pill reveal" />
        <h1 class="reveal" style="--i:1">
          <span class="ln">{copy.hero.line1}</span>
          <span class="ln">{copy.hero.line2Pre}<span class="live-word" data-thread-anchor="hero-word">{copy.hero.line2Word}<svg viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true"><path d="M2 12C20 4 40 18 60 9s30-3 38 2" /></svg></span>{copy.hero.line2Post}</span>
        </h1>
        <p class="verbs" aria-label={copy.hero.verbs.join(' ')}>
          {copy.hero.verbs.map((verb, i) => <span style={`--v:${i}`}>{verb}</span>)}
        </p>
        <p class="lede reveal" style="--i:2">{copy.hero.lede}</p>
        <div class="hero-actions reveal" style="--i:3">
          <Button href={joinHref} variant="ink">{statusCopy.primary}</Button>
          <Button href="#loop" variant="ghost">{copy.hero.secondary}</Button>
          <a class="btn-text" href={tertiaryHref}>{statusCopy.tertiary}</a>
        </div>
        <div class="hero-meta reveal" style="--i:4">
          {copy.hero.platforms.map((platform, i) => (
            <span class={i === copy.hero.platforms.length - 1 ? 'muted' : ''}>{platform}</span>
          ))}
        </div>
      </div>

      <MarginNote
        class="hero-note"
        text={copy.mnote.heroFirst}
        variant="scrap"
        arrow
        heroNote={{ first: copy.mnote.heroFirst, section: copy.mnote.heroBackSection, days: copy.mnote.heroBackDays }}
      />
      <div class="hero-side" data-thread-anchor="presence">
        <PresenceCard lang={lang} />
      </div>
    </div>
  </section>

  <!-- H2 · Why -->
  <section class="section section--paper2 why" data-section-name={sectionNames.why}>
    <div class="container">
      <SectionHead
        class="reveal"
        label={copy.why.label}
        h2a={copy.why.h2a}
        h2b={copy.why.h2b}
      />
      <div class="fractures reveal">
        {copy.why.cards.map((card) => (
          <TornCard no={card.no} title={card.title} desc={card.desc} anchor={`torn-${card.no}`} />
        ))}
        <MarginNote class="why-note" text={copy.mnote.why} />
      </div>
      <p class="stitch reveal">
        {stitch.pre}
        {stitch.marks.map((mark, i) => (
          <>
            <mark style={`--i:${i}`}>{mark}</mark>
            {stitch.mid[i] && <span>{stitch.mid[i]}</span>}
          </>
        ))}
        {stitch.post}
      </p>
    </div>
  </section>

  <!-- H3 · The loop -->
  <section class="section loop-sec" id="loop" data-loop-section data-section-name={sectionNames.loop}>
    <div class="container">
      <div class="loop-top reveal">
        <div class="in-pill">
          <span class="label">{copy.loop.inputOuterTitle}</span>
          <span>{copy.loop.inputOuterText}</span>
        </div>
        <svg class="merge" viewBox="0 0 1200 64" preserveAspectRatio="none" aria-hidden="true">
          <path d="M170 4C210 40 250 54 310 58" />
          <path d="M1030 4C990 40 950 54 890 58" />
          <path d="M310 58H890" opacity="0" />
        </svg>
        <div class="in-pill in-pill--right">
          <span class="label">{copy.loop.inputInnerTitle}</span>
          <span>{copy.loop.inputInnerText}</span>
        </div>
      </div>

      <div class="loop-grid loop-desktop">
        <div class="stage-col">
          <LoopStage steps={copy.loop.steps} lang={lang} active={0} anchor="loop" />
        </div>
        <div class="loop-copy">
          <SectionHead class="reveal" label={copy.loop.label} h2a={copy.loop.h2a} h2b={copy.loop.h2b} lede={copy.loop.lede} />
          <ol class="steps" data-loop-steps>
            {copy.loop.steps.map((step, i) => (
              <li class={i === 0 ? 'on' : ''} data-loop-step={i}>
                <button type="button" aria-current={i === 0 ? 'step' : 'false'}>
                  <span class="t mono">{step.time}</span>
                  <span class="h">
                    <span class="no mono">0{i + 1}</span>
                    <span class="name">{step.name}</span>
                    <span class="en latin">{step.en}</span>
                  </span>
                  <span class="d">{step.desc}</span>
                </button>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="loop-mobile">
        <SectionHead class="reveal" label={copy.loop.label} h2a={copy.loop.h2a} h2b={copy.loop.h2b} lede={copy.loop.lede} />
        <div class="loop-mobile-list">
          {copy.loop.steps.map((step, i) => (
            <div class="loop-mobile-step" data-loop-mobile-step={i}>
              <div class="lm-head">
                <span class="mono">{step.time}</span>
                <h3>{step.name}</h3>
                <span class="latin">{step.en}</span>
              </div>
              <p>{step.desc}</p>
              <LoopStage steps={copy.loop.steps} lang={lang} active={i} single compact />
            </div>
          ))}
        </div>
      </div>

      <p class="loop-closing reveal">{copy.loop.closing}</p>
    </div>
  </section>

  <!-- H4 · Values -->
  <section class="section values-sec" data-section-name={sectionNames.values}>
    <div class="container">
      <div class="values-head">
        <SectionHead class="reveal" label={copy.values.label} h2a={copy.values.h2} />
        <a class="tlink" href={p('/features.html')}>{copy.common.allCapabilities}</a>
        <MarginNote class="values-note" text={copy.mnote.values} />
      </div>
      <div class="values">
        {copy.values.cards.map((card, i) => (
          <ValueCard card={card} lang={lang} index={i} anchor={`value-${i + 1}`} />
        ))}
      </div>
      <p class="foundation reveal">
        <b>{copy.values.foundationLabel}</b>
        <span>{copy.values.foundation}</span>
      </p>
    </div>
  </section>

  <!-- H5 · Compare -->
  <section class="section section--paper2 compare-sec" data-section-name={sectionNames.compare}>
    <div class="container">
      <div class="compare-grid">
        <div class="compare-left">
          <SectionHead class="reveal" label={copy.compare.label} h2a={copy.compare.h2a} h2b={copy.compare.h2b} />
          <div class="insight reveal">{copy.compare.insight}</div>
        </div>
        <div class="compare-right reveal">
          <CompareTable lang={lang} anchor="compare" />
        </div>
      </div>
      <p class="big-quote reveal">{copy.compare.quote}</p>
    </div>
  </section>

  <!-- H6 · Foundation -->
  <section class="section band-night foundation-sec" data-section-name={sectionNames.foundation}>
    <div class="container">
      <SectionHead class="reveal" label={copy.foundation.label} h2a={copy.foundation.h2a} h2b={copy.foundation.h2b} lede={copy.foundation.lede} />
      <div class="metrics reveal">
        <MetricCard
          value="−25%"
          captionA={copy.foundation.metrics[0].captionA}
          captionB={copy.foundation.metrics[0].captionB}
          to="25"
          prefix="−"
          suffix="%"
          index={0}
        />
        <MetricCard
          value="90–97%"
          captionA={copy.foundation.metrics[1].captionA}
          captionB={copy.foundation.metrics[1].captionB}
          to="90"
          rangeTo="97"
          suffix="%"
          index={1}
        />
        <div class="layers-card reveal" style="--i:2" data-thread-anchor="layers">
          <MemoryLayers title={copy.foundation.layersTitle} desc={copy.foundation.layersDesc} />
          <MarginNote class="layers-note" text={copy.mnote.foundation} />
        </div>
      </div>
      <div class="pillars reveal">
        {copy.foundation.pillars.map((pillar) => (
          <div class="pillar">
            <span class="label">{pillar.key}</span>
            <h3>{pillar.title}</h3>
            <p>{pillar.desc}</p>
          </div>
        ))}
      </div>
      <div class="foundation-foot reveal">
        <p class="footnote">{copy.foundation.footnote}</p>
        <a class="tlink" href={p('/how-it-works.html')}>{copy.common.howItWorks}</a>
      </div>
    </div>
  </section>

  <!-- H7 · Who -->
  <section class="section who-sec" data-section-name={sectionNames.who}>
    <div class="container who-grid">
      <div class="who-photo reveal">
        <Polaroid src="/assets/fea-hero-illustration.webp" alt={copy.aboutPage.feaName} caption={copy.who.feaCaption} />
      </div>
      <div class="who-copy">
        <SectionHead class="reveal" label={copy.who.label} h2a={copy.who.h2} />
        <ul class="who-rows">
          {copy.who.rows.map((row) => (
            <li>
              <span class="no mono">{row.no}</span>
              <div><h3>{row.title}</h3><p>{row.desc}</p></div>
            </li>
          ))}
        </ul>
        <p class="who-fea reveal">{copy.who.feaIntro}</p>
        <a class="tlink reveal" href={p('/about.html')}>{copy.who.feaLink}</a>
      </div>
    </div>
  </section>

  <!-- H8 · Road -->
  <section class="section road-sec" data-section-name={sectionNames.road}>
    <div class="container">
      <div class="road-head reveal">
        <SectionHead class="reveal" label={copy.road.label} h2a={copy.road.h2} />
        <a class="tlink" href={`${p('/beta.html')}#roadmap`}>{copy.road.link}</a>
      </div>
      <div class="reveal">
        <Timeline nodes={copy.road.nodes} anchor="road" />
      </div>
    </div>
  </section>

  <!-- H9 · Waitlist -->
  <section class="section section--paper2 waitlist-sec" id="join" data-section-name={sectionNames.waitlist}>
    <div class="container">
      <WaitlistLetter lang={lang} id="join" anchor="stamp" />
      <span class="thread-end" data-thread-anchor="end" aria-hidden="true"></span>
    </div>
  </section>
</div>

<script>
  import '../../scripts/thread';
  import '../../scripts/loop';
</script>

<style>
  .home {
    position: relative;
  }
  .thread {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    overflow: visible;
  }
  .thread path {
    fill: none;
    stroke: url(#thread-grad);
    stroke-opacity: 0.55;
    stroke-width: 1.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  html[data-daypart="night"] .thread path {
    stroke-opacity: 0.6;
  }

  /* ── hero ─────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: clamp(760px, 100svh, 980px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero-media :global(picture),
  .hero-media :global(img) {
    width: 100%;
    height: 100%;
  }
  .hero-media :global(img) {
    object-fit: cover;
    object-position: 72% 50%;
    transition: filter 1.2s var(--ease);
  }
  .hero-tint,
  .hero-shafts,
  .hero-lamp,
  .hero-fade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: opacity 1.2s var(--ease), background 1.2s var(--ease);
  }
  .hero-shafts {
    background: repeating-linear-gradient(118deg, rgba(255, 250, 235, 0) 0 70px, rgba(255, 250, 235, 0.22) 70px 120px, rgba(255, 250, 235, 0) 120px 210px);
    filter: blur(18px);
    mix-blend-mode: soft-light;
    animation: drift 26s linear infinite alternate;
  }
  @keyframes drift {
    from { transform: translateX(-3%); }
    to { transform: translateX(3%); }
  }
  .hero-fade {
    background:
      linear-gradient(90deg, var(--paper) 0%, color-mix(in srgb, var(--paper) 94%, transparent) 28%, color-mix(in srgb, var(--paper) 60%, transparent) 46%, transparent 64%),
      linear-gradient(0deg, var(--paper) 0%, transparent 22%);
  }
  .hero-lamp {
    opacity: 0;
    background: radial-gradient(circle at 76.5% 73%, rgba(255, 196, 120, 0.55), rgba(255, 170, 90, 0.12) 14%, transparent 30%);
  }
  html[data-daypart="dawn"] .hero-media :global(img) {
    filter: saturate(0.92) brightness(1.03) hue-rotate(-4deg);
  }
  html[data-daypart="dawn"] .hero-tint {
    background: linear-gradient(110deg, rgba(255, 206, 160, 0.38), transparent 62%);
  }
  html[data-daypart="dusk"] .hero-media :global(img) {
    filter: saturate(1.12) sepia(0.18) brightness(0.9);
  }
  html[data-daypart="dusk"] .hero-tint {
    background: linear-gradient(200deg, rgba(236, 140, 80, 0.34), rgba(120, 60, 90, 0.12) 70%);
  }
  html[data-daypart="night"] .hero-media :global(img) {
    filter: brightness(0.34) saturate(0.6) hue-rotate(-12deg);
  }
  html[data-daypart="night"] .hero-shafts {
    opacity: 0;
  }
  html[data-daypart="night"] .hero-lamp {
    opacity: 1;
  }
  html[data-daypart="night"] .hero-fade {
    background:
      linear-gradient(90deg, var(--paper) 0%, color-mix(in srgb, var(--paper) 92%, transparent) 30%, color-mix(in srgb, var(--paper) 50%, transparent) 50%, transparent 68%),
      linear-gradient(0deg, var(--paper) 0%, transparent 24%);
  }

  .hero-inner {
    min-height: clamp(760px, 100svh, 980px);
    display: flex;
    align-items: center;
    padding-top: 72px;
  }
  .hero-copy {
    position: relative;
    z-index: 3;
    max-width: min(720px, 100%);
  }
  .hero h1 {
    margin: 22px 0 16px;
    font-size: var(--fs-display);
  }
  html[lang="en"] .hero h1 {
    font-size: clamp(2.5rem, 1.2rem + 3vw, 4.25rem);
    line-height: 1.02;
    max-width: 760px;
  }
  .hero h1 .ln {
    display: block;
    white-space: nowrap;
  }
  html[lang="en"] .hero h1 .ln {
    white-space: normal;
    text-wrap: balance;
  }
  .live-word {
    position: relative;
    display: inline-block;
  }
  .live-word svg {
    position: absolute;
    left: -4%;
    bottom: -0.18em;
    width: 108%;
    height: 0.42em;
    overflow: visible;
  }
  .live-word path {
    fill: none;
    stroke: var(--lime-deep);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 240;
    stroke-dashoffset: 240;
    animation: draw 1.2s 0.6s var(--ease) forwards;
  }
  html[data-daypart="night"] .live-word path {
    stroke: var(--lime);
  }
  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }
  .verbs {
    font-family: var(--f-latin-display);
    font-style: italic;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    color: var(--ink-2);
    line-height: 1.25;
    margin-bottom: 20px;
  }
  .verbs span {
    display: inline-block;
    opacity: 0;
    transform: translateY(6px);
    animation: rise 0.7s var(--ease) forwards;
    animation-delay: calc(0.9s + var(--v) * 0.15s);
  }
  @keyframes rise {
    to { opacity: 1; transform: none; }
  }
  .hero .lede {
    margin-bottom: 30px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 34px;
    font-size: 13px;
    color: var(--ink-3);
  }
  .hero-meta .muted {
    color: var(--ink-3);
  }
  .hero-meta span:not(.muted) {
    color: var(--ink-2);
    font-weight: 600;
  }
  .hero-side {
    position: absolute;
    right: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    top: clamp(300px, 44vh, 440px);
    width: 340px;
    z-index: 3;
  }
  :global(.hero-note) {
    right: calc(max(var(--gutter), (100vw - var(--container)) / 2 + var(--gutter)) + 250px);
    top: clamp(190px, 30vh, 300px);
  }
  @media (max-width: 1120px) {
    .hero {
      min-height: 0;
      padding: 120px 0 64px;
    }
    .hero-inner {
      min-height: 0;
      flex-direction: column;
      align-items: flex-start;
      padding-top: 0;
    }
    .hero h1 {
      font-size: clamp(2.25rem, 9vw, 3.5rem);
    }
    .hero-side {
      position: relative;
      inset: auto;
      margin: 44px 0 0;
      width: 100%;
      max-width: 380px;
    }
    :global(.hero-note) {
      display: none;
    }
    .hero-media :global(img) {
      object-position: 80% 50%;
    }
    .hero-fade {
      background:
        linear-gradient(180deg, color-mix(in srgb, var(--paper) 20%, transparent) 0%, color-mix(in srgb, var(--paper) 86%, transparent) 38%, var(--paper) 70%);
    }
    html[data-daypart="night"] .hero-fade {
      background:
        linear-gradient(180deg, color-mix(in srgb, var(--paper) 30%, transparent) 0%, color-mix(in srgb, var(--paper) 90%, transparent) 38%, var(--paper) 70%);
    }
  }

  /* ── why ──────────────────────────────────────────── */
  .why {
    padding-top: clamp(96px, 12vw, 150px);
  }
  .fractures {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
    margin-top: 26px;
    position: relative;
  }
    :global(.why-note) {
    right: -10px;
    top: -54px;
  }
  .stitch {
    margin-top: clamp(48px, 6vw, 72px);
    font-family: var(--f-zh-display);
    font-weight: 700;
    font-size: clamp(1.3rem, 1rem + 1vw, 1.9rem);
    line-height: 1.6;
    max-width: 940px;
  }
  html[lang="en"] .stitch {
    font-family: var(--f-latin-display);
    font-weight: 400;
    line-height: 1.35;
  }
  .stitch mark {
    background: linear-gradient(transparent 62%, rgba(200, 241, 105, 0.7) 62%) no-repeat left center;
    background-size: 0% 100%;
    color: inherit;
    padding: 0 0.08em;
    transition: background-size 0.6s var(--ease) calc(var(--i) * 0.2s + 0.2s);
  }
  .stitch.in mark {
    background-size: 100% 100%;
  }
  @media (max-width: 1023px) {
    .fractures {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .fractures {
      grid-template-columns: 1fr;
      gap: 26px;
    }
  }

  /* ── loop ─────────────────────────────────────────── */
  .loop-sec {
    overflow: clip;
  }
  @media (min-width: 1024px) {
    html.js .loop-sec {
      min-height: 100svh;
      display: flex;
      align-items: flex-start;
      padding-top: 110px;
      padding-bottom: 60px;
    }
    html.js .loop-sec > .container {
      width: 100%;
    }
  }
  .loop-top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
    margin-bottom: 34px;
    position: relative;
  }
  .in-pill {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 16px;
    border-radius: var(--r-full);
    background: var(--sage-wash);
    border: 1px solid transparent;
    max-width: 430px;
  }
  .in-pill--right {
    justify-self: end;
    text-align: right;
  }
  .in-pill .label {
    color: var(--sage-deep);
    font-size: 10px;
  }
  .in-pill > span:last-child {
    font-size: 12.5px;
    color: var(--ink-2);
    line-height: 1.5;
  }
  .merge {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: 8px;
    width: min(56%, 620px);
