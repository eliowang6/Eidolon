---
import PageHero from '../PageHero.astro';
import WindowFrame from '../WindowFrame.astro';
import PhoneFrame from '../PhoneFrame.astro';
import Icon from '../Icon.astro';
import { SITE } from '../../config/site';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const page = copy.downloadPage;
const platforms = [
  { key: 'windows', data: page.windows, href: SITE.downloads.windows, icon: 'monitor' },
  { key: 'android', data: page.android, href: SITE.downloads.android, icon: 'smartphone' },
] as const;
const help = [
  { title: page.helpQuick, desc: page.helpQuickDesc, href: SITE.docs.quickStart, icon: 'book' },
  { title: page.helpFaq, desc: page.helpFaqDesc, href: SITE.docs.faq, icon: 'help' },
];
---

<PageHero label={page.label} h1a={page.h1} lede={page.lede}>
  {SITE.status !== 'public-beta' && <p class="hand preview-note reveal" style="--i:3">{page.previewNote}</p>}
</PageHero>

<section class="section platforms-sec">
  <div class="container">
    <div class="platforms">
      {platforms.map((platform, i) => (
        <article class="platform reveal" style={`--i:${i}`}>
          <div class="platform-media">
            {platform.key === 'windows' ? (
              <WindowFrame title="Focus Cabin">
                <img src="/assets/screenshots/app-focus-cabin.webp" alt="" width="1440" height="1100" loading="lazy" />
              </WindowFrame>
            ) : (
              <PhoneFrame cropTop>
                <img src="/assets/screenshots/app-mobile-home.webp" alt="" width="390" height="844" loading="lazy" />
              </PhoneFrame>
            )}
          </div>
          <div class="platform-body">
            <span class="platform-icon"><Icon name={platform.icon} size={20} /></span>
            <h2>{platform.data.title}</h2>
            <span class="platform-req mono">{platform.data.req}</span>
            <p>{platform.data.desc}</p>
            <a class="btn btn-ink platform-btn" href={platform.href}>
              <span class="dot" aria-hidden="true"></span>
              <span>{platform.data.cta}</span>
            </a>
            <span class="platform-note">{platform.data.note}</span>
          </div>
        </article>
      ))}
    </div>

    <div class="unsupported reveal">
      <span class="label">{page.unsupported}</span>
      <div class="unsupported-pills">
        {page.unsupportedList.map((item) => <span class="u-pill">{item}</span>)}
      </div>
    </div>
  </div>
</section>

<section class="section section--paper2 req-sec">
  <div class="container">
    <h2 class="req-title reveal">{page.tableTitle}</h2>
    <div class="req-table reveal" role="table" aria-label={page.tableTitle}>
      <div class="req-row req-row--head" role="row">
        {page.tableHead.map((head) => <span role="columnheader">{head}</span>)}
      </div>
      {page.tableRows.map((row) => (
        <div class="req-row" role="row">
          <span class="req-platform" role="cell">{row.platform}</span>
          <span role="cell"><span class="m-label">{page.tableHead[1]}</span>{row.min}</span>
          <span role="cell"><span class="m-label">{page.tableHead[2]}</span>{row.rec}</span>
          <span role="cell" class="req-feat"><span class="m-label">{page.tableHead[3]}</span>{row.feat}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section help-sec">
  <div class="container">
    <h2 class="help-title reveal">{page.helpTitle}</h2>
    <div class="help-grid">
      {help.map((item, i) => (
        <a class="help-card reveal" style={`--i:${i}`} href={item.href} target="_blank" rel="noopener noreferrer">
          <span class="help-icon"><Icon name={item.icon} size={20} /></span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
          <span class="help-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .preview-note {
    margin-top: 20px;
    font-size: 19px;
    line-height: 1.5;
    max-width: 520px;
    text-wrap: pretty;
  }

  .platforms-sec {
    padding-top: 0;
  }
  .platforms {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(18px, 3vw, 28px);
  }
  .platform {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--card);
    overflow: hidden;
  }
  .platform-media {
    height: 300px;
    padding: 26px 26px 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow: hidden;
    background:
      radial-gradient(90% 80% at 70% 0%, var(--sage-wash), transparent 70%),
      linear-gradient(160deg, var(--paper-2), var(--card));
    border-bottom: 1px solid var(--line);
  }
  .platform-media :global(.wf) {
    width: 100%;
    max-width: 480px;
  }
  .platform-media :global(.pf) {
    width: 208px;
    flex: none;
    margin-top: 4px;
  }
  .platform-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 28px 30px 30px;
    flex: 1;
  }
  .platform-icon {
    width: 44px;
    height: 44px;
    border-radius: 13px;
    background: var(--sage-wash);
    color: var(--sage-deep);
    display: grid;
    place-items: center;
    margin-bottom: 18px;
  }
  .platform-body h2 {
    font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.7rem);
  }
  .platform-req {
    display: inline-block;
    margin: 6px 0 14px;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }
  .platform-body p {
    font-size: 14px;
    line-height: 1.75;
    color: var(--ink-2);
    max-width: 400px;
    text-wrap: pretty;
  }
  .platform-btn {
    margin-top: 24px;
  }
  .platform-note {
    margin-top: 12px;
    font-size: 11.5px;
    color: var(--ink-3);
  }

  .unsupported {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: clamp(32px, 4vw, 44px);
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  .unsupported-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .u-pill {
    border: 1px dashed var(--line-2);
    border-radius: var(--r-full);
    padding: 6px 14px;
    font-size: 12px;
    color: var(--ink-3);
  }

  .req-title {
    font-size: clamp(1.6rem, 1.2rem + 1.1vw, 2.1rem);
    margin-bottom: clamp(28px, 4vw, 40px);
  }
  .req-table {
    border-top: 1px solid var(--line-2);
  }
  .req-row {
    display: grid;
    grid-template-columns: 1.1fr 1.4fr 1.3fr 1.5fr;
    gap: 24px;
    padding: 18px 4px;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
    line-height: 1.65;
    color: var(--ink-2);
  }
  .req-row--head {
    padding: 12px 4px;
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .req-platform {
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--ink);
  }
  .req-feat {
    color: var(--ink-3);
  }
  .m-label {
    display: none;
  }

  .help-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .help-title {
    font-size: clamp(1.6rem, 1.2rem + 1.1vw, 2.1rem);
    margin-bottom: clamp(24px, 3.5vw, 36px);
  }
  .help-card {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--card);
    padding: 26px;
    transition: transform var(--t-mid) var(--ease), box-shadow var(--t-mid);
  }
  .help-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--sh-paper);
  }
  .help-icon {
    width: 42px;
    height: 42px;
    flex: none;
    border-radius: 12px;
    background: var(--sage-wash);
    color: var(--sage-deep);
    display: grid;
    place-items: center;
  }
  .help-card h3 {
    font-size: 17px;
    margin-bottom: 6px;
  }
  .help-card p {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .help-arrow {
    margin-left: auto;
    color: var(--ink-3);
  }

  @media (max-width: 1023px) {
    .platforms {
      grid-template-columns: 1fr;
    }
    .platform-media {
      height: 260px;
    }
  }
  @media (max-width: 767px) {
    .req-row {
      grid-template-columns: 1fr 1fr;
      gap: 8px 18px;
      font-size: 12px;
    }
    .req-row--head {
      display: none;
    }
    .req-platform {
      grid-column: 1 / -1;
      font-size: 12.5px;
    }
    .req-feat {
      grid-column: 1 / -1;
    }
    .m-label {
      display: block;
      font-family: var(--f-mono);
      font-size: 9px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-3);
      margin-bottom: 3px;
    }
    .help-grid {
      grid-template-columns: 1fr;
    }
    .platform-body {
      padding: 24px;
    }
  }
</style>
