---
/**
 * Download (/download.html): both installers sit inside the masthead, so the
 * button, the live version and the size are all above the fold. Then the
 * four steps after install, the requirements, and where to get help.
 * Link probing / backup-line switching lives in scripts/site.ts.
 */
import PageHero from '../PageHero.astro';
import Phone from '../Phone.astro';
import Release from '../Release.astro';
import Screen from '../Screen.astro';
import Eyebrow from '../Eyebrow.astro';
import { SITE } from '../../config/site';
import { localizeDocsPath, localizePath, pr, t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const dp = copy.downloadPage;
const p = (href: string) => localizePath(lang, href);
// Windows 没有固定安装包文件名了：先放清单端点作占位，scripts/site.ts 在页面
// 加载时把 href / 备用线路换成清单里的版本化 NSIS 地址（发版自动跟随）。
const platforms = [
  {
    key: 'windows',
    data: dp.windows,
    href: SITE.release.windows,
    fallback: '',
    manifest: SITE.release.windows,
  },
  { key: 'android', data: dp.android, href: SITE.downloads.android, fallback: SITE.downloadsFallback.android, manifest: '' },
] as const;
const help = [
  { t: dp.helpQuick, d: dp.helpQuickDesc, href: localizeDocsPath(lang, SITE.docs.quickStart), ext: true },
  { t: dp.helpFaq, d: dp.helpFaqDesc, href: localizeDocsPath(lang, SITE.docs.faq), ext: true },
  { t: dp.helpMail, d: dp.helpMailDesc, href: `mailto:${SITE.contactEmail}`, ext: false },
];
const [, ...cols] = dp.tableHead;
---

<PageHero class="dl-head" label={dp.label} h1a={dp.h1a} h1b={dp.h1b} lede={dp.lede}>
  <div class="dl-grid">
    {
      platforms.map((pf, i) => (
        <article class:list={['plat', `plat--${pf.key}`, 'reveal']} style={`--i:${i + 3}`}>
          <div class="plat-body">
            <h2 class="plat-title">{pf.data.title}</h2>
            <p class="plat-req">{pf.data.req}</p>
            <p class="plat-desc" set:html={pr(pf.data.desc)} />
            <div class="plat-cta">
              <a class="btn btn-ink btn-lg" href={pf.href} data-dl-primary data-dl-fallback={pf.fallback || undefined} data-dl-manifest={pf.manifest || undefined}>
                <svg class="dl-ico" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14" />
                </svg>
                {pf.data.cta}
              </a>
              <p class="plat-meta">
                <span class="live" aria-hidden="true" />
                <Release
                  platform={pf.key}
                  label={copy.common.releaseLabel}
                  fallback={copy.common.releaseFallback}
                  parts="version,date"
                />
                <span class="plat-file">{pf.data.file}</span>
              </p>
            </div>
            <p class="plat-note" set:html={pr(pf.data.note)} />
            <a class="plat-backup" href={pf.fallback || pf.href} data-dl-backup data-dl-manifest={pf.manifest || undefined}>
              {dp.backupLink}
            </a>
          </div>
          <div class="plat-stage" aria-hidden="true">
            {pf.key === 'windows' ? (
              <Screen shot="d-chat" pair alt="" eager class="plat-screen" sizes="(max-width: 900px) 84vw, 520px" />
            ) : (
              <Phone shot="morning" pair eager class="plat-phone" sizes="(max-width: 900px) 46vw, 230px" />
            )}
          </div>
        </article>
      ))
    }
  </div>
</PageHero>

<!-- ── the two things worth knowing before you install ── -->
<section class="section section--tight notes" aria-label={dp.label.split(' / ')[0]}>
  <div class="container notes-row">
    <p class="note-line reveal">
      <span class="note-i" aria-hidden="true">i</span>
      <span set:html={pr(dp.nameNote)} />
    </p>
    <p class="note-line reveal" style="--i:1">
      <span class="note-i" aria-hidden="true">i</span>
      <span set:html={pr(dp.unsupported)} />
    </p>
  </div>
</section>

<!-- ── after install ─────────────────────────────────── -->
<section class="section steps-sec" aria-labelledby="st-h">
  <div class="container">
    <div class="sec-head reveal">
      <Eyebrow text={dp.stepsLabel} />
      <h2 id="st-h" set:html={pr(dp.stepsTitle)} />
    </div>
    <ol class="steps" data-whisper="download">
      {
        dp.steps.map((step, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <span class="st-no" aria-hidden="true">
              {i + 1}
            </span>
            <h3 set:html={pr(step.t)} />
            <p set:html={pr(step.d)} />
            {i === 1 && (
              <span class="st-duo" aria-hidden="true">
                <img src="/assets/art/fea-avatar.webp" width="56" height="56" alt="" loading="lazy" />
                <img src="/assets/art/ael-avatar.webp" width="56" height="56" alt="" loading="lazy" />
              </span>
            )}
            {i === dp.steps.length - 1 && (
              <a class="tlink" href={p('/pricing.html')}>
                {dp.plansLink}
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- ── requirements & help ───────────────────────────── -->
<section class="section section--paper2 req-sec" aria-labelledby="rq-h">
  <div class="container req-grid">
    <div class="req-wrap reveal">
      <h2 id="rq-h" class="req-title" set:html={pr(dp.tableTitle)} />
      <table class="req">
        <thead>
          <tr>
            <td></td>
            {cols.map((c) => (
              <th scope="col">{c}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {
            dp.tableRows.map(([head, ...cells]) => (
              <tr>
                <th scope="row">{head}</th>
                {cells.map((cell) => (
                  <td class:list={[cell === '—' && 'is-none']}>{cell}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <aside class="help reveal" style="--i:1" aria-labelledby="hp-h">
      <h2 id="hp-h" class="help-title" set:html={pr(dp.helpTitle)} />
      {
        help.map((h) => (
          <a class="help-link" href={h.href} {...(h.ext ? { target: '_blank', rel: 'noopener' } : {})}>
            <span class="hl-t">{h.t}</span>
            <span class="hl-d">{h.d}</span>
            <span class="hl-arrow" aria-hidden="true">
              {h.ext ? '↗' : '→'}
            </span>
          </a>
        ))
      }
    </aside>
  </div>
</section>

<style>
  /* ── masthead with both installers ───────────────── */
  .dl-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
    margin-top: clamp(40px, 5vw, 64px);
  }
  .plat {
    container: plat / inline-size;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--r-xl);
    background:
      radial-gradient(80% 60% at 50% 100%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 75%),
      linear-gradient(170deg, rgba(52, 58, 122, 0.55), rgba(22, 26, 70, 0.7) 70%);
    border: 1px solid rgba(255, 255, 255, 0.13);
    box-shadow: 0 50px 100px -60px rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  /* the device rises out of the card's bottom edge */
  .plat-stage {
    position: relative;
    height: clamp(170px, 15vw, 210px);
    margin-top: 8px;
    overflow: hidden;
  }
  .plat-stage :global(.plat-screen) {
    position: absolute;
    left: 50%;
    top: 22px;
    width: 84%;
    translate: -50% 0;
  }
  .plat-stage :global(.plat-phone) {
    position: absolute;
    left: 50%;
    top: 18px;
    width: clamp(150px, 15vw, 200px);
    translate: -50% 0;
  }
  :global(.dl-head .ph-sky) {
    top: 24%;
    right: -26%;
  }
  .plat-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1;
    padding: clamp(26px, 3vw, 40px) clamp(24px, 3vw, 40px) 0;
  }
  .plat-title {
    font-family: var(--f-latin-display);
    font-size: clamp(2rem, 1.5rem + 1.4vw, 2.8rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .plat-req {
    margin-top: 10px;
    font-family: var(--f-mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }
  .plat-desc {
    margin: 14px 0 24px;
    max-width: 30em;
    color: var(--ink-2);
    line-height: 1.8;
  }
  .plat-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }
  .dl-ico {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .plat-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--ink-2);
  }
  .plat-file {
    color: var(--ink-3);
  }
  .plat-file::before {
    content: '·';
    margin-right: 10px;
  }
  /* Too narrow for one line: give the file its own line instead of starting one with a dot. */
  @container plat (max-width: 440px) {
    .plat-file {
      flex-basis: 100%;
      padding-left: 18px;
    }
    .plat-file::before {
      content: none;
    }
  }
  .plat-note {
    margin-top: 18px;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--ink-3);
  }
  .plat-backup {
    margin: 10px 0 auto;
    font-size: 13.5px;
    color: var(--ink-2);
    border-bottom: 1px dashed rgba(238, 240, 255, 0.3);
    transition:
      color var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease);
  }
  .plat-backup:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
  @media (max-width: 900px) {
    .dl-grid {
      grid-template-columns: 1fr;
    }
    .plat-stage {
      height: clamp(180px, 46vw, 260px);
    }
    .plat-stage :global(.plat-phone) {
      width: clamp(140px, 38vw, 200px);
    }
  }

  /* ── notes strip ─────────────────────────────────── */
  .notes {
    padding-block: clamp(28px, 3.5vw, 44px);
    border-bottom: 1px solid var(--line);
  }
  .notes-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px clamp(24px, 4vw, 56px);
  }
  .note-line {
    display: flex;
    gap: 12px;
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--ink-2);
  }
  .note-i {
    flex: none;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin-top: 3px;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
    color: var(--accent-ink);
    font-family: var(--f-latin-display);
    font-style: italic;
    font-weight: 700;
    font-size: 12px;
    line-height: 1;
  }
  @media (max-width: 760px) {
    .notes-row {
      grid-template-columns: 1fr;
    }
  }

  /* ── steps: a real sequence, so it gets numbers ──── */
  .steps {
    --col-gap: clamp(20px, 3vw, 40px);
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px var(--col-gap);
  }
  /* each step hands a thread to the next one */
  .steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 64px;
    right: calc(var(--col-gap) * -1 + 8px);
    top: 27px;
    height: 2px;
    border-radius: 2px;
    background: var(--holo);
    opacity: 0.5;
  }
  .steps li {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .st-no {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 24px;
    border-radius: 50%;
    background:
      linear-gradient(var(--pearl), var(--pearl)) padding-box,
      var(--holo) border-box;
    border: 2px solid transparent;
    font-family: var(--f-latin-display);
    font-style: italic;
    font-size: 1.6rem;
    font-weight: 500;
    color: var(--ink);
  }
  .steps h3 {
    margin-bottom: 8px;
  }
  .steps p {
    font-size: 15px;
    line-height: 1.8;
    color: var(--ink-2);
  }
  .st-duo {
    display: flex;
    margin-top: 16px;
  }
  .st-duo img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 3px solid var(--pearl);
    box-shadow: var(--sh-1);
  }
  .st-duo img + img {
    margin-left: -10px;
  }
  .steps .tlink {
    margin-top: 14px;
  }
  @media (max-width: 980px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .steps li::after {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .steps li {
      display: grid;
      grid-template-columns: 56px 1fr;
      column-gap: 18px;
      align-items: start;
    }
    .st-no {
      grid-row: span 4;
      margin-bottom: 0;
    }
  }

  /* ── requirements & help ─────────────────────────── */
  .req-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 24px clamp(28px, 4vw, 64px);
    align-items: start;
  }
  .req-title,
  .help-title {
    margin-bottom: 22px;
    font-size: clamp(1.6rem, 1.25rem + 1.2vw, 2.3rem);
  }
  .req {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border-radius: var(--r-lg);
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: var(--sh-1);
    overflow: hidden;
  }
  .req th,
  .req td {
    padding: 16px 20px;
    text-align: left;
    vertical-align: top;
    font-size: 14.5px;
    line-height: 1.6;
  }
  .req thead th {
    font-family: var(--f-latin-display);
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--ink);
    background: var(--pearl);
    border-bottom: 1px solid var(--line);
  }
  .req thead td {
    background: var(--pearl);
    border-bottom: 1px solid var(--line);
  }
  .req tbody th {
    width: 22%;
    word-break: keep-all;
    font-weight: 600;
    color: var(--ink-3);
    font-size: 13.5px;
  }
  .req tbody td {
    color: var(--ink-2);
  }
  .req tbody tr + tr > * {
    border-top: 1px solid var(--line);
  }
  .req .is-none {
    color: var(--ink-3);
  }
  .help {
    display: flex;
    flex-direction: column;
  }
  .help-link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 14px;
    padding: 18px 22px;
    margin-bottom: 10px;
    border-radius: var(--r-md);
    background: var(--card);
    border: 1px solid var(--line);
    color: var(--ink);
    transition:
      border-color var(--t-fast) var(--ease),
      transform var(--t-fast) var(--ease);
  }
  .help-link:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    transform: translateY(-1px);
  }
  .hl-t {
    font-weight: 700;
    font-size: 15.5px;
  }
  .hl-d {
    grid-column: 1;
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--ink-2);
  }
  .hl-arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--ink-3);
  }
  .help-link:hover .hl-arrow {
    color: var(--accent-ink);
  }
  @media (max-width: 900px) {
    .req-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .req th,
    .req td {
      padding: 13px 12px;
      font-size: 13.5px;
    }
    .req thead th {
      font-size: 1.1rem;
    }
  }
</style>
