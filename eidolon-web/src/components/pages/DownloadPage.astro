---
import PageHero from '../PageHero.astro';
import WindowFrame from '../WindowFrame.astro';
import PhoneFrame from '../PhoneFrame.astro';
import Icon from '../Icon.astro';
import { SITE } from '../../config/site';
import { localizeDocsPath, t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const page = copy.downloadPage;
const platforms = [
  { key: 'windows', data: page.windows, href: SITE.downloads.windows, fallback: SITE.downloadsFallback.windows, release: SITE.release.windows, icon: 'monitor' },
  { key: 'android', data: page.android, href: SITE.downloads.android, fallback: SITE.downloadsFallback.android, release: SITE.release.android, icon: 'smartphone' },
] as const;
const help = [
  { title: page.helpQuick, desc: page.helpQuickDesc, href: localizeDocsPath(lang, SITE.docs.quickStart), icon: 'book' },
  { title: page.helpFaq, desc: page.helpFaqDesc, href: localizeDocsPath(lang, SITE.docs.faq), icon: 'help' },
];
---

<PageHero label={page.label} h1a={page.h1} lede={page.lede}>
  {SITE.status !== 'public-beta' && <p class="hand preview-note reveal" style="--i:3">{page.previewNote}</p>}
</PageHero>

<section class="section platforms-sec">
  <div class="container">
    <div class="platforms">
      {platforms.map((platform, i) => (
        <article class="platform reveal" style={`--i:${i}`}>
          <div class="platform-media">
            {platform.key === 'windows' ? (
              <WindowFrame title="Focus Cabin">
                <img src="/assets/screenshots/app-focus-cabin.webp" alt="" width="1440" height="1100" loading="lazy" />
              </WindowFrame>
            ) : (
              <PhoneFrame cropTop>
                <img src="/assets/screenshots/app-mobile-home.webp" alt="" width="390" height="844" loading="lazy" />
              </PhoneFrame>
            )}
          </div>
          <div class="platform-body">
            <span class="platform-icon"><Icon name={platform.icon} size={20} /></span>
            <h2>{platform.data.title}</h2>
            <span class="platform-req mono">{platform.data.req}</span>
            <p>{platform.data.desc}</p>
            <div class="platform-cta">
              <a class="btn btn-ink" href={platform.href} data-dl-primary data-dl-fallback={platform.fallback}>
                <span class="dot" aria-hidden="true"></span>
                <span>{platform.data.cta}</span>
              </a>
              {platform.key === 'android' && <span class="platform-arch">{page.android.arch}</span>}
              <span
                class="platform-release mono"
                data-release
                data-release-endpoint={platform.release}
                data-release-label={page.releaseLabel}
                data-release-fallback={page.releaseFallback}
              >{page.releaseFallback}</span>
              <span class="platform-note">{platform.data.note}</span>
              <a class="platform-backup mono" href={platform.fallback} data-dl-backup>{page.backupLink}</a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="unsupported reveal">
      <span class="label">{page.unsupported}</span>
      <div class="unsupported-pills">
        {page.unsupportedList.map((item) => <span class="u-pill">{item}</span>)}
      </div>
    </div>
  </div>
</section>

<section class="section section--paper2 req-sec">
  <div class="container">
    <h2 class="req-title reveal">{page.tableTitle}</h2>
    <div class="req-table reveal" role="table" aria-label={page.tableTitle}>
      <div class="req-row req-row--head" role="row">
        {page.tableHead.map((head) => <span role="columnheader">{head}</span>)}
      </div>
      {page.tableRows.map((row) => (
        <div class="req-row" role="row">
          <span class="req-platform" role="cell">{row.platform}</span>
          <span role="cell"><span class="m-label">{page.tableHead[1]}</span>{row.min}</span>
          <span role="cell"><span class="m-label">{page.tableHead[2]}</span>{row.rec}</span>
          <span role="cell" class="req-feat"><span class="m-label">{page.tableHead[3]}</span>{row.feat}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section help-sec">
  <div class="container">
    <h2 class="help-title reveal">{page.helpTitle}</h2>
    <div class="help-grid">
      {help.map((item, i) => (
        <a class="help-card reveal" style={`--i:${i}`} href={item.href} target="_blank" rel="noopener noreferrer">
          <span class="help-icon"><Icon name={item.icon} size={20} /></span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
          <span class="help-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  // 主线路是 CDN 优选域名，备用是 R2 直连。静态站没有服务端可用性判断，
  // 只能在点击时用 no-cors HEAD 探一下：DNS / TLS / 连接层失败才会 reject，
  // 探不通就改走备用线路（页面上也留了手动备用链接）。超时按「可用」处理，
  // 免得探测本身把用户卡在前面。
  const PROBE_TIMEOUT_MS = 3000;

  document.querySelectorAll<HTMLAnchorElement>('a[data-dl-primary]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const fallback = link.dataset.dlFallback;
      if (!fallback) return;

      event.preventDefault();
      const primary = link.href;
      const timer = new Promise<boolean>((resolve) => setTimeout(() => resolve(true), PROBE_TIMEOUT_MS));
      const probe = fetch(primary, { method: 'HEAD', mode: 'no-cors', cache: 'no-store' })
        .then(() => true)
        .catch(() => false);

      Promise.race([probe, timer]).then((ok) => {
        window.location.href = ok ? primary : fallback;
      });
    });
  });

  // 版本号来自应用服务端的发版清单（带 CORS 响应头，每次发版由发布管线写入）。
  // 页面不写死版本号：发版不需要改这里，也不需要重新构建官网。
  // 取不到就保留静态文案「下载最新版」——任何情况下都不显示空白或 undefined。
  const RELEASE_TIMEOUT_MS = 4000;
  const formatSize = (bytes: unknown) =>
    typeof bytes === 'number' && bytes > 0 ? `${Math.round(bytes / 1024 / 1024)} MB` : '';
  // 发版清单的 pub_date 是 UTC（如 2026-11-04T09:58:58Z）。直接截前 10 位在跨零点时
  // 会把北京时间的前一天显示出来，所以固定按 UTC+8 渲染，中英两页同一口径；
  // 不使用访客本地时区，避免同一页面在不同地区看到不同日期。
  const formatDate = (value: unknown) => {
    if (typeof value !== 'string' || !value) return '';
    const parsed = Date.parse(value);
    if (Number.isNaN(parsed)) return value.slice(0, 10);
    return new Date(parsed + 8 * 60 * 60 * 1000).toISOString().slice(0, 10);
  };

  document.querySelectorAll<HTMLElement>('[data-release]').forEach((node) => {
    const endpoint = node.dataset.releaseEndpoint;
    if (!endpoint) return;
    const label = node.dataset.releaseLabel ?? '';
    const fallback = node.dataset.releaseFallback ?? '';

    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), RELEASE_TIMEOUT_MS);

    fetch(`${endpoint}?ts=${Date.now()}`, { cache: 'no-store', signal: controller.signal })
      .then((response) => (response.ok ? response.json() : Promise.reject(new Error(String(response.status)))))
      .then((data: { version?: unknown; pub_date?: unknown; size?: unknown }) => {
        if (typeof data.version !== 'string' || !data.version) throw new Error('missing version');
        const date = formatDate(data.pub_date);
        const parts = [data.version, date, formatSize(data.size)].filter(Boolean);
        node.textContent = `${label} ${parts.join(' · ')}`.trim();
        node.classList.add('is-live');
      })
      .catch(() => {
        node.textContent = fallback;
      })
      .finally(() => {
        window.clearTimeout(timeout);
      });
  });
</script>

<style>
  .preview-note {
    margin-top: 20px;
    font-size: 19px;
    line-height: 1.5;
    max-width: 520px;
    text-wrap: pretty;
  }

  .platforms-sec {
    padding-top: 0;
  }
  .platforms {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(18px, 3vw, 28px);
  }
  .platform {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--card);
    overflow: hidden;
  }
  .platform-media {
    height: 300px;
    padding: 26px 26px 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow: hidden;
    background:
      radial-gradient(90% 80% at 70% 0%, var(--sage-wash), transparent 70%),
      linear-gradient(160deg, var(--paper-2), var(--card));
    border-bottom: 1px solid var(--line);
  }
  .platform-media :global(.wf) {
    width: 100%;
    max-width: 480px;
  }
  .platform-media :global(.pf) {
    width: 208px;
    flex: none;
    margin-top: 4px;
  }
  .platform-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 28px 30px 30px;
    flex: 1;
  }
  .platform-icon {
    width: 44px;
    height: 44px;
    border-radius: 13px;
    background: var(--sage-wash);
    color: var(--sage-deep);
    display: grid;
    place-items: center;
    margin-bottom: 18px;
  }
  .platform-body h2 {
    font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.7rem);
  }
  .platform-req {
    display: inline-block;
    margin: 6px 0 14px;
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }
  .platform-body p {
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--ink-2);
    max-width: 400px;
    text-wrap: pretty;
  }
  .platform-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: auto;
    padding-top: 26px;
  }
  .platform-note {
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .platform-arch {
    font-size: 13px;
    line-height: 1.5;
    color: var(--sage-deep);
    background: var(--sage-wash);
    border-radius: var(--r-full);
    padding: 5px 12px;
  }
  .platform-release {
    font-size: 12.5px;
    letter-spacing: 0.02em;
    color: var(--ink-2);
  }
  .platform-backup {
    font-size: 12.5px;
    color: var(--ink-3);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    opacity: 0.85;
    transition: opacity 0.18s ease, color 0.18s ease;
  }
  .platform-backup:hover {
    opacity: 1;
    color: var(--ink-2);
  }

  .unsupported {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: clamp(32px, 4vw, 44px);
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  .unsupported-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .u-pill {
    border: 1px dashed var(--line-2);
    border-radius: var(--r-full);
    padding: 6px 14px;
    font-size: 13px;
    color: var(--ink-3);
  }

  .req-title {
    font-size: clamp(1.6rem, 1.2rem + 1.1vw, 2.1rem);
    margin-bottom: clamp(28px, 4vw, 40px);
  }
  .req-table {
    border-top: 1px solid var(--line-2);
  }
  .req-row {
    display: grid;
    grid-template-columns: 1.1fr 1.4fr 1.3fr 1.5fr;
    gap: 24px;
    padding: 18px 4px;
    border-bottom: 1px solid var(--line);
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--ink-2);
  }
  .req-row--head {
    padding: 12px 4px;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  :lang(zh) .req-row--head {
    font-family: var(--f-body);
    font-size: 13px;
    letter-spacing: 0.06em;
  }
  .req-platform {
    font-weight: 600;
    color: var(--ink);
  }
  .req-feat {
    color: var(--ink-3);
  }
  .m-label {
    display: none;
  }

  .help-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .help-title {
    font-size: clamp(1.6rem, 1.2rem + 1.1vw, 2.1rem);
    margin-bottom: clamp(24px, 3.5vw, 36px);
  }
  .help-card {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--card);
    padding: 26px;
    transition: transform var(--t-mid) var(--ease), box-shadow var(--t-mid);
  }
  .help-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--sh-paper);
  }
  .help-icon {
    width: 42px;
    height: 42px;
    flex: none;
    border-radius: 12px;
    background: var(--sage-wash);
    color: var(--sage-deep);
    display: grid;
    place-items: center;
  }
  .help-card h3 {
    font-size: 19px;
    margin-bottom: 6px;
  }
  html[lang="en"] .help-card h3 {
    font-size: 23px;
  }
  .help-card p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .help-arrow {
    margin-left: auto;
    color: var(--ink-3);
  }

  @media (max-width: 1023px) {
    .platforms {
      grid-template-columns: 1fr;
    }
    .platform-media {
      height: 260px;
    }
  }
  @media (max-width: 767px) {
    .req-row {
      grid-template-columns: 1fr 1fr;
      gap: 8px 18px;
      font-size: 14px;
    }
    .req-row--head {
      display: none;
    }
    .req-platform {
      grid-column: 1 / -1;
    }
    .req-feat {
      grid-column: 1 / -1;
    }
    .m-label {
      display: block;
      font-size: 11.5px;
      letter-spacing: 0.04em;
      color: var(--ink-3);
      margin-bottom: 3px;
    }
    .help-grid {
      grid-template-columns: 1fr;
    }
    .platform-body {
      padding: 24px;
    }
  }
</style>
