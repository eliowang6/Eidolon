---
import PageHero from '../PageHero.astro';
import Icon from '../Icon.astro';
import { SITE } from '../../config/site';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const page = copy.docsPage;
const hrefs = {
  quickStart: SITE.docs.quickStart,
  agent: SITE.docs.agent,
  faq: SITE.docs.faq,
} as const;
---

<PageHero label={page.label} h1a={page.h1} lede={page.lede} />

<section class="section docs-sec">
  <div class="container">
    <div class="doc-cards">
      {page.cards.map((card, i) => (
        <a class="doc-card reveal" style={`--i:${i}`} href={hrefs[card.href as keyof typeof hrefs]} target="_blank" rel="noopener noreferrer">
          <span class="doc-icon"><Icon name={card.icon} size={28} stroke={1.3} /></span>
          <h2>{card.title}</h2>
          <p>{card.desc}</p>
          <span class="doc-cta">{card.cta}</span>
        </a>
      ))}
    </div>

    <div class="docs-banner band-night reveal">
      <div class="db-copy">
        <span class="db-mark" aria-hidden="true"><Icon name="book" size={22} /></span>
        <h2>{page.bannerTitle}</h2>
      </div>
      <div class="db-action">
        <a class="btn btn-ink" href={SITE.docs.home} target="_blank" rel="noopener noreferrer">
          <span class="dot" aria-hidden="true"></span>
          <span>{page.bannerCta}</span>
        </a>
        <span class="db-note">{page.bannerNote}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .docs-sec {
    padding-top: 0;
  }
  .doc-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2.4vw, 24px);
  }
  .doc-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--card);
    padding: 30px 28px 26px;
    min-height: 320px;
    transition: transform var(--t-mid) var(--ease), box-shadow var(--t-mid);
  }
  .doc-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--sh-paper);
  }
  .doc-icon {
    width: 54px;
    height: 54px;
    border-radius: 16px;
    background: var(--sage-wash);
    color: var(--sage-deep);
    display: grid;
    place-items: center;
    margin-bottom: 34px;
  }
  .doc-card h2 {
    font-size: 20px;
    margin-bottom: 8px;
  }
  .doc-card p {
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .doc-cta {
    margin-top: auto;
    padding-top: 22px;
    font-size: 12.5px;
    color: var(--sage-deep);
  }

  .docs-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px 40px;
    margin-top: clamp(36px, 5vw, 56px);
    border-radius: var(--r-xl);
    padding: clamp(30px, 4vw, 48px);
  }
  .db-copy {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .db-mark {
    width: 46px;
    height: 46px;
    flex: none;
    border-radius: 13px;
    background: rgba(200, 241, 105, 0.12);
    color: var(--lime);
    display: grid;
    place-items: center;
  }
  .docs-banner h2 {
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.9rem);
    color: var(--night-text);
  }
  .db-action {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }
  .db-note {
    font-size: 11px;
    color: var(--night-dim);
  }

  @media (max-width: 1023px) {
    .doc-cards {
      grid-template-columns: 1fr;
    }
    .doc-card {
      min-height: 0;
    }
  }
  @media (max-width: 767px) {
    .docs-banner {
      align-items: flex-start;
    }
    .db-action {
      align-items: flex-start;
    }
    .db-action .btn {
      width: 100%;
    }
  }
</style>
