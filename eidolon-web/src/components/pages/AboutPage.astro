---
import Polaroid from '../Polaroid.astro';
import TornCard from '../TornCard.astro';
import Icon from '../Icon.astro';
import { GITHUB_ISSUES, SITE } from '../../config/site';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const page = copy.aboutPage;
const feedbackLinks = [
  SITE.social.qqGroup && { label: copy.footer.qq, href: SITE.social.qqGroup },
  { label: 'GitHub Issues', href: GITHUB_ISSUES },
].filter(Boolean) as { label: string; href: string }[];
const sourceLinks = [
  { label: 'GitHub', href: SITE.social.github },
  { label: copy.footer.docs, href: SITE.docs.home },
];
const principleTitle = (title: string, sub: string) => (sub ? `${title} · ${sub}` : title);
---

<header class="about-hero">
  <div class="container">
    <h1 class="big-quote reveal">“{page.quote}”</h1>
    <span class="quote-sub reveal" style="--i:1">{page.quoteSub}</span>
  </div>
</header>

<section class="section fea-sec">
  <div class="container fea-grid">
    <div class="fea-pola reveal">
      <Polaroid src="/assets/fea-hero-illustration.webp" alt="Fea" caption={page.polaCaption} rotate={-2.4} />
    </div>
    <div class="fea-copy">
      <span class="label reveal">{page.feaLabel}</span>
      <h2 class="fea-name reveal" style="--i:1">{page.feaName}</h2>
      <span class="fea-sub mono reveal" style="--i:2">{page.feaSub}</span>
      <p class="lede reveal" style="--i:3">{page.feaBody}</p>
    </div>
  </div>
</section>

<section class="section section--paper2 principles-sec">
  <div class="container">
    <div class="principles">
      <TornCard
        no="01"
        title={principleTitle(page.p1Title, page.p1Sub)}
        desc={page.p1Body}
      />
      <TornCard
        no="02"
        title={principleTitle(page.p2Title, page.p2Sub)}
        desc={page.p2Body}
      />
    </div>
  </div>
</section>

<section class="section maker-sec">
  <div class="container">
    <div class="maker-grid">
      <div class="maker-copy">
        <span class="label reveal">{page.makerLabel}</span>
        <h2 class="reveal" style="--i:1">{page.makerTitle}</h2>
        <p class="lede reveal" style="--i:2">{page.makerBody}</p>
        <ul class="maker-chips reveal" style="--i:3">
          {page.makerChips.map((chip) => <li>{chip}</li>)}
        </ul>
      </div>
      <div class="maker-side reveal" style="--i:2">
        <p class="hand maker-note">{copy.mnote.maker}</p>
        {SITE.founder.showCredentials && (
          <ul class="credentials">
            {page.credentials.map((item) => (
              <li><span class="c-dot" aria-hidden="true"></span>{item}</li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</section>

<section class="section section--paper2 instarmony-sec">
  <div class="container instarmony-inner">
    <h2 class="instarmony-name reveal" style="--i:1">{page.instarmonyTitle}</h2>
    <p class="reveal" style="--i:2">{page.instarmonyBody}</p>
    <a class="tlink reveal" style="--i:3" href="https://instarmony.com" target="_blank" rel="noopener noreferrer">{page.instarmonyLink}</a>
  </div>
</section>

<section class="section contact-sec" id="contact">
  <div class="container">
    <h2 class="contact-title reveal">{page.contactTitle}</h2>
    <div class={`contact-grid ${SITE.contactEmail ? '' : 'contact-grid--two'}`}>
      <article class="contact-card reveal">
        <span class="ct-icon"><Icon name="message" size={19} /></span>
        <h3>{page.contactCards.feedback.title}</h3>
        <p>{page.contactCards.feedback.desc}</p>
        <div class="ct-links">
          {feedbackLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} →</a>
          ))}
        </div>
      </article>

      {SITE.contactEmail && (
        <article class="contact-card reveal" style="--i:1">
          <span class="ct-icon"><Icon name="mail" size={19} /></span>
          <h3>{page.contactCards.coop.title}</h3>
          <p>{page.contactCards.coop.desc}</p>
          <div class="ct-links">
            <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
          </div>
        </article>
      )}

      <article class="contact-card reveal" style={`--i:${SITE.contactEmail ? 2 : 1}`}>
        <span class="ct-icon"><Icon name="code" size={19} /></span>
        <h3>{page.contactCards.source.title}</h3>
        <p>{page.contactCards.source.desc}</p>
        <div class="ct-links">
          {sourceLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} →</a>
          ))}
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .about-hero {
    padding: clamp(150px, 22vh, 210px) 0 clamp(64px, 9vw, 110px);
    text-align: center;
  }
  .big-quote {
    font-family: var(--f-latin-display);
    font-style: italic;
    font-size: clamp(2.5rem, 1.4rem + 4.4vw, 4.5rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    max-width: 1020px;
    margin-inline: auto;
    text-wrap: balance;
  }
  .quote-sub {
    display: block;
    margin-top: 24px;
    font-size: 13.5px;
    color: var(--ink-3);
    letter-spacing: 0.02em;
  }

  .fea-sec {
    padding-top: 0;
  }
  .fea-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(36px, 6vw, 92px);
    align-items: center;
  }
  .fea-pola :global(.pola) {
    max-width: 380px;
  }
  .fea-name {
    font-family: var(--f-latin-display);
    font-weight: 400;
    font-size: clamp(4.5rem, 3rem + 6vw, 6.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 10px 0 6px;
  }
  .fea-sub {
    display: block;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--ink-3);
    margin-bottom: 26px;
  }
  .fea-copy .lede {
    max-width: 560px;
  }

  .principles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(22px, 4vw, 48px);
    align-items: start;
  }
  .principles :global(.torn) {
    padding: 44px 34px 36px;
    min-height: 300px;
  }
  .principles :global(.torn h3) {
    font-family: var(--f-latin-display), var(--f-zh-display);
    font-weight: 400;
    font-size: clamp(1.35rem, 1.1rem + 0.7vw, 1.7rem);
    line-height: 1.3;
    margin: 14px 0 14px;
  }
  .principles :global(.torn p) {
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--ink-2);
  }

  .maker-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(36px, 6vw, 88px);
    align-items: start;
  }
  .maker-copy h2 {
    margin: 14px 0 18px;
    text-wrap: balance;
  }
  .maker-copy .lede {
    max-width: 560px;
  }
  .maker-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }
  .maker-chips li {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    padding: 7px 13px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-full);
    color: var(--ink-2);
  }
  .maker-side {
    padding-top: 46px;
  }
  .maker-note {
    font-size: 20px;
    line-height: 1.55;
    max-width: 340px;
    transform: rotate(-2deg);
    text-wrap: pretty;
  }
  .credentials {
    margin-top: 30px;
    display: grid;
    gap: 12px;
  }
  .credentials li {
    display: flex;
    gap: 10px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--ink-2);
  }
  .c-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--sage-deep);
    flex: none;
    margin-top: 9px;
  }

  .instarmony-inner {
    max-width: 760px;
    text-align: center;
  }
  .instarmony-name {
    font-family: var(--f-latin-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 1.8rem + 2.4vw, 3.6rem);
    line-height: 1.05;
    margin: 12px 0 18px;
  }
  .instarmony-inner p {
    font-size: 15px;
    line-height: 1.8;
    color: var(--ink-2);
    max-width: 520px;
    margin: 0 auto 24px;
  }
  .instarmony-inner .tlink {
    display: inline-flex;
  }

  .contact-title {
    font-size: clamp(1.7rem, 1.3rem + 1.2vw, 2.2rem);
    margin-bottom: clamp(26px, 4vw, 40px);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .contact-grid--two {
    grid-template-columns: repeat(2, 1fr);
    max-width: 800px;
  }
  .contact-card {
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--card);
    padding: 26px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .ct-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--sage-wash);
    color: var(--sage-deep);
    display: grid;
    place-items: center;
    margin-bottom: 18px;
  }
  .contact-card h3 {
    font-size: 17px;
    margin-bottom: 6px;
  }
  .contact-card p {
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .ct-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 18px;
    font-size: 12.5px;
    color: var(--sage-deep);
  }
  .ct-links a {
    border-bottom: 1px solid transparent;
  }
  .ct-links a:hover {
    border-color: currentColor;
  }

  @media (max-width: 1023px) {
    .fea-grid,
    .maker-grid {
      grid-template-columns: 1fr;
    }
    .fea-pola {
      max-width: 400px;
    }
    .maker-side {
      padding-top: 8px;
    }
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 767px) {
    .principles {
      grid-template-columns: 1fr;
    }
    .principles :global(.torn:nth-child(even)) {
      transform: rotate(0.6deg);
    }
    .about-hero {
      padding-top: 124px;
    }
  }
</style>
