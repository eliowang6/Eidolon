---
import StatusPill from '../StatusPill.astro';
import WaitlistLetter from '../WaitlistLetter.astro';
import Icon from '../Icon.astro';
import Timeline from '../Timeline.astro';
import Faq from '../Faq.astro';
import { SITE } from '../../config/site';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const page = copy.betaPage;
const status = copy.statusCopy[SITE.status];
type Community = { label: string; desc: string; href: string; icon: string };
const community = (href: string, label: string, desc: string, icon: string): Community | null =>
  href ? { label, desc, href, icon } : null;
const communities = [
  community(SITE.social.qqGroup, copy.footer.qq, lang === 'zh' ? '第一时间收到公测通知，也能直接找到我们。' : 'Beta news first — and a direct line to us.', 'message'),
  community(SITE.social.xiaohongshu, copy.footer.xiaohongshu, lang === 'zh' ? '看她的一天，也看我们怎么把她做出来。' : "Her days, and how we're building her.", 'heart'),
  community(SITE.social.bilibili, copy.footer.bilibili, lang === 'zh' ? '开发日志、演示与更长的记录。' : 'Devlogs, demos and longer records.', 'book'),
].filter((item): item is Community => item !== null);
---

<section class="beta-hero">
  <div class="container beta-grid">
    <div class="beta-copy">
      <StatusPill text={status.pill} />
      <h1>{page.h1a}<br />{page.h1b}</h1>
      <p class="lede">{page.lede}</p>
      <div class="beta-meta">
        <span class="mono">WINDOWS · ANDROID</span>
        <span class="mono">2026 · FIRST PUBLIC BETA</span>
      </div>
    </div>
    <div class="beta-form" id="join">
      <h2 class="sr-only">{page.formTitle}</h2>
      <WaitlistLetter lang={lang} compact id="beta-letter" />
    </div>
  </div>
</section>

<section class="section section--paper2 perks-sec">
  <div class="container">
    <div class="perks-head reveal">
      <h2>{page.perksTitle}</h2>
    </div>
    <div class="perks">
      {page.perks.map((perk, i) => (
        <article class="perk reveal" style={`--i:${i}`}>
          <span class="perk-no mono">{perk.no}</span>
          <span class="perk-icon"><Icon name={perk.icon} size={20} /></span>
          <h3>{perk.title}</h3>
          <p>{perk.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section road-sec">
  <div class="container road-grid">
    <div class="road-copy">
      <span class="label">{copy.road.label}</span>
      <h2>{page.roadTitle}</h2>
    </div>
    <div class="road-visual reveal">
      <Timeline nodes={copy.road.nodes} orientation="vertical" />
    </div>
  </div>
</section>

<section class="section section--paper2 roadmap-sec" id="roadmap">
  <div class="container">
    <div class="roadmap-head reveal">
      <span class="label">{page.roadmapLabel}</span>
      <h2>{page.roadmapTitle}</h2>
    </div>
    <div class="board">
      {page.roadmapCols.map((col, ci) => (
        <div class={`board-col board-col--${ci} reveal`} style={`--i:${ci}`}>
          <div class="board-head">
            <h3>{col.title}</h3>
            <span class="mono">{col.en}</span>
            <span class="board-count mono">{String(col.cards.length).padStart(2, '0')}</span>
          </div>
          <div class="board-cards">
            {col.cards.map((card, i) => (
              <div class="rm-card" style={`--r:${(i % 2 === 0 ? -0.8 : 0.7)}deg`}>
                <p>{card}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
    <p class="roadmap-note reveal">{page.roadmapNote}</p>
  </div>
</section>

{communities.length > 0 && (
  <section class="section community-sec">
    <div class="container">
      <div class="community-head reveal">
        <span class="label">Community</span>
        <h2>{page.communityTitle}</h2>
      </div>
      <div class="community-grid">
        {communities.map((item, i) => (
          <a class="community-card reveal" style={`--i:${i}`} href={item.href} target="_blank" rel="noopener noreferrer">
            <span class="c-icon"><Icon name={item.icon} size={20} /></span>
            <h3>{item.label}</h3>
            <p>{item.desc}</p>
            <span class="c-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<section class="section faq-sec">
  <div class="container">
    <Faq items={page.faq} lang={lang} title={page.faqTitle} />
  </div>
</section>

<style>
  .beta-hero {
    padding: clamp(56px, 7vw, 96px) 0 clamp(64px, 8vw, 110px);
    background:
      radial-gradient(60% 80% at 12% 0%, var(--sage-wash), transparent 65%),
      var(--paper);
  }
  .beta-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(36px, 6vw, 88px);
    align-items: center;
  }
  .beta-copy h1 {
    margin: 20px 0 18px;
  }
  .beta-copy .lede {
    max-width: 560px;
  }
  .beta-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 34px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }
  .beta-form :global(.letter-wrap) {
    max-width: none;
  }
  .beta-form :global(.letter) {
    transform: rotate(0.8deg);
  }

  .perks-head {
    display: flex;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: clamp(32px, 5vw, 48px);
  }
  .perks-head h2 {
    font-size: clamp(1.6rem, 1.2rem + 1.1vw, 2.1rem);
  }
  .perks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .perk {
    position: relative;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 28px 26px;
  }
  .perk-no {
    position: absolute;
    top: 24px;
    right: 26px;
    font-size: 10.5px;
    color: var(--ink-3);
    letter-spacing: 0.08em;
  }
  .perk-icon {
    width: 44px;
    height: 44px;
    border-radius: 13px;
    background: var(--sage-wash);
    color: var(--sage-deep);
    display: grid;
    place-items: center;
    margin-bottom: 40px;
  }
  .perk h3 {
    font-size: 18px;
    margin-bottom: 8px;
  }
  .perk p {
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .road-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(36px, 6vw, 88px);
    align-items: start;
  }
  .road-copy {
    position: sticky;
    top: calc(var(--nav-h) + 40px);
  }
  .road-copy h2 {
    margin: 14px 0 16px;
    text-wrap: balance;
  }
  .road-copy .lede {
    max-width: 400px;
  }
  .road-visual {
    padding-top: 6px;
  }

  .roadmap-head {
    text-align: center;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .roadmap-head h2 {
    margin-top: 14px;
  }
  .board {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2.4vw, 26px);
    align-items: start;
  }
  .board-col {
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 20px 18px 24px;
    background: color-mix(in srgb, var(--card) 55%, transparent);
  }
  .board-col--0 {
    border-color: var(--sage);
    background: var(--card);
  }
  .board-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 2px 4px 16px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 18px;
  }
  .board-head h3 {
    font-size: 18px;
  }
  .board-head span.mono {
    font-size: 10px;
    color: var(--ink-3);
    letter-spacing: 0.08em;
  }
  .board-count {
    margin-left: auto;
  }
  .board-cards {
    display: grid;
    gap: 12px;
  }
  .rm-card {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 18px 16px 16px;
    transform: rotate(var(--r, 0deg));
    box-shadow: 0 1px 0 rgba(18, 36, 29, 0.04);
    transition: transform var(--t-mid) var(--ease), box-shadow var(--t-mid);
  }
  .rm-card:hover {
    transform: rotate(0deg) translateY(-3px);
    box-shadow: var(--sh-paper);
  }
  .rm-card::before {
    content: "";
    position: absolute;
    top: -7px;
    left: 50%;
    width: 44px;
    height: 14px;
    background: var(--tape, rgba(225, 205, 148, 0.55));
    transform: translateX(-50%) rotate(-2deg);
  }
  .board-col--1 .rm-card {
    --tape: rgba(200, 241, 105, 0.45);
  }
  .board-col--2 .rm-card {
    --tape: rgba(176, 88, 63, 0.18);
  }
  .rm-card p {
    font-size: 13px;
    line-height: 1.65;
    color: var(--ink-2);
  }
  .roadmap-note {
    margin-top: 24px;
    text-align: center;
    font-size: 11.5px;
    color: var(--ink-3);
  }

  .community-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .community-card {
    position: relative;
    display: block;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--card);
    padding: 28px 26px;
    transition: transform var(--t-mid) var(--ease), box-shadow var(--t-mid);
  }
  .community-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--sh-paper);
  }
  .c-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--sage-wash);
    color: var(--sage-deep);
    display: grid;
    place-items: center;
    margin-bottom: 26px;
  }
  .community-card h3 {
    font-size: 17px;
    margin-bottom: 6px;
  }
  .community-card p {
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--ink-2);
  }
  .c-arrow {
    position: absolute;
    top: 26px;
    right: 26px;
    color: var(--ink-3);
    font-size: 16px;
  }
  .faq-sec {
    padding-top: clamp(48px, 6vw, 80px);
  }

  @media (max-width: 1023px) {
    .beta-grid,
    .road-grid {
      grid-template-columns: 1fr;
    }
    .beta-form {
      max-width: 640px;
    }
    .road-copy {
      position: static;
    }
    .perks,
    .community-grid {
      grid-template-columns: 1fr;
    }
    .perk-icon {
      margin-bottom: 22px;
    }
    .board {
      grid-template-columns: 1fr;
    }
  }
</style>
