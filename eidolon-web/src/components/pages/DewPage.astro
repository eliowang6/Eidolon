---
import Eyebrow from '../Eyebrow.astro';
import Faq from '../Faq.astro';
import Icon from '../Icon.astro';
import Logo from '../Logo.astro';
import { SITE } from '../../config/site';
import { localizePath, t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const page = copy.dewPage;
const p = (href: string) => localizePath(lang, href);

// The Chinese page bills in CNY by default, the English one in USD; both can switch.
const defaultCurrency = lang === 'zh' ? 'CNY' : 'USD';

const config = {
  lang,
  defaultCurrency,
  supportEmail: SITE.contactEmail,
  plansEndpoints: [
    'https://api.eidolon.instarmony.com/subscription/dew/plans-public',
    'https://api.eidolon.instarmony.com/eidolon/api/subscription/dew/plans-public',
  ],
  checkoutEndpoints: [
    'https://api.eidolon.instarmony.com/subscription/dew/checkout-public',
    'https://api.eidolon.instarmony.com/eidolon/api/subscription/dew/checkout-public',
  ],
  copy: {
    unit: page.unit,
    creditsLine: page.creditsLine,
    packAria: page.packAria,
    loading: page.loading,
    loadFailed: page.loadFailed,
    retry: page.retry,
    regionCn: page.regionCn,
    regionIntl: page.regionIntl,
    cnMethods: page.cnMethods,
    intlMethods: page.intlMethods,
    slipList: page.slipList,
    founderNote: page.founderNote,
    badEmail: page.badEmail,
    submit: page.submit,
    submitting: page.submitting,
    copy: page.copy,
    copied: page.copied,
    copyFailed: page.copyFailed,
    payBy: page.payBy,
    restart: page.restart,
    restartConfirm: page.restartConfirm,
    alreadyPaid: page.alreadyPaid,
    errRate: page.errRate,
    errUnavailable: page.errUnavailable,
    errGeneric: page.errGeneric,
    errNetwork: page.errNetwork,
  },
};

// A fixed, seeded star field so every build renders the same sky.
let seed = 20261105;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};
const stars = Array.from({ length: 56 }, (_, i) => ({
  x: +(rand() * 1200).toFixed(1),
  y: +(rand() * 600).toFixed(1),
  r: +(0.5 + rand() * 1.05).toFixed(2),
  o: +(0.16 + rand() * 0.44).toFixed(2),
  twinkle: i % 5 === 0,
  delay: +(rand() * 7).toFixed(2),
}));
const glints = [
  { x: 1010, y: 92, s: 0.55 },
  { x: 612, y: 64, s: 0.4 },
  { x: 1128, y: 418, s: 0.36 },
];
const ticks = Array.from({ length: 12 }, (_, i) => i * 30);
const skeletons = [0, 1, 2, 3, 4];
---

<div class="dew" data-dew>
  <!-- Hero: a night window with the emblem — a dewdrop whose clock runs backward -->
  <section class="dew-hero">
    <div class="container">
      <div class="hero-panel">
        <svg class="sky" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
          {stars.map((s) => (
            <circle
              cx={s.x}
              cy={s.y}
              r={s.r}
              opacity={s.o}
              class={s.twinkle ? 'twinkle' : undefined}
              style={s.twinkle ? `animation-delay:-${s.delay}s` : undefined}
            />
          ))}
          {glints.map((g, i) => (
            <g transform={`translate(${g.x} ${g.y}) scale(${g.s})`}>
              <path class="sky-glint" style={`animation-delay:-${i * 2.3}s`} d="M0 -13 C1.4 -2 2 -1.4 13 0 C2 1.4 1.4 2 0 13 C-1.4 2 -2 1.4 -13 0 C-2 -1.4 -1.4 -2 0 -13 Z" />
            </g>
          ))}
        </svg>

        <div class="hero-copy">
          <Eyebrow text={page.eyebrow} class="hero-eyebrow" />
          <h1 class="dew-name">
            <span class="name-main">{page.name}</span>
            <span class="name-alt">{page.nameAlt}</span>
          </h1>
          <p class="tagline">{page.tagline}</p>
          <p class="hero-lede">{page.lede}</p>
          <div class="hero-actions">
            <a class="btn btn-ink" href="#packs"><span class="dot" aria-hidden="true"></span>{page.cta}</a>
            <a class="hero-link" href="#after">{page.afterLabel} <Icon name="arrowRight" size={15} /></a>
          </div>
        </div>

        <figure class="emblem">
          <svg viewBox="0 0 240 300" aria-hidden="true" focusable="false">
            <defs>
              <radialGradient id="dew-glow" cx="0.5" cy="0.5" r="0.5">
                <stop offset="0" stop-color="#c8f169" stop-opacity="0.2" />
                <stop offset="0.55" stop-color="#86b8ad" stop-opacity="0.07" />
                <stop offset="1" stop-color="#86b8ad" stop-opacity="0" />
              </radialGradient>
              <radialGradient id="dew-glass" cx="0.5" cy="0.64" r="0.62">
                <stop offset="0" stop-color="#0e1a15" stop-opacity="0" />
                <stop offset="0.7" stop-color="#86b8ad" stop-opacity="0.07" />
                <stop offset="1" stop-color="#a9d3c8" stop-opacity="0.3" />
              </radialGradient>
              <linearGradient id="dew-rim" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#ffffff" stop-opacity="0.8" />
                <stop offset="1" stop-color="#ffffff" stop-opacity="0.22" />
              </linearGradient>
            </defs>
            <circle cx="120" cy="190" r="118" fill="url(#dew-glow)" />
            <path
              class="drop"
              d="M120 16 C104 44 34 118 34 192 A86 86 0 0 0 206 192 C206 118 136 44 120 16 Z"
              fill="url(#dew-glass)"
              stroke="url(#dew-rim)"
              stroke-width="1.4"
            />
            <path d="M60 130 C51 148 45 166 44 186" fill="none" stroke="#ffffff" stroke-opacity="0.42" stroke-width="2.4" stroke-linecap="round" />
            <path d="M146 264 C166 258 182 246 190 228" fill="none" stroke="#c8f169" stroke-opacity="0.7" stroke-width="2.2" stroke-linecap="round" />

            <g class="clock">
              <circle cx="120" cy="192" r="56" fill="none" stroke="#e9efe6" stroke-opacity="0.2" stroke-width="1" />
              {ticks.map((deg) => (
                <line
                  x1="120"
                  y1={deg % 90 === 0 ? 140 : 143}
                  x2="120"
                  y2="148"
                  transform={`rotate(${deg} 120 192)`}
                  stroke="#e9efe6"
                  stroke-opacity={deg % 90 === 0 ? 0.7 : 0.38}
                  stroke-width="1.3"
                  stroke-linecap="round"
                />
              ))}
              <path d="M97.4 130 A66 66 0 0 0 55 203.5" fill="none" stroke="#c8f169" stroke-opacity="0.75" stroke-width="1.3" stroke-linecap="round" />
              <path d="M48.9 197 L55 203.5 L58.7 195.2" fill="none" stroke="#c8f169" stroke-opacity="0.75" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
              <g class="hand hand-hour">
                <line x1="120" y1="192" x2="120" y2="166" transform="rotate(-62 120 192)" stroke="#e9efe6" stroke-width="2.6" stroke-linecap="round" />
              </g>
              <g class="hand hand-min">
                <line x1="120" y1="200" x2="120" y2="146" stroke="#c8f169" stroke-width="1.6" stroke-linecap="round" />
              </g>
              <circle cx="120" cy="192" r="3.4" fill="#c8f169" />
            </g>

            <g transform="translate(84 114)">
              <path class="glint" d="M0 -13 C1.4 -2 2 -1.4 13 0 C2 1.4 1.4 2 0 13 C-1.4 2 -2 1.4 -13 0 C-2 -1.4 -1.4 -2 0 -13 Z" fill="#ffffff" />
            </g>
          </svg>
          <figcaption class="hand emblem-note">{page.emblemNote}</figcaption>
        </figure>

        <ul class="facts">
          {page.facts.map((fact) => (
            <li>
              <b>{fact.title}</b>
              <span>{fact.desc}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Buy: price list on the left, the order slip on the right -->
  <section class="section buy-sec" id="packs">
    <div class="container buy-grid">
      <fieldset class="picker" id="dew-picker">
        <legend class="sr-only">{page.packsTitle}</legend>
        <div class="picker-head">
          <div>
            <Eyebrow text={page.packsLabel} />
            <h2 id="packs-title">{page.packsTitle}</h2>
            <p class="picker-lede">{page.packsLede}</p>
          </div>
          <div class="region-block">
            <div class="region" role="radiogroup" aria-label={page.regionLabel}>
              <label class="region-opt">
                <input type="radio" name="dew-currency" value="CNY" checked={defaultCurrency === 'CNY'} />
                <span>{page.regionCn}</span>
              </label>
              <label class="region-opt">
                <input type="radio" name="dew-currency" value="USD" checked={defaultCurrency === 'USD'} />
                <span>{page.regionIntl}</span>
              </label>
            </div>
            <p class="methods" id="dew-methods">{defaultCurrency === 'CNY' ? page.cnMethods : page.intlMethods}</p>
          </div>
        </div>

        <div class="pack-list" id="dew-packs" aria-busy="true">
          {skeletons.map((i) => (
            <div class="pack pack--ghost" aria-hidden="true" style={`--i:${i}`}>
              <span class="ghost ghost--drops"></span>
              <span class="ghost ghost--name"></span>
              <span class="ghost ghost--price"></span>
            </div>
          ))}
        </div>
        <div class="pack-status" id="dew-status" role="status">
          <span id="dew-status-text">{page.loading}</span>
          <button type="button" class="tlink" id="dew-retry" hidden>{page.retry}</button>
        </div>
        <noscript><p class="pack-status">{page.noscript}</p></noscript>

        <p class="picker-note">{page.promoNote}</p>
        <p class="picker-note" id="dew-founder" hidden>
          <span id="dew-founder-text"></span>
          <a id="dew-founder-mail" href="#"></a>
        </p>
      </fieldset>

      <div class="slip-col">
        <div class="slip-wrap">
          <div class="slip" id="dew-slip" data-state="draft" aria-live="polite">
            <div class="slip-draft">
              <div class="slip-top">
                <span class="slip-title">{page.slipTitle}</span>
                <span class="slip-code mono" id="s-code">CHRONO DEW · {defaultCurrency}</span>
              </div>

              <div class="slip-main">
                <span class="slip-qty"><b id="s-units">—</b><span>{page.unit}</span></span>
                <span class="slip-now" id="s-now">—</span>
              </div>
              <div class="slip-sub">
                <span class="mono" id="s-credits"></span>
                <span id="s-was"></span>
              </div>
              <span class="promo-chip" id="s-promo" hidden></span>

              <hr class="perf" />
              <dl class="slip-meta">
                <div><dt>{page.slipRegion}</dt><dd id="s-region">{defaultCurrency === 'CNY' ? page.regionCn : page.regionIntl}</dd></div>
                <div><dt>{page.slipMethods}</dt><dd id="s-methods">{defaultCurrency === 'CNY' ? page.cnMethods : page.intlMethods}</dd></div>
              </dl>
              <hr class="perf" />

              <form class="slip-form" id="dew-form" novalidate>
                <label class="slip-label" for="dew-email">{page.emailLabel}</label>
                <input
                  id="dew-email"
                  class="slip-input"
                  type="email"
                  name="email"
                  autocomplete="email"
                  inputmode="email"
                  spellcheck="false"
                  placeholder={page.emailPlaceholder}
                  required
                  aria-describedby="dew-email-hint dew-error"
                />
                <p class="slip-hint" id="dew-email-hint">{page.emailHint}</p>
                <p class="slip-error" id="dew-error" role="alert" hidden></p>
                <button class="btn btn-ink slip-submit" id="dew-submit" type="submit" disabled>
                  <span class="dot" aria-hidden="true"></span>
                  <span class="btn-label">{page.submit}</span>
                </button>
              </form>
              <p class="slip-terms">
                {page.termsNote}
                <a href={`${p('/terms.html')}#sec-3`}>{page.termsLink} →</a>
              </p>
            </div>

            <div class="slip-order" hidden>
              <p class="slip-done" id="o-done" tabindex="-1"><Icon name="check" size={16} stroke={2.4} />{page.orderDone}</p>
              <p class="token-label">{page.tokenLabel}<em>{page.tokenOnce}</em></p>
              <div class="token-box">
                <code id="o-token"></code>
                <button type="button" class="token-copy" id="o-copy">{page.copy}</button>
              </div>
              <p class="hand token-note">{page.tokenNote}</p>

              <dl class="slip-meta order-meta">
                <div><dt>{page.orderNo}</dt><dd class="mono" id="o-id"></dd></div>
                <div><dt>{page.amountLabel}</dt><dd id="o-amount"></dd></div>
                <div id="o-payby-row"><dt>{page.payByLabel}</dt><dd id="o-payby"></dd></div>
                <div id="o-expires-row"><dt>{page.expiresLabel}</dt><dd id="o-expires"></dd></div>
              </dl>
              <p class="order-flag" id="o-promo" hidden>{page.promoUsed}</p>

              <a class="btn btn-ink slip-pay" id="o-pay" href="#" target="_blank" rel="noopener noreferrer">
                <span class="dot" aria-hidden="true"></span>{page.pay}<Icon name="arrowUpRight" size={16} />
              </a>
              <p class="slip-hint">{page.payNote}</p>
              <button type="button" class="slip-restart" id="o-restart">← {page.restart}</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <template id="dew-pack-tpl">
    <label class="pack">
      <input class="pack-input" type="radio" name="dew-pack" />
      <span class="pack-drops" aria-hidden="true"></span>
      <span class="pack-name">
        <span class="pack-qty"><b class="pack-units"></b><span>{page.unit}</span></span>
        <span class="pack-credits mono"></span>
      </span>
      <span class="pack-promo"></span>
      <span class="pack-price"><b class="pack-now"></b><s class="pack-was"></s></span>
      <span class="pack-tick" aria-hidden="true"></span>
    </label>
  </template>

  <!-- After ordering: pay, sign in, paste -->
  <section class="section section--paper2 after-sec" id="after">
    <div class="container after-grid">
      <div class="after-copy">
        <Eyebrow text={page.afterLabel} />
        <h2>{page.afterTitle}</h2>
        <ol class="steps">
          {page.steps.map((step, i) => (
            <li>
              <span class="step-no" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.desc}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="after-note"><Icon name="shield" size={17} />{page.emailNote}</p>
      </div>

      <div class="mock" aria-hidden="true">
        <span class="mock-tag mono">{copy.common.illustrative}</span>
        <div class="mock-card">
          <div class="mock-head">
            <span class="mock-mark"><Logo size={18} /></span>
            <b>{page.appMock.title}</b>
            <span class="mock-balance">{page.appMock.balance}</span>
          </div>
          <p class="mock-hint">{page.appMock.hint}</p>
          <div class="mock-claim">
            <b>{page.appMock.claimTitle}</b>
            <p>{page.appMock.claimHint}</p>
            <div class="mock-row">
              <span class="mock-input">dew_7Kq2·····························Lm</span>
              <span class="mock-btn">{page.appMock.submit}</span>
            </div>
            <p class="mock-ok"><Icon name="check" size={14} stroke={2.4} />{page.appMock.success}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section faq-sec">
    <div class="container">
      <Faq items={page.faq} lang={lang} title={page.faqTitle} />
    </div>
  </section>
</div>

<script type="application/json" id="dew-config" set:html={JSON.stringify(config)}></script>

<script>
  type Plan = {
    bundleId: string;
    units: number;
    credits: number;
    currency: string;
    listAmount: string;
    promoAmount: string;
    promoLabel: string;
    promoLabelEn: string;
    promoAvailable: boolean;
    purchasable?: boolean;
  };
  type PlanSet = { plans: Plan[]; maxUnits: number; founderEmail: string };

  const root = document.querySelector<HTMLElement>('[data-dew]');
  const cfgEl = document.getElementById('dew-config');
  if (root && cfgEl) {
    const cfg = JSON.parse(cfgEl.textContent || '{}');
    const t = cfg.copy as Record<string, string>;
    const zh = cfg.lang === 'zh';
    const byId = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

    const picker = byId<HTMLFieldSetElement>('dew-picker');
    const list = byId('dew-packs');
    const tpl = byId<HTMLTemplateElement>('dew-pack-tpl');
    const status = byId('dew-status');
    const statusText = byId('dew-status-text');
    const retry = byId<HTMLButtonElement>('dew-retry');
    const methods = byId('dew-methods');
    const founder = byId('dew-founder');
    const founderText = byId('dew-founder-text');
    const founderMail = byId<HTMLAnchorElement>('dew-founder-mail');
    const slip = byId('dew-slip');
    const draft = slip.querySelector<HTMLElement>('.slip-draft')!;
    const orderView = slip.querySelector<HTMLElement>('.slip-order')!;
    const form = byId<HTMLFormElement>('dew-form');
    const email = byId<HTMLInputElement>('dew-email');
    const error = byId('dew-error');
    const submit = byId<HTMLButtonElement>('dew-submit');
    const submitLabel = submit.querySelector<HTMLElement>('.btn-label')!;
    const tokenEl = byId('o-token');
    const copyBtn = byId<HTMLButtonElement>('o-copy');
    const payLink = byId<HTMLAnchorElement>('o-pay');
    const restartBtn = byId<HTMLButtonElement>('o-restart');

    const fill = (s: string, vars: Record<string, string | number>) =>
      s.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ''));
    const money = (currency: string, amount: string | number) => `${currency === 'USD' ? '$' : '¥'}${amount}`;
    const credits = (n: number) => `${(n / 1e9).toLocaleString(zh ? 'zh-CN' : 'en-US', { maximumFractionDigits: 1 })}B`;
    const cents = (n: number) => (n % 100 === 0 ? String(n / 100) : (n / 100).toFixed(2));
    const hasCjk = (s: string) => /[㐀-鿿]/.test(s);
    const uuid = () =>
      crypto.randomUUID ? crypto.randomUUID() : `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;

    let currency: string = cfg.defaultCurrency;
    const sets: Record<string, PlanSet> = {};
    let selected: Plan | null = null;
    let token = '';
    let copied = false;
    let lastKey = '';
    let lastRequestId = '';
    let loadSeq = 0;
    let restartArmed = 0;

    /* ── price list ─────────────────────────────────── */
    // 1 dot per Dew, laid out as a growing square: 1, 2×2, 4×4, 8×4, 8×8, 16×8.
    const dropColumns = (n: number) => {
      const k = Math.log2(n);
      return Number.isInteger(k) ? 2 ** Math.ceil(k / 2) : Math.min(16, Math.ceil(Math.sqrt(n * 2)));
    };

    const nowPrice = (plan: Plan) => (plan.promoAvailable ? plan.promoAmount : plan.listAmount);

    const renderPlans = (set: PlanSet) => {
      list.replaceChildren();
      for (const plan of set.plans) {
        const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLLabelElement;
        const input = node.querySelector<HTMLInputElement>('.pack-input')!;
        const label = zh ? plan.promoLabel : plan.promoLabelEn;
        input.value = String(plan.units);
        input.checked = selected?.units === plan.units;
        input.setAttribute(
          'aria-label',
          fill(t.packAria, {
            units: plan.units,
            credits: credits(plan.credits),
            price: `${plan.promoAvailable && label ? `${label} ` : ''}${money(plan.currency, nowPrice(plan))}`,
          })
        );
        input.addEventListener('change', () => select(plan));

        const drops = node.querySelector<HTMLElement>('.pack-drops')!;
        drops.style.setProperty('--cols', String(dropColumns(plan.units)));
        for (let i = 0; i < plan.units; i++) drops.appendChild(document.createElement('i'));

        node.querySelector('.pack-units')!.textContent = String(plan.units);
        node.querySelector('.pack-credits')!.textContent = fill(t.creditsLine, { credits: credits(plan.credits) });
        const promo = node.querySelector<HTMLElement>('.pack-promo')!;
        promo.textContent = plan.promoAvailable ? label : '';
        promo.hidden = !plan.promoAvailable || !label;
        node.querySelector('.pack-now')!.textContent = money(plan.currency, nowPrice(plan));
        const was = node.querySelector<HTMLElement>('.pack-was')!;
        was.textContent = plan.promoAvailable ? money(plan.currency, plan.listAmount) : '';
        was.hidden = !plan.promoAvailable;
        list.appendChild(node);
      }
      list.setAttribute('aria-busy', 'false');
      list.setAttribute('role', 'radiogroup');
      list.setAttribute('aria-labelledby', 'packs-title');
    };

    const setStatus = (text: string, failed = false) => {
      status.hidden = !text;
      statusText.textContent = text;
      retry.hidden = !failed;
    };

    const fetchJson = async (urls: string[], init?: RequestInit) => {
      let lastError: unknown = new Error('network');
      for (const url of urls) {
        const controller = new AbortController();
        const timer = window.setTimeout(() => controller.abort(), 15000);
        try {
          const resp = await fetch(url, { ...init, signal: controller.signal });
          // A 404 means "wrong route prefix" — try the next mount point.
          if (resp.status !== 404) return { resp, data: await resp.json().catch(() => ({})) };
        } catch (err) {
          lastError = err;
        } finally {
          window.clearTimeout(timer);
        }
      }
      throw lastError;
    };

    const loadPlans = async (next: string) => {
      currency = next;
      const seq = ++loadSeq;
      updateRegion();
      if (!sets[next]) {
        list.setAttribute('aria-busy', 'true');
        list.classList.add('is-loading');
        setStatus(t.loading);
        try {
          const { resp, data } = await fetchJson(cfg.plansEndpoints.map((u: string) => `${u}?currency=${next}`));
          if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
          const plans = (Array.isArray(data.plans) ? data.plans : []).filter((plan: Plan) => plan.purchasable !== false);
          if (!plans.length) throw new Error('empty');
          sets[next] = {
            plans,
            maxUnits: Number(data.maxUnits) || plans[plans.length - 1].units,
            founderEmail: data.founderContact?.email || cfg.supportEmail || '',
          };
        } catch {
          if (seq !== loadSeq) return;
          list.classList.remove('is-loading');
          setStatus(t.loadFailed, true);
          selected = null;
          updateSlip();
          return;
        }
      }
      if (seq !== loadSeq) return;
      const set = sets[next];
      list.classList.remove('is-loading');
      setStatus('');
      selected = set.plans.find((plan) => plan.units === selected?.units) ?? set.plans[0];
      renderPlans(set);
      founder.hidden = !set.founderEmail;
      founderText.textContent = fill(t.founderNote, { max: set.maxUnits });
      founderMail.textContent = set.founderEmail;
      founderMail.href = `mailto:${set.founderEmail}`;
      updateSlip();
    };

    const select = (plan: Plan) => {
      selected = plan;
      error.hidden = true;
      updateSlip();
    };

    /* ── order slip ─────────────────────────────────── */
    const updateRegion = () => {
      const cny = currency === 'CNY';
      methods.textContent = cny ? t.cnMethods : t.intlMethods;
      byId('s-region').textContent = cny ? t.regionCn : t.regionIntl;
      byId('s-methods').textContent = cny ? t.cnMethods : t.intlMethods;
      byId('s-code').textContent = `CHRONO DEW · ${currency}`;
    };

    const updateSlip = () => {
      const plan = selected;
      byId('s-units').textContent = plan ? String(plan.units) : '—';
      byId('s-now').textContent = plan ? money(plan.currency, nowPrice(plan)) : '—';
      byId('s-credits').textContent = plan ? fill(t.creditsLine, { credits: credits(plan.credits) }) : '';
      byId('s-was').textContent = plan?.promoAvailable ? fill(t.slipList, { price: money(plan.currency, plan.listAmount) }) : '';
      const promo = byId('s-promo');
      const label = plan ? (zh ? plan.promoLabel : plan.promoLabelEn) : '';
      promo.textContent = label;
      promo.hidden = !plan?.promoAvailable || !label;
      submit.disabled = !plan;
    };

    const showError = (message: string) => {
      error.textContent = message;
      error.hidden = false;
    };

    const reasonOf = (data: any, status: number) => {
      const detail = data?.detail;
      const message = typeof detail === 'string' ? detail : detail?.message || '';
      // Server messages are written in Chinese; the English page falls back to the status code.
      return message && (zh || !hasCjk(message)) ? message : `HTTP ${status}`;
    };

    const formatTime = (iso: string, withDate: boolean) => {
      const date = new Date(iso);
      if (Number.isNaN(date.getTime())) return '';
      const sameDay = date.toDateString() === new Date().toDateString();
      return date.toLocaleString(zh ? 'zh-CN' : 'en-US', {
        ...(withDate || !sameDay ? { month: 'short', day: 'numeric' } : {}),
        hour: '2-digit',
        minute: '2-digit',
      });
    };

    const guardUnload = (event: BeforeUnloadEvent) => {
      if (token && !copied) {
        event.preventDefault();
        event.returnValue = '';
      }
    };

    const showOrder = (data: any) => {
      const order = data.order || {};
      token = String(data.claimToken);
      copied = false;
      tokenEl.textContent = token;
      copyBtn.textContent = t.copy;
      byId('o-id').textContent = order.id || '';
      const amountCents = Number(order.amountCents || 0);
      byId('o-amount').textContent = money(order.currency || currency, cents(amountCents));
      const payBy = order.expiresAt ? formatTime(order.expiresAt, false) : '';
      byId('o-payby-row').hidden = !payBy;
      byId('o-payby').textContent = payBy ? fill(t.payBy, { time: payBy }) : '';
      const expires = data.claimTokenExpiresAt ? formatTime(data.claimTokenExpiresAt, true) : '';
      byId('o-expires-row').hidden = !expires;
      byId('o-expires').textContent = expires;
      byId('o-promo').hidden = data.promoApplied !== false;
      payLink.href = data.checkoutUrl || '#';
      payLink.hidden = !data.checkoutUrl;
      restartBtn.textContent = `← ${t.restart}`;

      draft.hidden = true;
      orderView.hidden = false;
      slip.dataset.state = 'order';
      picker.disabled = true;
      window.addEventListener('beforeunload', guardUnload);
      byId('o-done').focus({ preventScroll: true });
      slip.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest' });
    };

    const resetOrder = () => {
      token = '';
      copied = false;
      restartArmed = 0;
      tokenEl.textContent = '';
      orderView.hidden = true;
      draft.hidden = false;
      slip.dataset.state = 'draft';
      picker.disabled = false;
      window.removeEventListener('beforeunload', guardUnload);
      email.focus();
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!selected) return;
      const address = email.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(address)) {
        email.setAttribute('aria-invalid', 'true');
        showError(t.badEmail);
        email.focus();
        return;
      }
      email.removeAttribute('aria-invalid');
      error.hidden = true;

      // Retrying the same email + pack reuses the request id, so a double click
      // or a dropped connection never opens a second order.
      const key = `${address.toLowerCase()}|${selected.units}|${currency}`;
      if (key !== lastKey) {
        lastKey = key;
        lastRequestId = uuid();
      }

      submit.disabled = true;
      submitLabel.textContent = t.submitting;
      try {
        const { resp, data } = await fetchJson(cfg.checkoutEndpoints, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: address, units: selected.units, currency, clientRequestId: lastRequestId }),
        });
        if (!resp.ok) {
          if (resp.status === 429) showError(t.errRate);
          else if (resp.status === 503) showError(t.errUnavailable);
          else showError(fill(t.errGeneric, { reason: reasonOf(data, resp.status) }));
          return;
        }
        if (!data.claimToken) {
          showError(data.order?.id ? fill(t.alreadyPaid, { id: data.order.id }) : fill(t.errGeneric, { reason: 'no token' }));
          return;
        }
        showOrder(data);
      } catch {
        showError(t.errNetwork);
      } finally {
        submit.disabled = !selected;
        submitLabel.textContent = t.submit;
      }
    });

    email.addEventListener('input', () => {
      if (email.getAttribute('aria-invalid')) {
        email.removeAttribute('aria-invalid');
        error.hidden = true;
      }
    });

    const copyToken = async () => {
      if (!token) return false;
      let ok = false;
      try {
        await navigator.clipboard.writeText(token);
        ok = true;
      } catch {
        const area = document.createElement('textarea');
        area.value = token;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        try {
          ok = document.execCommand('copy');
        } catch {
          ok = false;
        }
        area.remove();
      }
      copied = copied || ok;
      if (copied) window.removeEventListener('beforeunload', guardUnload);
      copyBtn.textContent = ok ? t.copied : t.copyFailed;
      copyBtn.classList.toggle('is-done', ok);
      window.setTimeout(() => {
        copyBtn.textContent = t.copy;
        copyBtn.classList.remove('is-done');
      }, 2200);
      return ok;
    };

    copyBtn.addEventListener('click', () => void copyToken());
    // Paying without the code is the one way to lose a purchase: copy on the way out.
    payLink.addEventListener('click', () => {
      if (!copied) void copyToken();
    });

    restartBtn.addEventListener('click', () => {
      if (token && !copied && !restartArmed) {
        restartBtn.textContent = t.restartConfirm;
        restartArmed = window.setTimeout(() => {
          restartArmed = 0;
          restartBtn.textContent = `← ${t.restart}`;
        }, 4000);
        return;
      }
      window.clearTimeout(restartArmed);
      resetOrder();
    });

    document.querySelectorAll<HTMLInputElement>('input[name="dew-currency"]').forEach((input) => {
      input.addEventListener('change', () => {
        if (input.checked) void loadPlans(input.value);
      });
    });
    retry.addEventListener('click', () => void loadPlans(currency));

    void loadPlans(currency);
  }
</script>

