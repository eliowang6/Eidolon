  .plans-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px 36px;
    margin-top: clamp(32px, 4vw, 48px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .dew-note {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    max-width: 48em;
    font-size: 15px;
    line-height: 1.75;
    color: var(--ink-2);
  }
  .dew-note svg {
    width: 24px;
    height: 24px;
    flex: none;
    margin-top: 1px;
    fill: none;
    stroke: var(--accent-ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dew-note .tlink {
    margin-left: 6px;
  }

  /* ── coming next ────────────────────────────────── */
  .soon {
    padding: 0 0 clamp(72px, 9vw, 128px);
  }
  .soon-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr);
    gap: 24px clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .soon-h {
    margin: 6px 0 12px;
    font-size: inherit;
    line-height: inherit;
  }
  .soon-note {
    font-size: 14px;
    color: var(--ink-3);
  }
  .soon-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .soon-list li {
    display: flex;
    gap: 16px;
    padding: 22px 24px;
    border-radius: var(--r-md);
    border: 1px dashed var(--line-2);
  }
  .soon-ico {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: none;
    border-radius: 13px;
    background: var(--accent-wash);
    color: var(--accent-ink);
  }
  .soon-ico svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .soon-list h3 {
    margin-bottom: 6px;
    font-size: 1.15rem;
  }
  :global(html[lang='en']) .soon-list h3 {
    font-size: 1.35rem;
  }
  .soon-list p {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--ink-2);
  }
  @media (max-width: 900px) {
    .soon-inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .soon-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ── questions ──────────────────────────────────── */
  .ask-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: 32px clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .ask-head {
    position: sticky;
    top: calc(var(--nav-h) + 40px);
  }
  .ask-head h2 {
    margin: 16px 0 26px;
  }
  @media (max-width: 900px) {
    .ask-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .ask-head {
      position: static;
    }
  }

  /* ── checkout dialog ────────────────────────────── */
  .co {
    width: min(460px, calc(100vw - 32px));
    max-width: none;
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--r-lg);
    background: transparent;
    color: var(--ink);
    overflow: visible;
  }
  .co::backdrop {
    background: rgba(14, 17, 49, 0.56);
    backdrop-filter: blur(6px);
  }
  .co[open] .co-card {
    animation: co-in 420ms var(--ease);
  }
  .co[open]::backdrop {
    animation: co-fade 320ms var(--ease);
  }
  @keyframes co-in {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.98);
    }
  }
  @keyframes co-fade {
    from {
      opacity: 0;
    }
  }
  .co-card {
    position: relative;
    display: flex;
    flex-direction: column;
    max-height: calc(100dvh - 32px);
    overflow: auto;
    padding: 34px 32px 28px;
    border-radius: inherit;
    background:
      radial-gradient(90% 60% at 100% 0%, color-mix(in srgb, var(--accent-wash) 80%, transparent), transparent 70%),
      var(--card);
    box-shadow: 0 50px 120px -40px rgba(14, 17, 49, 0.7);
  }
  .co-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--holo);
  }
  .co-x {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-3);
    cursor: pointer;
    transition: background var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
  }
  .co-x:hover {
    background: var(--pearl-2);
    color: var(--ink);
  }
  .co-x svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .co-mark {
    display: inline-flex;
    margin-bottom: 16px;
  }
  .co-title {
    padding-right: 36px;
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2rem);
  }
  .co-sum {
    margin-top: 8px;
    font-family: var(--f-mono);
    font-size: 13.5px;
    color: var(--accent-ink);
  }
  .co-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 18px 0 24px;
    padding: 0;
    list-style: none;
  }
  .co-facts li {
    padding: 4px 10px;
    border-radius: var(--r-full);
    background: var(--pearl);
    border: 1px solid var(--line);
    font-size: 12.5px;
    color: var(--ink-2);
  }
  .co-label {
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 650;
  }
  .co-input {
    width: 100%;
    height: 52px;
    padding: 0 16px;
    border: 1.5px solid var(--line-2);
    border-radius: 14px;
    background: var(--card);
    color: var(--ink);
    font: 500 16px var(--f-body);
    outline: none;
    transition: border-color var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease);
  }
  .co-input::placeholder {
    color: var(--ink-3);
    font-weight: 400;
  }
  .co-input:focus {
    border-color: var(--accent-ink);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 24%, transparent);
  }
  .co-input[aria-invalid='true'] {
    border-color: #c9364f;
    box-shadow: 0 0 0 4px rgba(201, 54, 79, 0.14);
  }
  .co-hint {
    min-height: 1.6em;
