---
import PageHero from '../PageHero.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import Faq from '../Faq.astro';
import { localizePath, t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const page = copy.pricingPage;
const p = (href: string) => localizePath(lang, href);
const firstLabel = (price: string) => copy.common.firstMonth.replace('{price}', price);
---

<PageHero label={page.label} h1a={page.h1} lede={page.lede} />

<section class="section plans-sec">
  <div class="container">
    <div class="billing-header-bar">
      <div class="channel-card">
        <div class="channel-meta">
          <span class="channel-pill">{lang === 'zh' ? '🇨🇳 中国大陆结算区' : '🌐 Global Billing'}</span>
          <span class="channel-type">{lang === 'zh' ? '单月按需购买 · 无自动续费' : 'Monthly Recurring Subscription'}</span>
          <span class="channel-methods">{lang === 'zh' ? '支持 微信支付 · 支付宝 · 银联' : 'Supports Credit Card · Apple Pay · Google Pay'}</span>
        </div>
        <p class="channel-note">
          {lang === 'zh'
            ? '由 Waffo MoR 提供合规担保与支付收银。支持在网页端直接为指定账号开通：已注册账号即时充入；未注册账号以此邮箱注册后自动激活。'
            : 'Powered by Waffo MoR payment gateway. You can subscribe for any account email directly on the web. Activated upon payment.'}
        </p>
      </div>

      <div class="email-sub-panel">
        <div class="email-sub-label-row">
          <label for="sub-account-email" class="email-label">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
            <span>{lang === 'zh' ? '为指定账号邮箱开通' : 'Subscribe for Account Email'}</span>
          </label>
          <span class="email-hint" id="sub-email-hint">
            {lang === 'zh' ? '输入接收订阅的账号邮箱后，点击下方套餐即可直接结账' : 'Enter email, then click any plan below to proceed to checkout'}
          </span>
        </div>
        <div class="email-input-group">
          <input
            id="sub-account-email"
            type="email"
            class="email-sub-input"
            placeholder={lang === 'zh' ? '输入要接收订阅的账号邮箱，例如 user@example.com' : 'Enter recipient account email (e.g. user@example.com)'}
            autocomplete="email"
          />
        </div>
      </div>
    </div>

    <div class="plans">
      {page.plans.map((plan, i) => (
        <article
          class={`plan ${plan.variant === 'night' ? 'plan--night band-night' : ''}`}
          style={`--i:${i}`}
        >
          <span class="greek" aria-hidden="true">{plan.greek}</span>
          {plan.variant === 'night' && <span class="plan-badge">{copy.common.flagship}</span>}
          <h2 class="plan-name">{plan.name}</h2>
          <p class="plan-tag">{plan.tagline}</p>

          <div class="price">
            <span class="cur">{plan.currency}</span>
            <b>{plan.first || plan.price}</b>
            <span class="period">{plan.first ? (lang === 'zh' ? '/ 首月' : '/ 1st mo') : plan.period}</span>
            {plan.first && (
              <span class="price-orig" title={lang === 'zh' ? `正价 ${plan.currency}${plan.price}/月` : `Regular ${plan.currency}${plan.price}/mo`}>
                {plan.currency}{plan.price}
              </span>
            )}
          </div>
          {plan.first && (
            <span class="first-pill first-pill--promo">
              {lang === 'zh' ? `首月特惠 · 续费 ${plan.currency}${plan.price} / 月` : `Intro offer · renews at ${plan.currency}${plan.price}/mo`}
            </span>
          )}
          {plan.bonus && <span class="first-pill first-pill--gift">{plan.bonus}</span>}

          <ul class="plan-features">
            {plan.features.map((feature) => (
              <li><Icon name="check" size={12} stroke={2.4} />{feature}</li>
            ))}
          </ul>

          <div class="plan-cta">
            <button
              type="button"
              class={`btn ${plan.variant === 'night' ? 'btn-ink' : 'btn-ghost'} sub-trigger-btn`}
              data-tier={plan.id}
              data-currency={lang === 'zh' ? 'CNY' : 'USD'}
              data-plan-name={plan.name}
            >
              <span class="btn-text">{plan.cta}</span>
            </button>
            <a href={p('/download.html')} class="plan-download-link">
              {lang === 'zh' ? '在客户端内订阅 →' : 'Subscribe in app →'}
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section section--paper2 upcoming-sec">
  <div class="container">
    <div class="upcoming reveal">
      <div class="up-head">
        <span class="label">{page.upcomingLabel}</span>
      </div>
      <div class="up-grid">
        {page.upcoming.map((item) => (
          <article class="up-card">
            <span class="up-icon"><Icon name={item.icon} size={19} /></span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
      <p class="up-note">{page.upcomingNote}</p>
    </div>
  </div>
</section>

<section class="section faq-sec">
  <div class="container">
    <Faq items={page.faq} lang={lang} title={page.faqTitle} />
  </div>
</section>

<style>
  .plans-sec {
    padding-top: 0;
  }
  .plans {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr)) minmax(0, 1.16fr);
    gap: 12px;
    align-items: stretch;
  }
  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--card);
    padding: 24px 20px 20px;
    min-height: 540px;
  }
  .plan--night {
    border-color: transparent;
  }
  .greek {
    position: absolute;
    top: 4px;
    right: 10px;
    font-family: var(--f-latin-display);
    font-size: clamp(84px, 6.4vw, 100px);
    line-height: 1;
    color: var(--line-2);
    opacity: 0.55;
    pointer-events: none;
    user-select: none;
  }
  .plan--night .greek {
    color: var(--lime);
    opacity: 0.22;
  }
  .plan-badge {
    position: absolute;
    top: 22px;
    left: 20px;
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--lime);
    border: 1px solid rgba(200, 241, 105, 0.4);
    border-radius: var(--r-full);
    padding: 4px 9px;
  }
  .plan-name {
    position: relative;
    font-size: 21px;
    line-height: 1.2;
    margin-top: 104px;
    color: var(--ink);
  }
  .plan--night .plan-name {
    color: var(--night-text);
  }
  html[lang="en"] .plan-name {
    font-size: 25px;
  }
  .plan-tag {
    position: relative;
    margin-top: 10px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--ink-2);
    min-height: 4.8em;
    text-wrap: pretty;
  }
  .plan--night .plan-tag {
    color: var(--night-dim);
  }
  .price {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 3px;
    margin-top: 18px;
    color: var(--ink);
  }
  .plan--night .price {
    color: var(--lime);
  }
  .cur {
    font-size: 20px;
    font-family: var(--f-latin-display);
    transform: translateY(-8px);
  }
  .price b {
    font-family: var(--f-latin-display);
    font-weight: 400;
    font-size: clamp(2.8rem, 2.3rem + 1.4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .period {
    font-size: 13px;
    color: var(--ink-3);
    margin-left: 3px;
  }
  .plan--night .period {
    color: var(--night-dim);
  }
  .price-orig {
    font-size: 15px;
    color: var(--ink-3);
    text-decoration: line-through;
    margin-left: 6px;
    font-family: var(--f-latin-display);
    opacity: 0.65;
    align-self: center;
    transform: translateY(-2px);
  }
  .plan--night .price-orig {
    color: var(--night-dim);
  }
  .first-pill {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    margin-top: 10px;
    padding: 3px 9px;
    border-radius: var(--r-full);
    background: var(--sage-wash);
    color: color-mix(in srgb, var(--sage-deep) 78%, var(--ink));
    font-size: 12px;
    letter-spacing: 0.02em;
  }
  .plan--night .first-pill {
    background: rgba(200, 241, 105, 0.14);
    color: var(--lime);
  }
  .first-pill--promo {
    background: color-mix(in srgb, var(--sage-wash) 90%, var(--card));
    border: 1px solid color-mix(in srgb, var(--sage-deep) 25%, transparent);
    font-weight: 500;
  }
  .first-pill--gift {
    background: transparent;
    border: 1px dashed color-mix(in srgb, var(--sage-deep) 45%, transparent);
  }
  .plan--night .first-pill--gift {
    border-color: rgba(200, 241, 105, 0.4);
  }
  .plan-features {
    position: relative;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    display: grid;
    align-content: start;
    gap: 10px;
    flex: 1;
  }
  .plan--night .plan-features {
    border-color: var(--night-line);
  }
  .plan-features li {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .plan--night .plan-features li {
    color: var(--night-dim);
  }
  .plan-features :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--sage-deep);
  }
  .plan--night .plan-features :global(svg) {
    color: var(--lime);
  }
  .plan-cta {
    position: relative;
    margin-top: 22px;
  }
  .plan-cta :global(.btn) {
    width: 100%;
    justify-content: center;
    font-size: 13.5px;
    padding-inline: 8px;
  }
  .upcoming {
    border-radius: var(--r-xl);
    background: var(--sage-wash);
    padding: clamp(30px, 4vw, 48px);
  }
  .up-head {
    margin-bottom: 22px;
  }
  .up-head .label {
    color: var(--sage-deep);
  }
  .up-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .up-card {
    border: 1px solid rgba(79, 127, 116, 0.22);
    border-radius: 16px;
    padding: 22px;
    background: color-mix(in srgb, var(--card) 60%, transparent);
  }
  .up-icon {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    display: grid;
    place-items: center;
    background: var(--card);
    color: var(--sage-deep);
    margin-bottom: 16px;
  }
  .up-card h3 {
    font-size: 19px;
    margin-bottom: 6px;
  }
  html[lang="en"] .up-card h3 {
    font-size: 23px;
  }
  .up-card p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-2);
  }
  .up-note {
    margin-top: 22px;
    font-size: 12.5px;
    color: var(--sage-deep);
  }

  .billing-header-bar {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 24px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--card);
    padding: 20px 24px;
  }
  .channel-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .channel-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .channel-pill {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: var(--r-full);
    background: var(--lime);
    color: #111;
    font-size: 12px;
    font-weight: 600;
  }
  .channel-type {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }
  .channel-methods {
    font-size: 12.5px;
    color: var(--ink-2);
    padding-left: 8px;
    border-left: 1px solid var(--line);
  }
  .channel-note {
    font-size: 12.5px;
    color: var(--ink-3);
    line-height: 1.5;
    margin: 0;
  }
  .email-sub-panel {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .email-sub-label-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }
  .email-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }
  .email-hint {
    font-size: 12px;
    color: var(--ink-3);
  }
  .email-hint.hint-error {
    color: #e04545;
    font-weight: 600;
  }
  .email-input-group {
    width: 100%;
  }
  .email-sub-input {
    width: 100%;
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper);
    color: var(--ink);
    font-size: 14px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .email-sub-input:focus {
    border-color: var(--ink);
    box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.08);
  }
  .email-sub-input.input-error {
    border-color: #e04545;
    box-shadow: 0 0 0 2px rgba(224, 69, 69, 0.2);
  }
  .plan-cta {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: stretch;
  }
  .sub-trigger-btn {
    width: 100%;
    cursor: pointer;
  }
  .plan-download-link {
    display: inline-block;
    text-align: center;
    font-size: 11.5px;
    color: var(--ink-3);
    text-decoration: none;
    transition: color 0.18s ease;
  }
  .plan-download-link:hover {
    color: var(--ink);
  }

  @media (max-width: 1279px) {
    .plans {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }
    .plan {
      min-height: 0;
    }
  }
  @media (max-width: 1023px) {
    .plans {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .plans {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding: 4px var(--gutter) 18px;
      scrollbar-width: none;
    }
    .plans::-webkit-scrollbar {
      display: none;
    }
    .plan {
      flex: 0 0 84vw;
      scroll-snap-align: center;
    }
    .greek {
      font-size: 96px;
    }
    .up-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const emailInput = document.getElementById('sub-account-email') as HTMLInputElement | null;
  const hintEl = document.getElementById('sub-email-hint');
  const triggerBtns = document.querySelectorAll<HTMLButtonElement>('.sub-trigger-btn');

  const API_ENDPOINT = 'https://api.eidolon.instarmony.com/eidolon/api/subscription/checkout-public';

  triggerBtns.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = (emailInput?.value || '').trim();
      const isZh = btn.dataset.currency === 'CNY';

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (emailInput) {
          emailInput.focus();
          emailInput.classList.add('input-error');
          setTimeout(() => emailInput.classList.remove('input-error'), 2000);
        }
        if (hintEl) {
          hintEl.textContent = isZh
            ? '⚠️ 请先输入有效的接收账号邮箱地址'
            : '⚠️ Please enter a valid account email first';
          hintEl.classList.add('hint-error');
        }
        return;
      }

      if (hintEl) {
        hintEl.textContent = isZh
          ? `正在为 ${email} 创建收银会话…`
          : `Creating checkout session for ${email}…`;
        hintEl.classList.remove('hint-error');
      }

      const tierId = btn.dataset.tier || 'spark';
      const currency = btn.dataset.currency || 'CNY';
      const originalText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = `<span class="btn-text">${isZh ? '正在跳转收银台…' : 'Redirecting…'}</span>`;

      try {
        let resp: Response | null = null;
        let lastErr: any = null;
        const endpoints = [
          'https://api.eidolon.instarmony.com/subscription/checkout-public',
          'https://api.eidolon.instarmony.com/eidolon/api/subscription/checkout-public',
        ];

        for (const ep of endpoints) {
          try {
            const r = await fetch(ep, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                email,
                tierId,
                currency,
              }),
            });
            if (r.ok || r.status !== 404) {
              resp = r;
              break;
            }
          } catch (e) {
            lastErr = e;
          }
        }

        if (!resp) {
          throw lastErr || new Error('网络请求失败');
        }

        if (!resp.ok) {
          const errData = await resp.json().catch(() => ({}));
          throw new Error(errData.detail || `HTTP ${resp.status}`);
        }

        const data = await resp.json();
        if (data.checkoutUrl) {
          window.location.href = data.checkoutUrl;
        } else {
          throw new Error('未获取到有效收银台链接');
        }
      } catch (err: any) {
        alert((isZh ? '发起结算失败：' : 'Failed to start checkout: ') + (err?.message || err));
        btn.disabled = false;
        btn.innerHTML = originalText;
        if (hintEl) {
          hintEl.textContent = isZh
            ? '输入接收订阅的账号邮箱后，点击下方套餐即可直接结账'
            : 'Enter email, then click any plan below to proceed to checkout';
        }
      }
    });
  });
</script>
