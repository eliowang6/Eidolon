---
/**
 * Plans. The masthead reads the five plans as depths — rings spreading from the ∞ —
 * and every card carries the same gauge, lit to its own depth. Checkout is plan-first:
 * a plan's button opens one dialog that asks which account to add it to, then hands
 * off to the hosted cashier (endpoints and payload unchanged from the old page).
 */
import CtaBand from '../CtaBand.astro';
import Eyebrow from '../Eyebrow.astro';
import Faq from '../Faq.astro';
import Logo from '../Logo.astro';
import PageHero from '../PageHero.astro';
import { SITE } from '../../config/site';
import { localizePath, pr, prPlain, t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const page = copy.pricingPage;
const co = page.checkout;
const p = (href: string) => localizePath(lang, href);
const currencyCode = lang === 'zh' ? 'CNY' : 'USD';

/* gauge radii: hero (viewBox 560, centre 280) and card badge (viewBox 76, centre 38) */
const RINGS = [56, 104, 152, 200, 248];
const BADGE = [14, 19.5, 25, 30.5, 36];

const plans = page.plans.map((plan, i) => {
  const [latin, ...rest] = plan.name.split(' ');
  const regular = `${plan.currency}${plan.price}`;
  const summary = [
    plan.first
      ? `${page.firstTag} ${plan.currency}${plan.first} · ${page.then.replace('{price}', regular)}`
      : `${regular} ${plan.period}`,
    plan.bonus,
  ]
    .filter(Boolean)
    .join(' · ');
  return {
    ...plan,
    latin,
    local: rest.join(' '),
    depth: i + 1,
    regular,
    summary,
    depthLabel: page.depth.replace('{n}', String(i + 1)),
    // zh Fable is opened with the founder rather than at the cashier
    contactOnly: lang === 'zh' && plan.id === 'fable',
  };
});
const grid = plans.filter((plan) => plan.variant !== 'night');
const fable = plans.find((plan) => plan.variant === 'night')!;
const fableMail = `mailto:${SITE.founder.email}?subject=${encodeURIComponent(page.fableMail)}`;

/** "轻语心智：日常搭话" → lead term set apart from the rest. */
const splitFeature = (text: string) => {
  const m = text.match(/^([^：:]{2,16})(：|: )(.+)$/);
  return m ? { lead: m[1], sep: m[2], rest: m[3] } : { lead: '', sep: '', rest: text };
};

const ICON = {
  calendar: '<rect x="3.5" y="5" width="17" height="15.5" rx="3"/><path d="M3.5 10h17M8.5 3v4M15.5 3v4"/>',
  card: '<rect x="2.5" y="5" width="19" height="14" rx="3"/><path d="M2.5 10h19M6.5 15h4"/>',
  tick: '<path d="m5 12.5 4.3 4.3L19 7.2"/>',
  glass: '<path d="M6.5 3h11M6.5 21h11M8 3v2.6c0 2.6 4 4.1 4 6.4s-4 3.8-4 6.4V21M16 3v2.6c0 2.6-4 4.1-4 6.4s4 3.8 4 6.4V21"/>',
  drop: '<path d="M12 3s6.2 6.8 6.2 11.3a6.2 6.2 0 0 1-12.4 0C5.8 9.8 12 3 12 3Z"/><path d="M9.2 14.6a2.9 2.9 0 0 0 2.6 2.6"/>',
  mail: '<rect x="2.5" y="4.5" width="19" height="15" rx="3"/><path d="m3.5 6.5 8.5 6.3 8.5-6.3"/>',
  palette:
    '<path d="M12 21.5a9.5 9.5 0 1 1 9.5-9.5c0 2.6-2 3.9-3.9 3.9h-1.8a1.7 1.7 0 0 0-1.3 2.8 1.7 1.7 0 0 1-1.3 2.8H12Z"/><circle cx="7.6" cy="11" r="1.1"/><circle cx="10.6" cy="7" r="1.1"/><circle cx="15.4" cy="7.6" r="1.1"/>',
  bolt: '<path d="M13.2 2.5 4.8 13.4h6.6l-.6 8.1 8.4-10.9h-6.6l.6-8.1Z"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
} as const;
const upcomingIcon = (name: string) => (name === 'palette' ? ICON.palette : ICON.bolt);
const facts = [
  { key: 'region', text: co.region },
  { key: 'terms', text: co.terms },
  { key: 'methods', text: co.methods },
];
---

<PageHero class="price-head" label={page.label} h1a={page.h1} lede={page.lede}>
  <ul class="bill reveal" style="--i:3" aria-label={co.title}>
    {
      facts.map((fact) => (
        <li>
          {fact.key === 'region' ? (
            <span class="bill-cur" aria-hidden="true">
              {grid[0].currency}
            </span>
          ) : (
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={fact.key === 'terms' ? ICON.calendar : ICON.card} />
          )}
          <span>{fact.text}</span>
        </li>
      ))
    }
  </ul>

  <nav class="gauge reveal" style="--i:2" aria-label={page.gauge}>
    <svg class="g-svg" viewBox="0 0 560 560" aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="g-core-glow">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.5" />
          <stop offset="0.4" stop-color="#cdb6ff" stop-opacity="0.28" />
          <stop offset="1" stop-color="#cdb6ff" stop-opacity="0" />
        </radialGradient>
      </defs>
      <circle cx="280" cy="280" r="110" fill="url(#g-core-glow)" />
      <circle class="g-wave" cx="280" cy="280" r="248" />
      <circle class="g-wave g-wave--late" cx="280" cy="280" r="248" />
      {RINGS.map((r, k) => <circle class="g-ring" cx="280" cy="280" r={r} style={`--k:${k}`} />)}
      <line class="g-plumb" x1="280" y1="300" x2="280" y2="528" />
    </svg>
    <span class="g-core" aria-hidden="true"><Logo size={58} stroke={1.8} /></span>
    <ol class="g-pins">
      {
        plans.map((plan, k) => (
          <li style={`--k:${k};--y:${(((280 + RINGS[k]) / 560) * 100).toFixed(2)}%`}>
            <a class="g-pin" href={`#${plan.id}`} data-k={k + 1}>
              <span class="g-dot" aria-hidden="true" />
              <span class="g-glyph" aria-hidden="true">
                {plan.greek}
              </span>
              <span class="g-name">
                <span lang="en">{plan.latin}</span>
                {plan.local && <span class="g-local">{plan.local}</span>}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</PageHero>

<!-- ── the five plans ─────────────────────────────────── -->
<section class="section plans-sec" aria-labelledby="plans-h">
  <div class="container">
    <h2 id="plans-h" class="sr-only">{page.plansH}</h2>
    <ol class="plans">
      {
        grid.map((plan, i) => (
          <li
            class:list={['plan reveal', plan.id === 'spark' && 'plan--start']}
            id={plan.id}
            style={`--i:${i}`}
            aria-labelledby={`${plan.id}-name`}
          >
            <div class="plan-top">
              <span class="badge" aria-hidden="true">
                <svg viewBox="0 0 76 76" focusable="false">
                  {BADGE.map((r, k) => (
                    <circle class:list={['b-ring', k < plan.depth && 'is-lit']} cx="38" cy="38" r={r} style={`--k:${k}`} />
                  ))}
                  <text class="b-glyph" x="38" y="39">
                    {plan.greek}
                  </text>
                </svg>
              </span>
              <span class="plan-depth">{plan.depthLabel}</span>
              {plan.id === 'spark' && <span class="plan-start">{page.startHere}</span>}
            </div>

            <h3 class="plan-name" id={`${plan.id}-name`}>
              <span class="pn-latin" lang="en">
                {plan.latin}
              </span>
              {plan.local && <span class="pn-local">{plan.local}</span>}
            </h3>
            <p class="plan-tag">{plan.tagline}</p>

            <div class="plan-price" data-whisper={plan.id === 'spark' ? 'pricing' : undefined}>
              <p class="pp-main">
                <span class="pp-cur">{plan.currency}</span>
                <span class="pp-num">{plan.first || plan.price}</span>
                {plan.first ? (
                  <span class="pp-first">{page.firstTag}</span>
                ) : (
                  <span class="pp-per">{plan.period}</span>
                )}
              </p>
              <p class="pp-sub">
                {plan.first ? (
                  page.then.replace('{price}', plan.regular)
                ) : plan.bonus ? (
                  <span class="pp-bonus">
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.glass} />
                    {plan.bonus}
                  </span>
                ) : null}
              </p>
            </div>

            <p class="plan-model">
              <span>{page.modelLabel}</span>
              <b>{plan.model}</b>
            </p>

            <ul class="plan-feats">
              {plan.features.map((feature) => {
                const f = splitFeature(feature);
                return (
                  <li>
                    <svg class="tick" viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.tick} />
                    <span>{f.lead && <b>{f.lead}</b>}{f.sep}{f.rest}</span>
                  </li>
                );
              })}
            </ul>

            <button
              type="button"
              class:list={['btn plan-cta sub-trigger-btn', plan.id === 'spark' ? 'btn-holo' : 'btn-ink']}
              data-tier={plan.id}
              data-currency={currencyCode}
              data-plan-name={plan.name}
              data-plan-sum={plan.summary}
              aria-haspopup="dialog"
            >
              {plan.cta}
            </button>
          </li>
        ))
      }
    </ol>

    <article class="fable band-night stars reveal" id={fable.id} aria-labelledby={`${fable.id}-name`}>
      <div class="fable-badge" aria-hidden="true">
        <svg viewBox="0 0 76 76" focusable="false">
          <circle class="f-wave" cx="38" cy="38" r="36" />
          {BADGE.map((r, k) => <circle class="b-ring is-lit" cx="38" cy="38" r={r} style={`--k:${k}`} />)}
          <text class="b-glyph" x="38" y="39">
            {fable.greek}
          </text>
        </svg>
      </div>

      <div class="fable-main">
        <span class="plan-depth">{fable.depthLabel}</span>
        <h3 class="plan-name" id={`${fable.id}-name`}>
          <span class="pn-latin" lang="en">
            {fable.latin}
          </span>
          {fable.local && <span class="pn-local">{fable.local}</span>}
        </h3>
        <p class="plan-tag">{fable.tagline}</p>
        <div class="plan-price">
          <p class="pp-main">
            <span class="pp-cur">{fable.currency}</span>
            <span class="pp-num">{fable.price}</span>
            <span class="pp-per">{fable.period}</span>
          </p>
          {
            fable.bonus && (
              <p class="pp-sub">
                <span class="pp-bonus">
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.glass} />
                  {fable.bonus}
                </span>
              </p>
            )
          }
        </div>
        <p class="plan-model">
          <span>{page.modelLabel}</span>
          <b>{fable.model}</b>
        </p>
      </div>

      <div class="fable-side">
        <ul class="plan-feats">
          {
            fable.features.map((feature) => {
              const f = splitFeature(feature);
              return (
                <li>
                  <svg class="tick" viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.tick} />
                  <span>{f.lead && <b>{f.lead}</b>}{f.sep}{f.rest}</span>
                </li>
              );
            })
          }
        </ul>
        {
          fable.contactOnly ? (
            <div class="fable-act">
              <a class="btn btn-holo btn-lg plan-cta" href={fableMail}>
                <svg class="btn-ico" viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.mail} />
                {fable.cta}
              </a>
              <span class="fable-addr">{SITE.founder.email}</span>
            </div>
          ) : (
            <div class="fable-act">
              <button
                type="button"
                class="btn btn-holo btn-lg plan-cta sub-trigger-btn"
                data-tier={fable.id}
                data-currency={currencyCode}
                data-plan-name={fable.name}
                data-plan-sum={fable.summary}
                aria-haspopup="dialog"
              >
                {fable.cta}
              </button>
            </div>
          )
        }
      </div>
    </article>

    <div class="plans-foot reveal">
      <p class="dew-note">
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.drop} />
        <span>
          {page.dew.text}
          <a class="tlink" href={p('/dew.html')}>{page.dew.link}</a>
        </span>
      </p>
      <a class="tlink" href={p('/download.html')}>{page.appLink}</a>
    </div>
  </div>
</section>

<!-- ── coming next ───────────────────────────────────── -->
<section class="soon" aria-labelledby="soon-h">
  <div class="container soon-inner">
    <div class="soon-head reveal">
      <h2 id="soon-h" class="soon-h">
        <Eyebrow text={lang === 'zh' ? `${page.upcomingLabel} / Coming soon` : page.upcomingLabel} />
      </h2>
      <p class="soon-note">{page.upcomingNote}</p>
    </div>
    <ul class="soon-list">
      {
        page.upcoming.map((item, i) => (
          <li class="reveal" style={`--i:${i + 1}`}>
            <span class="soon-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" set:html={upcomingIcon(item.icon)} />
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- ── questions ─────────────────────────────────────── -->
<section class="section section--paper2 ask" aria-labelledby="faq-h">
  <div class="container ask-grid">
    <div class="ask-head reveal">
      <Eyebrow text={lang === 'zh' ? `${copy.footer.faq} / FAQ` : copy.footer.faq} />
      <h2 id="faq-h" set:html={prPlain(page.faqTitle)} />
      <a class="tlink" href={`mailto:${SITE.contactEmail}`}>{page.faqMore} →</a>
    </div>
    <Faq items={page.faq} lang={lang} />
  </div>
</section>

<CtaBand lang={lang} h2={page.cta.h2} lede={page.cta.lede} secondary="features" />

<!-- ── checkout: one dialog for every plan ───────────── -->
<dialog
  class="co"
  id="checkout"
  aria-labelledby="co-title"
  data-title={co.dialogTitle}
  data-hint={co.hint}
  data-invalid={co.invalid}
  data-creating={co.creating}
  data-redirecting={co.redirecting}
  data-failed={co.failed}
  data-go={co.go}
>
  <form class="co-card" novalidate>
    <button class="co-x" type="button" data-co-close aria-label={co.close}>
      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.close} />
    </button>
    <span class="co-mark" aria-hidden="true"><Logo size={34} stroke={1.8} /></span>
    <h2 class="co-title" id="co-title" data-co-title>{co.title}</h2>
    <p class="co-sum" data-co-sum></p>
    <ul class="co-facts">
      {facts.map((fact) => <li>{fact.text}</li>)}
    </ul>
    <label class="co-label" for="sub-account-email">{co.emailLabel}</label>
    <input
      class="co-input"
      id="sub-account-email"
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      autocapitalize="off"
      spellcheck="false"
      required
      placeholder={co.placeholder}
      aria-describedby="sub-email-hint"
    />
    <p class="co-hint" id="sub-email-hint" aria-live="polite">{co.hint}</p>
    <button class="btn btn-holo btn-lg co-go" type="submit" data-co-go>{co.go}</button>
    <p class="co-note">{co.note}</p>
  </form>
</dialog>

<style>
  /* ── masthead ───────────────────────────────────── */
  .bill {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 26px;
    margin: 34px 0 0;
    padding: 0;
    list-style: none;
  }
  .bill li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14.5px;
    color: var(--night-dim);
  }
  .bill svg {
    width: 19px;
    height: 19px;
    flex: none;
    fill: none;
    stroke: var(--accent-ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .bill-cur {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    flex: none;
    border-radius: 50%;
    border: 1.5px solid var(--accent-ink);
    color: var(--accent-ink);
    font: 700 11px/1 var(--f-body);
  }

  /* the depth gauge: five rings spreading from the ∞, one pin per plan */
  .gauge {
    display: none;
  }
  .g-svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .g-ring {
    --on: clamp(0, var(--lit, 0) - var(--k), 1);
    fill: none;
    stroke: color-mix(in oklab, #f8a8d0 calc(100% - var(--k) * 25%), #92c6ff);
    stroke-opacity: calc(0.42 + var(--on) * 0.58);
    stroke-width: calc(1.2px + var(--on) * 1.2px);
    vector-effect: non-scaling-stroke;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 1.4s var(--ease) calc(var(--k) * 110ms),
      opacity 1.4s var(--ease) calc(var(--k) * 110ms),
      stroke-opacity var(--t-fast) var(--ease),
      stroke-width var(--t-fast) var(--ease);
  }
  .g-wave {
    fill: none;
    stroke: #cdb6ff;
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    animation: g-wave 8s cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
  }
  .g-wave--late {
    animation-delay: 4s;
  }
  @keyframes g-wave {
    0% {
      transform: scale(0.18);
      opacity: 0;
    }
    12% {
      opacity: 0.55;
    }
    100% {
      transform: scale(1.04);
      opacity: 0;
    }
  }
  .g-plumb {
    stroke: rgba(238, 240, 255, 0.24);
    stroke-width: 1;
    stroke-dasharray: 2 6;
    vector-effect: non-scaling-stroke;
  }
  .g-core {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: inline-flex;
    filter: drop-shadow(0 0 14px rgba(205, 182, 255, 0.7));
  }
  .g-pins {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .g-pins li {
    --tint: color-mix(in oklab, #f8a8d0 calc(100% - var(--k) * 25%), #92c6ff);
    position: absolute;
    left: 50%;
    top: var(--y);
    transition:
      opacity 700ms var(--ease) calc(650ms + var(--k) * 90ms),
      translate 700ms var(--ease) calc(650ms + var(--k) * 90ms);
  }
  .g-pin {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    translate: -8px -50%;
    color: var(--night-text);
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--r-full);
  }
  .g-dot {
    width: 16px;
    height: 16px;
    flex: none;
    border-radius: 50%;
    background: var(--night);
    border: 2px solid var(--tint);
    box-shadow: 0 0 0 4px rgba(14, 17, 49, 0.85);
    transition: background var(--t-fast) var(--ease);
  }
  .g-glyph {
    min-width: 0.9em;
    font-family: var(--f-latin-display);
    font-style: italic;
    font-size: 19px;
    line-height: 1;
    color: var(--tint);
    text-align: center;
  }
  .g-name {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 5px 12px;
    border-radius: var(--r-full);
    border: 1px solid var(--night-line);
    background: rgba(14, 17, 49, 0.78);
    font-size: 14px;
    font-weight: 600;
    transition: border-color var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
  }
  .g-local {
    font-weight: 500;
    color: var(--night-dim);
  }
  .g-pin:is(:hover, :focus-visible) .g-name {
    border-color: var(--tint);
    background: rgba(35, 42, 102, 0.9);
  }
  .g-pin:is(:hover, :focus-visible) .g-dot {
    background: var(--tint);
  }
  .gauge:has([data-k='1']:is(:hover, :focus-visible)) {
    --lit: 1;
  }
  .gauge:has([data-k='2']:is(:hover, :focus-visible)) {
    --lit: 2;
  }
  .gauge:has([data-k='3']:is(:hover, :focus-visible)) {
    --lit: 3;
  }
  .gauge:has([data-k='4']:is(:hover, :focus-visible)) {
    --lit: 4;
  }
  .gauge:has([data-k='5']:is(:hover, :focus-visible)) {
    --lit: 5;
  }
  :global(html.js) .gauge:not(.in) .g-ring {
    transform: scale(0.55);
    opacity: 0;
  }
  :global(html.js) .gauge:not(.in) .g-pins li {
    opacity: 0;
    translate: -10px 0;
  }
  @media (min-width: 1040px) {
    .gauge {
      display: block;
      position: absolute;
      right: calc(var(--gutter) + 3%);
      top: 50%;
      width: min(500px, 36vw);
      aspect-ratio: 1;
      translate: 0 -50%;
    }
    :global(.price-head .ph-sky) {
      display: none;
    }
    :global(.price-head.page-head) {
      padding-bottom: clamp(96px, 9vw, 140px);
    }
    :global(html[lang] .price-head.page-head .ph-inner > h1),
    :global(html[lang] .price-head.page-head .ph-inner > .lede) {
      max-width: min(56%, 36em);
    }
    :global(html[lang='zh'] .price-head.page-head .ph-inner > h1) {
      font-size: clamp(2.5rem, 1.6rem + 2.9vw, 4.4rem);
    }
    :global(html[lang='en'] .price-head.page-head .ph-inner > h1) {
      font-size: clamp(2.7rem, 1.5rem + 3vw, 4.5rem);
    }
    .bill {
      max-width: 56%;
    }
  }

  /* ── plans ──────────────────────────────────────── */
  .plans-sec {
    padding-top: clamp(56px, 6vw, 92px);
  }
  .plans {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(14px, 1.5vw, 20px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 26px 24px 24px;
    border-radius: var(--r-lg);
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: var(--sh-1);
    scroll-margin-top: calc(var(--nav-h) + 28px);
    transition:
      translate var(--t-fast) var(--ease),
      box-shadow var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease);
  }
  /* every card shares the same seven rows, so the prices, models and buttons line up across a row */
  @supports (grid-template-rows: subgrid) {
    .plan {
      display: grid;
      grid-row: span 7;
      grid-template-rows: subgrid;
      row-gap: 0;
    }
    .plan .plan-cta {
      align-self: end;
    }
  }
  .plan:hover {
    translate: 0 -4px;
    box-shadow: var(--sh-2);
  }
  .plan--start {
    border: 1.5px solid transparent;
    background:
      linear-gradient(var(--card), var(--card)) padding-box,
      var(--holo) border-box;
  }
  .plan:target {
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--accent) 34%, transparent),
      var(--sh-2);
  }

  .plan-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .badge {
    width: 58px;
    height: 58px;
    flex: none;
  }
  .badge svg,
  .fable-badge svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .b-ring {
    fill: none;
    stroke: var(--line-2);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .b-ring.is-lit {
    stroke: color-mix(in oklab, var(--fea) calc(100% - var(--k) * 25%), var(--ael));
    stroke-width: 1.8;
  }
  .b-glyph {
    font-family: var(--f-latin-display);
    font-style: italic;
    font-size: 17px;
    fill: var(--ink);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .plan-depth {
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-3);
  }
  .plan-start {
    position: absolute;
    top: 0;
    right: 22px;
    translate: 0 -50%;
    padding: 5px 12px;
    border-radius: var(--r-full);
    background: var(--holo);
    color: #141838;
    font-size: 12.5px;
    font-weight: 650;
    white-space: nowrap;
    box-shadow: 0 8px 18px -10px rgba(146, 120, 230, 0.8);
  }

  .plan-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
    margin: 0 0 10px;
  }
  .pn-latin {
    font-family: var(--f-latin-display);
    font-size: 2.15rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.012em;
  }
  .pn-local {
    font-family: var(--f-zh-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink-2);
  }
  .plan-tag {
    margin-bottom: 22px;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .plan-price {
    margin-bottom: 18px;
  }
  .pp-main {
    display: flex;
    align-items: baseline;
    gap: 3px;
    color: var(--ink);
    line-height: 1;
  }
  .pp-cur {
    align-self: flex-start;
    margin-top: 0.45em;
    font-family: var(--f-body);
    font-size: 1.2rem;
    font-weight: 500;
  }
  .pp-num {
    font-family: var(--f-latin-display);
    font-size: clamp(2.9rem, 2.3rem + 1.3vw, 3.7rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    /* a text-size cut: display-size hairlines turn "149" into "1 19" */
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 20;
  }
  .pp-per {
    margin-left: 5px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink-3);
  }
  .pp-first {
    align-self: center;
    margin-left: 9px;
    padding: 4px 10px;
    border-radius: var(--r-full);
    background: var(--accent-wash);
    color: var(--accent-ink);
    font-size: 12.5px;
    font-weight: 650;
  }
  .pp-sub {
    display: flex;
    align-items: center;
    margin-top: 10px;
    font-size: 13.5px;
    color: var(--ink-3);
  }
  .pp-bonus {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 11px 4px 9px;
    border-radius: var(--r-full);
    border: 1px dashed color-mix(in srgb, var(--accent-ink) 45%, transparent);
    color: var(--accent-ink);
    font-size: 12.5px;
    font-weight: 600;
  }
  .pp-bonus svg {
    width: 14px;
    height: 14px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .plan-model {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-bottom: 18px;
    padding: 12px 0;
    border-block: 1px solid var(--line);
  }
  .plan-model span {
    font-size: 12px;
    color: var(--ink-3);
  }
  .plan-model b {
    font-family: var(--f-mono);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink);
  }

  .plan-feats {
    display: grid;
    align-content: start;
    gap: 10px;
    margin: 0 0 26px;
    padding: 0;
    list-style: none;
  }
  .plan-feats li {
    display: flex;
    gap: 9px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .plan-feats b {
    font-weight: 650;
    color: var(--ink);
  }
  .tick {
    width: 16px;
    height: 16px;
    flex: none;
    margin-top: 2px;
    fill: none;
    stroke: var(--accent-ink);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .plan-cta {
    width: 100%;
    margin-top: auto;
  }
  @media (max-width: 1179px) {
    .plans {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 680px) {
    .plans {
      grid-template-columns: minmax(0, 1fr);
    }
    .plan {
      padding: 24px 22px 22px;
    }
  }

  /* Fable: the deepest ring, at night */
  .fable {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: 28px clamp(28px, 4vw, 64px);
    margin-top: clamp(14px, 1.5vw, 20px);
    padding: clamp(30px, 4vw, 52px);
    border-radius: var(--r-xl);
    scroll-margin-top: calc(var(--nav-h) + 28px);
    background:
      radial-gradient(55% 120% at 0% 0%, rgba(239, 143, 187, 0.24), transparent 62%),
      radial-gradient(55% 120% at 100% 100%, rgba(110, 169, 242, 0.26), transparent 62%),
      var(--night);
    box-shadow: var(--sh-2);
  }
  .fable::after {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1.5px;
    border-radius: inherit;
    background: var(--holo);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.75;
    pointer-events: none;
  }
  .fable:target {
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--accent) 40%, transparent),
      var(--sh-2);
  }
  .fable-badge {
    position: relative;
    width: clamp(120px, 12vw, 168px);
    aspect-ratio: 1;
    filter: drop-shadow(0 0 22px rgba(205, 182, 255, 0.35));
  }
  .fable .b-ring.is-lit {
    stroke: color-mix(in oklab, #f8a8d0 calc(100% - var(--k) * 25%), #92c6ff);
    stroke-width: 1.6;
  }
  .fable .b-glyph {
    font-size: 15px;
    fill: var(--night-text);
  }
  .f-wave {
    fill: none;
    stroke: #cdb6ff;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    animation: g-wave 6s cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
  }
  .fable-main .plan-depth {
    display: block;
    margin-bottom: 14px;
    color: var(--night-faint);
  }
  .fable .pn-latin {
    font-size: clamp(2.4rem, 1.9rem + 1.4vw, 3.2rem);
  }
  .fable .plan-tag {
    margin-bottom: 20px;
    max-width: 26em;
  }
  .fable .plan-model {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: 0;
  }
  .fable-side .plan-feats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 22px;
  }
  .fable .tick {
    stroke: var(--mint);
  }
  .fable-act {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }
  .fable-act .plan-cta {
    width: auto;
    margin-top: 0;
  }
  .btn-ico {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .fable-addr {
    font-family: var(--f-mono);
    font-size: 13px;
    color: var(--night-dim);
    user-select: all;
  }
  @media (max-width: 1100px) {
    .fable {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .fable-side {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 640px) {
    .fable {
      grid-template-columns: minmax(0, 1fr);
      border-radius: var(--r-lg);
    }
    .fable-badge {
      width: 96px;
    }
    .fable-side .plan-feats {
      grid-template-columns: minmax(0, 1fr);
    }
    .fable-act .plan-cta {
      width: 100%;
    }
