</style>

<script>
  const dlg = document.getElementById('checkout') as HTMLDialogElement | null;
  const form = dlg?.querySelector('form');
  const input = document.getElementById('sub-account-email') as HTMLInputElement | null;
  const hint = document.getElementById('sub-email-hint');
  const titleEl = dlg?.querySelector<HTMLElement>('[data-co-title]');
  const sumEl = dlg?.querySelector<HTMLElement>('[data-co-sum]');
  const go = dlg?.querySelector<HTMLButtonElement>('[data-co-go]');

  const endpoints = [
    'https://api.eidolon.instarmony.com/subscription/checkout-public',
    'https://api.eidolon.instarmony.com/eidolon/api/subscription/checkout-public',
  ];
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  if (dlg && form && input && hint && go) {
    const msg = dlg.dataset;
    let tierId = 'spark';
    let currency = 'CNY';
    let opener: HTMLElement | null = null;

    const say = (text: string, error = false, badEmail = false) => {
      hint.textContent = text;
      hint.classList.toggle('is-error', error);
      input.setAttribute('aria-invalid', String(badEmail));
    };
    const idle = () => {
      go.disabled = false;
      go.textContent = msg.go ?? '';
      form.removeAttribute('aria-busy');
    };

    document.querySelectorAll<HTMLButtonElement>('.sub-trigger-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        tierId = btn.dataset.tier || 'spark';
        currency = btn.dataset.currency || 'CNY';
        opener = btn;
        if (titleEl) titleEl.textContent = (msg.title ?? '').replace('{plan}', btn.dataset.planName ?? '');
        if (sumEl) sumEl.textContent = btn.dataset.planSum ?? '';
        say(msg.hint ?? '');
        idle();
        if (typeof dlg.showModal === 'function') dlg.showModal();
        else dlg.setAttribute('open', '');
        input.focus();
      });
    });

    input.addEventListener('input', () => {
      if (hint.classList.contains('is-error')) say(msg.hint ?? '');
    });
    dlg.querySelector('[data-co-close]')?.addEventListener('click', () => dlg.close());
    // the dialog box itself has no padding, so a click that lands on it is a click on the backdrop
    dlg.addEventListener('click', (event) => {
      if (event.target === dlg && !go.disabled) dlg.close();
    });
    dlg.addEventListener('close', () => opener?.focus());

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = input.value.trim();
      if (!EMAIL.test(email)) {
        say(msg.invalid ?? '', true, true);
        input.focus();
        return;
      }
      say((msg.creating ?? '').replace('{email}', email));
      go.disabled = true;
      go.textContent = msg.redirecting ?? '';
      form.setAttribute('aria-busy', 'true');

      try {
        let resp: Response | null = null;
        let lastErr: unknown = null;
        for (const ep of endpoints) {
          try {
            const r = await fetch(ep, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email, tierId, currency }),
            });
            if (r.ok || r.status !== 404) {
              resp = r;
              break;
            }
          } catch (err) {
            lastErr = err;
          }
        }
        if (!resp) throw lastErr ?? new Error('network');
        if (!resp.ok) {
          const errData = await resp.json().catch(() => ({}));
          throw new Error(typeof errData.detail === 'string' && errData.detail ? errData.detail : `HTTP ${resp.status}`);
        }
        const data = await resp.json();
        if (!data.checkoutUrl) throw new Error('no checkout link');
        window.location.href = data.checkoutUrl;
      } catch (err) {
        const reason = err instanceof Error ? err.message : String(err);
        say((msg.failed ?? '').replace('{error}', reason), true);
        idle();
      }
    });

    // Coming back from the cashier restores this page from the back-forward cache mid-redirect.
    window.addEventListener('pageshow', (event) => {
      if (!event.persisted) return;
      idle();
      say(msg.hint ?? '');
      if (dlg.open) dlg.close();
    });
  }
</script>
