---
import PageHero from '../PageHero.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import Faq from '../Faq.astro';
import { localizePath, t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const page = copy.pricingPage;
const p = (href: string) => localizePath(lang, href);
const firstLabel = (price: string) => copy.common.firstMonth.replace('{price}', price);
---

<PageHero label={page.label} h1a={page.h1} lede={page.lede} />

<section class="section plans-sec">
  <div class="container">
    <div class="plans">
      {page.plans.map((plan, i) => (
        <article
          class={`plan ${plan.variant === 'night' ? 'plan--night band-night' : ''}`}
          style={`--i:${i}`}
        >
          <span class="greek" aria-hidden="true">{plan.greek}</span>
          {plan.variant === 'night' && <span class="plan-badge">{copy.common.flagship}</span>}
          <h2 class="plan-name">{plan.name}</h2>
          <p class="plan-tag">{plan.tagline}</p>

          <div class="price">
            <span class="cur">¥</span>
            <b>{plan.price}</b>
            <span class="period">{plan.period}</span>
          </div>
          {plan.first && <span class="first-pill">{firstLabel(plan.first)}</span>}

          <ul class="plan-features">
            {plan.features.map((feature) => (
              <li><Icon name="check" size={12} stroke={2.4} />{feature}</li>
            ))}
          </ul>

          <div class="plan-cta">
            <Button href={p('/download.html')} variant={plan.variant === 'night' ? 'ink' : 'ghost'}>{plan.cta}</Button>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section section--paper2 upcoming-sec">
  <div class="container">
    <div class="upcoming reveal">
      <div class="up-head">
        <span class="label">{page.upcomingLabel}</span>
      </div>
      <div class="up-grid">
        {page.upcoming.map((item) => (
          <article class="up-card">
            <span class="up-icon"><Icon name={item.icon} size={19} /></span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
      <p class="up-note">{page.upcomingNote}</p>
    </div>
  </div>
</section>

<section class="section faq-sec">
  <div class="container">
    <Faq items={page.faq} lang={lang} title={page.faqTitle} />
  </div>
</section>

<style>
  .plans-sec {
    padding-top: 0;
  }
  .plans {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    align-items: stretch;
  }
  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--card);
    padding: 24px 20px 20px;
    min-height: 540px;
  }
  .plan--night {
    border-color: transparent;
  }
  .greek {
    position: absolute;
    top: 4px;
    right: 10px;
    font-family: var(--f-latin-display);
    font-size: clamp(84px, 6.4vw, 100px);
    line-height: 1;
    color: var(--line-2);
    opacity: 0.55;
    pointer-events: none;
    user-select: none;
  }
  .plan--night .greek {
    color: var(--lime);
    opacity: 0.22;
  }
  .plan-badge {
    align-self: flex-start;
    font-family: var(--f-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    color: var(--lime);
    border: 1px solid rgba(200, 241, 105, 0.4);
    border-radius: var(--r-full);
    padding: 4px 9px;
    margin-bottom: 0;
  }
  .plan-name {
    position: relative;
    font-size: 21px;
    line-height: 1.2;
    margin-top: 104px;
    color: var(--ink);
  }
  .plan--night .plan-name {
    color: var(--night-text);
    margin-top: 84px;
  }
  .plan-tag {
    position: relative;
    margin-top: 10px;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--ink-2);
    min-height: 60px;
    text-wrap: pretty;
  }
  .plan--night .plan-tag {
    color: var(--night-dim);
  }
  .price {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 3px;
    margin-top: 18px;
    color: var(--ink);
  }
  .plan--night .price {
    color: var(--lime);
  }
  .cur {
    font-size: 20px;
    font-family: var(--f-latin-display);
    transform: translateY(-8px);
  }
  .price b {
    font-family: var(--f-latin-display);
    font-weight: 400;
    font-size: clamp(2.8rem, 2.3rem + 1.4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .period {
    font-size: 12px;
    color: var(--ink-3);
    margin-left: 3px;
  }
  .plan--night .period {
    color: var(--night-dim);
  }
  .first-pill {
    align-self: flex-start;
    display: inline-block;
    margin-top: 10px;
    padding: 3px 9px;
    border-radius: var(--r-full);
    background: var(--sage-wash);
    color: color-mix(in srgb, var(--sage-deep) 78%, var(--ink));
    font-size: 11px;
    letter-spacing: 0.02em;
  }
  .plan--night .first-pill {
    background: rgba(200, 241, 105, 0.14);
    color: var(--lime);
  }
  .plan-features {
    position: relative;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 9px;
    flex: 1;
  }
  .plan--night .plan-features {
    border-color: var(--night-line);
  }
  .plan-features li {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .plan--night .plan-features li {
    color: var(--night-dim);
  }
  .plan-features :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--sage-deep);
  }
  .plan--night .plan-features :global(svg) {
    color: var(--lime);
  }
  .plan-cta {
    position: relative;
    margin-top: 22px;
  }
  .plan-cta :global(.btn) {
    width: 100%;
    justify-content: center;
    font-size: 12.5px;
    padding-inline: 8px;
  }
  .upcoming {
    border-radius: var(--r-xl);
    background: var(--sage-wash);
    padding: clamp(30px, 4vw, 48px);
  }
  .up-head {
    margin-bottom: 22px;
  }
  .up-head .label {
    color: var(--sage-deep);
  }
  .up-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .up-card {
    border: 1px solid rgba(79, 127, 116, 0.22);
    border-radius: 16px;
    padding: 22px;
    background: color-mix(in srgb, var(--card) 60%, transparent);
  }
  .up-icon {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    display: grid;
    place-items: center;
    background: var(--card);
    color: var(--sage-deep);
    margin-bottom: 16px;
  }
  .up-card h3 {
    font-size: 17px;
    margin-bottom: 6px;
  }
  .up-card p {
    font-size: 13px;
    line-height: 1.7;
    color: var(--ink-2);
  }
  .up-note {
    margin-top: 22px;
    font-size: 11.5px;
    color: var(--sage-deep);
  }

  @media (max-width: 1279px) {
    .plans {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }
    .plan {
      min-height: 0;
    }
  }
  @media (max-width: 1023px) {
    .plans {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .plans {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding: 4px var(--gutter) 18px;
      scrollbar-width: none;
    }
    .plans::-webkit-scrollbar {
      display: none;
    }
    .plan {
      flex: 0 0 84vw;
      scroll-snap-align: center;
    }
    .greek {
      font-size: 96px;
    }
    .up-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
