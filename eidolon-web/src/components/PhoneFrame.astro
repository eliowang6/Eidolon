---
interface Props {
  class?: string;
  cropTop?: boolean;
}
const { class: className = '', cropTop = false } = Astro.props;
---
<div class={`pf ${cropTop ? 'pf--crop' : ''} ${className}`}>
  <div class="pf-screen"><slot /></div>
</div>

<style>
  .pf {
    width: 100%;
    aspect-ratio: 390 / 844;
    border-radius: 36px;
    border: 8px solid var(--ink);
    background: var(--card);
    box-shadow: var(--sh-paper);
    overflow: hidden;
  }
  html[data-daypart="night"] .pf {
    border-color: #0a1310;
  }
  .pf-screen {
    height: 100%;
    border-radius: 28px;
    overflow: hidden;
    background: var(--paper-2);
  }
  .pf-screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .pf--crop .pf-screen :global(img) {
    height: calc(100% + 26px);
    margin-top: -26px;
  }
</style>
