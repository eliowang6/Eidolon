---
/** A desktop capture (the app draws its own title bar, so no fake chrome here). */
import { prPlain } from '../i18n';

interface Props {
  shot: string;
  pair?: boolean;
  alt: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}
const { shot, pair = false, alt, eager = false, sizes = '(max-width: 900px) 92vw, 760px', class: className = '' } = Astro.props;
const variants = pair
  ? [
      { name: `${shot}-fea`, cls: 'cf', who: 'fea' as const },
      { name: `${shot}-ael`, cls: 'ca', who: 'ael' as const },
    ]
  : [{ name: shot, cls: '', who: 'fea' as const }];
---

<figure class:list={['screen', className]}>
  <div class="screen-glass">
    {
      variants.map((v, i) => (
        <img
          class={v.cls || undefined}
          src={`/assets/shots/${v.name}.webp`}
          srcset={`/assets/shots/${v.name}-960.webp 960w, /assets/shots/${v.name}.webp 1600w`}
          sizes={sizes}
          width="1600"
          height="1000"
          alt={prPlain(alt, v.who)}
          loading={eager && i === 0 ? 'eager' : 'lazy'}
          decoding="async"
        />
      ))
    }
  </div>
  <slot />
</figure>

<style>
  .screen {
    margin: 0;
    width: 100%;
  }
  .screen-glass {
    position: relative;
    border-radius: clamp(10px, 1.2vw, 16px);
    overflow: hidden;
    background: #f3f6f1;
    box-shadow:
      var(--sh-device),
      0 0 0 1px rgba(27, 30, 58, 0.12);
  }
  :global(.band-night) .screen-glass {
    box-shadow:
      0 60px 120px -50px rgba(0, 0, 0, 0.75),
      0 0 0 1px rgba(255, 255, 255, 0.16);
  }
  .screen-glass img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
