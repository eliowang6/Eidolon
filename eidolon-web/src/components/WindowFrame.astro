---
interface Props {
  title?: string;
  class?: string;
}
const { title = 'Sholarel', class: className = '' } = Astro.props;
---
<div class={`wf ${className}`}>
  <div class="wf-bar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="wf-title">{title}</span>
  </div>
  <div class="wf-body"><slot /></div>
</div>

<style>
  .wf {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: var(--sh-paper);
  }
  .wf-bar {
    position: relative;
    display: flex;
    align-items: center;
    height: 28px;
    padding: 0 12px;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 55%, var(--card));
  }
  .dots {
    display: flex;
    gap: 5px;
  }
  .dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
  }
  .wf-title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }
  .wf-body {
    overflow: hidden;
  }
  .wf-body :global(img) {
    width: 100%;
    height: auto;
  }
</style>
