---
import { localizePath, pr, t, type Lang } from '../i18n';

interface Item {
  q: string;
  a: string;
  downloadLink?: boolean;
  privacyLink?: boolean;
}
interface Props {
  items: Item[];
  lang: Lang;
  title?: string;
}
const { items, lang, title } = Astro.props;
const copy = t(lang);
---

<section class="faq" aria-label={title ?? 'FAQ'}>
  {title && <h2 class="faq-title">{title}</h2>}
  <div class="faq-list">
    {
      items.map((item) => (
        <details class="faq-item">
          <summary>
            <span set:html={pr(item.q)} />
            <span class="faq-icon" aria-hidden="true" />
          </summary>
          <div class="faq-body">
            <p>
              <Fragment set:html={pr(item.a)} />
              {item.downloadLink && (
                <>
                  {' '}
                  <a class="faq-link" href={localizePath(lang, '/download.html')}>
                    {copy.common.downloadPreview} →
                  </a>
                </>
              )}
              {item.privacyLink && (
                <>
                  {' '}
                  <a class="faq-link" href={localizePath(lang, '/privacy.html')}>
                    {copy.footer.privacy} →
                  </a>
                </>
              )}
            </p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-title {
    font-size: clamp(1.7rem, 1.3rem + 1.4vw, 2.5rem);
    margin-bottom: 30px;
  }
  .faq-list {
    border-top: 1px solid var(--line-2);
  }
  .faq-item {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 2px;
    font-size: 17.5px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--ink);
    cursor: pointer;
    transition: color var(--t-fast);
  }
  summary:hover {
    color: var(--accent-ink);
  }
  .faq-icon {
    position: relative;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    transition:
      background var(--t-mid) var(--ease),
      border-color var(--t-mid) var(--ease),
      transform var(--t-mid) var(--ease);
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.6px;
    border-radius: 2px;
    background: currentColor;
    translate: -50% -50%;
  }
  .faq-icon::after {
    rotate: 90deg;
    transition: rotate var(--t-mid) var(--ease);
  }
  details[open] .faq-icon {
    background: var(--accent-wash);
    border-color: transparent;
    color: var(--accent-ink);
  }
  details[open] .faq-icon::after {
    rotate: 0deg;
  }
  .faq-body {
    padding: 0 64px 26px 2px;
  }
  .faq-body p {
    font-size: 15.5px;
    line-height: 1.85;
    color: var(--ink-2);
    max-width: 70ch;
  }
  .faq-link {
    color: var(--accent-ink);
    border-bottom: 1px solid currentColor;
    white-space: nowrap;
  }
  :global(.band-night) details[open] .faq-icon {
    background: rgba(255, 255, 255, 0.1);
  }
  @media (max-width: 767px) {
    summary {
      font-size: 16.5px;
      padding: 19px 0;
    }
    .faq-body {
      padding-right: 0;
    }
  }
</style>
