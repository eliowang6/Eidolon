---
interface Props {
  href?: string;
  variant?: 'ink' | 'ghost' | 'text';
  size?: 'md' | 'sm';
  dot?: boolean;
  type?: 'button' | 'submit';
  target?: string;
  class?: string;
  ariaLabel?: string;
}
const {
  href,
  variant = 'ink',
  size = 'md',
  dot = variant === 'ink',
  type = 'button',
  target,
  class: className = '',
  ariaLabel,
} = Astro.props;

const classes = [
  variant === 'text' ? 'btn-text' : 'btn',
  variant === 'ink' ? 'btn-ink' : variant === 'ghost' ? 'btn-ghost' : '',
  size === 'sm' && variant !== 'text' ? 'btn-sm' : '',
  className,
]
  .filter(Boolean)
  .join(' ');
const rel = target === '_blank' ? 'noopener noreferrer' : undefined;
---
{href ? (
  <a class={classes} href={href} target={target} rel={rel} aria-label={ariaLabel}>
    {dot && <span class="dot" aria-hidden="true"></span>}
    <slot />
  </a>
) : (
  <button class={classes} type={type} aria-label={ariaLabel}>
    {dot && <span class="dot" aria-hidden="true"></span>}
    <slot />
  </button>
)}
