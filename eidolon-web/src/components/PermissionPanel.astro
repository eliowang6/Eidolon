---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  class?: string;
}
const { lang, class: className = '' } = Astro.props;
const copy = t(lang);
const panel = copy.trust.panel;
---
<!-- Decorative: the same facts are spelled out in the list beside it. -->
<div class={`perm ${className}`} aria-hidden="true">
  <div class="perm-head">
    <span class="perm-avatar"><Logo size={20} /></span>
    <span class="perm-title">
      <b>{panel.title}</b>
      <small>{panel.sub}</small>
    </span>
    <span class="perm-tag">{copy.common.illustrative}</span>
  </div>
  <ul>
    {panel.rows.map((row) => (
      <li class={row.on ? 'on' : ''}>
        <span class="perm-ic"><Icon name={row.icon} size={17} /></span>
        <span class="perm-label">
          {row.label}
          {row.sub && <small>{row.sub}</small>}
        </span>
        <i class="toggle"><i></i></i>
      </li>
    ))}
  </ul>
  <p class="perm-foot hand">{panel.foot}</p>
</div>

<style>
  .perm {
    position: relative;
    width: 100%;
    max-width: 420px;
    padding: 22px 22px 18px;
    border-radius: var(--r-xl);
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: var(--sh-float);
  }
  .perm-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  .perm-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex: none;
    background: var(--sage-wash);
    color: var(--sage-deep);
  }
  .perm-title {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .perm-title b {
    font-size: 15px;
    font-weight: 600;
  }
  .perm-title small {
    font-size: 12px;
    color: var(--ink-3);
  }
  :lang(zh) .perm-tag {
    letter-spacing: 0.04em;
  }
  .perm-tag {
    margin-left: auto;
    align-self: flex-start;
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  ul {
    display: grid;
    padding: 6px 0;
  }
  li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 13px 0;
    border-bottom: 1px dashed var(--line);
    font-size: 15px;
    color: var(--ink-3);
  }
  li:last-child {
    border-bottom: 0;
  }
  li.on {
    color: var(--ink);
  }
  .perm-ic {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    flex: none;
    background: color-mix(in srgb, var(--paper) 70%, var(--card));
    color: var(--ink-3);
  }
  li.on .perm-ic {
    background: var(--sage-wash);
    color: var(--sage-deep);
  }
  .perm-label {
    display: flex;
    flex-direction: column;
    line-height: 1.4;
  }
  .perm-label small {
    font-size: 12px;
    color: var(--sage-deep);
  }
  .toggle {
    position: relative;
    margin-left: auto;
    width: 38px;
    height: 22px;
    flex: none;
    border-radius: var(--r-full);
    background: var(--line-2);
    transition: background var(--t-mid) var(--ease);
  }
  .toggle i {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--card);
    box-shadow: 0 1px 3px rgba(18, 36, 29, 0.25);
    transition: transform var(--t-mid) var(--ease);
  }
  li.on .toggle {
    background: var(--sage-deep);
  }
  li.on .toggle i {
    transform: translateX(16px);
  }
  html[data-daypart="night"] li.on .toggle i {
    background: #0e1a15;
  }
  .perm-foot {
    margin-top: 6px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 18px;
    line-height: 1.5;
  }
</style>
