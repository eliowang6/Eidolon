---
interface Node {
  no: string;
  status: string;
  statusLabel: string;
  title: string;
  desc: string;
}
interface Props {
  nodes: Node[];
  orientation?: 'horizontal' | 'vertical';
  anchor?: string;
}
const { nodes, orientation = 'horizontal', anchor } = Astro.props;
---
<ol class={`tl tl--${orientation}`}>
  {nodes.map((node, i) => (
    <li class={`tl-node tl-node--${node.status}`} style={`--i:${i}`} data-thread-anchor={node.status === 'current' ? anchor : undefined}>
      <span class="tl-dot" aria-hidden="true"></span>
      <div class="tl-body">
        <span class="tl-meta mono">
          <span class="no">{node.no}</span>
          <span class="status">{node.statusLabel}</span>
        </span>
        <h3>{node.title}</h3>
        <p>{node.desc}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .tl {
    position: relative;
    display: grid;
    gap: 32px;
  }
  .tl--horizontal {
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(18px, 2.4vw, 32px);
    padding-top: 30px;
  }
  .tl--horizontal::before {
    content: "";
    position: absolute;
    top: 7px;
    left: 7px;
    right: 7px;
    height: 1px;
    background: linear-gradient(90deg, var(--sage-deep) 0 75%, var(--lime-deep) 75% 100%);
  }
  .tl-node {
    position: relative;
    padding-left: 0;
  }
  .tl-dot {
    position: absolute;
    top: -30px;
    left: 0;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 1.5px solid var(--line-2);
    background: var(--paper-2);
    z-index: 1;
  }
  .tl-node--done .tl-dot {
    background: var(--sage-deep);
    border-color: var(--sage-deep);
  }
  .tl-node--current .tl-dot {
    background: var(--lime-deep);
    border-color: var(--lime-deep);
    box-shadow: 0 0 0 5px rgba(200, 241, 105, 0.28);
  }
  .tl-node--current .tl-dot::after {
    content: "";
    position: absolute;
    inset: -7px;
    border-radius: 50%;
    border: 1.5px solid var(--lime-deep);
    animation: pulse 2.4s var(--ease) infinite;
  }
  .tl-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 6px;
  }
  .tl-node--current .status {
    color: var(--lime-deep);
  }
  .tl-body h3 {
    font-size: 19px;
    margin-bottom: 6px;
  }
  .tl-body p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--ink-2);
  }
  @media (max-width: 767px) {
    .tl--horizontal {
      grid-template-columns: 1fr;
      padding-top: 0;
      padding-left: 30px;
      gap: 28px;
    }
    .tl--horizontal::before {
      top: 7px;
      bottom: 7px;
      left: 7px;
      right: auto;
      width: 1px;
      height: auto;
      background: linear-gradient(180deg, var(--sage-deep) 0 75%, var(--lime-deep) 75% 100%);
    }
    .tl-dot {
      top: 3px;
      left: -30px;
    }
  }

  /* vertical variant (beta page) */
  .tl--vertical {
    gap: 0;
    padding-left: 34px;
  }
  .tl--vertical::before {
    content: "";
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 7px;
    width: 1px;
    background: linear-gradient(180deg, var(--sage-deep) 0 75%, var(--lime-deep) 75% 100%);
  }
  .tl--vertical .tl-node {
    padding: 0 0 30px;
  }
  .tl--vertical .tl-dot {
    top: 6px;
    left: -34px;
  }
  .tl--vertical .tl-body h3 {
    font-size: 20px;
  }
</style>
