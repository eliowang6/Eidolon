---
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';

interface Props {
  step: any;
  index: number;
  lang: Lang;
}
const { step, index, lang } = Astro.props;
const copy = t(lang);
---
{index === 0 && (
  <div class="panel-inner">
    <ul class="signals">
      {step.signals.map((signal: any) => (
        <li>
          <span class="ic"><Icon name={signal.icon} size={17} /></span>
          <span>{signal.text}</span>
        </li>
      ))}
    </ul>
    <p class="lock"><Icon name="lock" size={14} />{step.lock}</p>
  </div>
)}

{index === 1 && (
  <div class="panel-inner">
    <div class="dots">
      <div class="ucard now">
        <span class="tag mono">{step.time}</span>
        <p>{step.now}</p>
      </div>
      <div class="dash" aria-hidden="true"></div>
      <div class="ucard past">
        <p>{step.past}</p>
      </div>
    </div>
    <p class="side"><Icon name="heart" size={14} />{step.side}</p>
  </div>
)}

{index === 2 && (
  <div class="panel-inner">
    <div class="memcard">
      <span class="label">{step.memoryLabel}</span>
      <ul>
        {step.memories.map((memory: string) => (
          <li><span class="bullet"></span>{memory}</li>
        ))}
      </ul>
    </div>
    <div class="memcard ghost">
      <span class="label">{step.linkLabel}</span>
      <p>{step.link}</p>
    </div>
    <p class="hand note">{copy.mnote.loop}</p>
  </div>
)}

{index === 3 && (
  <div class="panel-inner">
    <ul class="tlog">
      {step.log.map((line: string) => (
        <li><span class="tick"><Icon name="check" size={12} stroke={2.6} /></span><span>{line}</span></li>
      ))}
    </ul>
    <div class="tactions">
      {step.buttons.map((label: string, i: number) => (
        <span class={i === 0 ? 'tbtn' : 'tbtn tbtn--quiet'}>{label}</span>
      ))}
    </div>
    <p class="note">{step.note}</p>
  </div>
)}

{index === 4 && (
  <div class="panel-inner">
    <div class="diff">
      {step.diff.map((line: string) => (
        <div class="add"><span>+</span>{line}</div>
      ))}
    </div>
    <p class="note">{step.note}</p>
  </div>
)}

<style>
  .panel-inner {
    position: relative;
    min-height: 300px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .signals {
    display: grid;
    gap: 9px;
  }
  .signals li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 12px;
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--paper) 60%, var(--card));
    border: 1px solid var(--line);
    font-size: 13.5px;
    color: var(--ink-2);
  }
  .ic {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--sage-wash);
    color: var(--sage-deep);
    flex: none;
  }
  .lock {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: auto;
    font-size: 11.5px;
    color: var(--ink-3);
    font-family: var(--f-mono);
  }
  .dots {
    position: relative;
    display: grid;
    gap: 26px;
  }
  .ucard {
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--paper) 55%, var(--card));
    padding: 14px 16px;
  }
  .ucard p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-2);
    margin-top: 4px;
  }
  .ucard .tag {
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    text-transform: uppercase;
  }
  .ucard.past {
    margin-left: 34px;
    border-style: dashed;
  }
  .dash {
    position: absolute;
    left: 18px;
    top: 52px;
    bottom: 52px;
    width: 1px;
    background: repeating-linear-gradient(180deg, var(--line-2) 0 4px, transparent 4px 9px);
  }
  .side {
    display: flex;
    align-items: center;
    gap: 8px;
    align-self: flex-end;
    max-width: 260px;
    padding: 8px 12px;
    border-radius: var(--r-full);
    background: var(--sage-wash);
    color: var(--sage-deep);
    font-size: 12px;
  }
  .memcard {
    border: 1px dashed var(--line-2);
    border-radius: var(--r-md);
    padding: 16px;
    background: color-mix(in srgb, var(--sage-wash) 55%, transparent);
  }
  .memcard .label {
    color: var(--sage-deep);
  }
  .memcard ul {
    display: grid;
    gap: 7px;
    margin-top: 10px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .memcard li {
    display: flex;
    gap: 9px;
    align-items: baseline;
  }
  .bullet {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--sage-deep);
    flex: none;
  }
  .memcard.ghost {
    background: transparent;
    border-style: dotted;
  }
  .memcard.ghost p {
    margin-top: 6px;
    font-size: 14px;
    color: var(--ink-3);
  }
  .note {
    margin-top: auto;
    padding-top: 12px;
    font-size: 12px;
    color: var(--ink-3);
  }
  .tlog {
    display: grid;
    gap: 10px;
  }
  .tlog li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .tick {
    width: 19px;
    height: 19px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--sage-deep);
    color: #fff;
    flex: none;
    margin-top: 1px;
  }
  .tactions {
    display: flex;
    gap: 8px;
    margin-top: 6px;
  }
  .tbtn {
    padding: 5px 12px;
    border-radius: var(--r-full);
    border: 1px solid var(--line-2);
    font-size: 11px;
    color: var(--ink-2);
  }
  .tbtn--quiet {
    border-color: transparent;
    color: var(--ink-3);
  }
  .diff {
    display: grid;
    gap: 2px;
    font-family: var(--f-mono);
    font-size: 12.5px;
    line-height: 1.8;
    background: color-mix(in srgb, var(--paper) 50%, var(--card));
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 16px;
    color: var(--ink-2);
  }
  .diff .add {
    display: flex;
    gap: 10px;
    color: var(--sage-deep);
  }
  .diff .add span {
    color: var(--sage-deep);
  }
  .hand.note {
    font-family: var(--f-hand);
    font-size: 17px;
    color: var(--annot);
  }
</style>
