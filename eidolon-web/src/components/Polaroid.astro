---
interface Props {
  src: string;
  alt: string;
  caption: string;
  rotate?: number;
  class?: string;
  square?: boolean;
}
const { src, alt, caption, rotate = -2, class: className = '', square = false } = Astro.props;
---
<figure class={`pola ${className}`} style={`--rot:${rotate}deg`}>
  <span class="pola-tape" aria-hidden="true"></span>
  <div class="pola-img">
    <img src={src} alt={alt} width="640" height="640" loading="lazy" style={square ? '' : 'aspect-ratio:4/5'} />
    <slot />
  </div>
  <figcaption class="hand">{caption}</figcaption>
</figure>

<style>
  .pola {
    background: #fcfbf7;
    padding: 12px 12px 0;
    border-radius: 3px;
    box-shadow: 0 1px 0 rgba(18, 36, 29, 0.05), 0 26px 50px -24px rgba(18, 36, 29, 0.4);
    transform: rotate(var(--rot));
    position: relative;
    max-width: 420px;
  }
  .pola-tape {
    position: absolute;
    top: -14px;
    left: 50%;
    width: 96px;
    height: 26px;
    transform: translateX(-50%) rotate(-3deg);
    background: rgba(233, 185, 100, 0.5);
  }
  .pola-img {
    position: relative;
    overflow: hidden;
    background: #e9e4d7;
  }
  .pola-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    filter: saturate(0.88) contrast(0.97) sepia(0.08);
  }
  figcaption {
    padding: 12px 6px 14px;
    font-size: 18px;
    line-height: 1.4;
    text-align: center;
    color: var(--annot);
  }
  @media (max-width: 767px) {
    .pola {
      margin-inline: auto;
    }
  }
</style>
